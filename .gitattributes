# Keep shell scripts and systemd/nginx units LF-only - a CRLF checkout breaks
# them on Linux ("/bin/bash^M: bad interpreter").
* text=auto eol=lf

*.sh     text eol=lf
*.service text eol=lf
*.conf   text eol=lf
*.py     text eol=lf
*.ts     text eol=lf
*.vue    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.sql    text eol=lf

# Binary
*.ttf    binary
*.png    binary
*.jpg    binary
*.mp4    binary
*.mkv    binary
*.mp3    binary
*.mov    binary
*.ts     binary
*.vtt    binary
*.sqlite binary