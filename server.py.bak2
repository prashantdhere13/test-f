def _ensure_mail_schema(db):
    """Add the per-channel mail/SMTP fields to playout configs created before
    email notifications existed, so the mail queue never trips over a missing
    key."""
    for key, cfg in (db.get("playout_configs") or {}).items():
        if not isinstance(cfg, dict):
            continue
        mail = cfg.setdefault("mail", {})
        if not isinstance(mail, dict):
            cfg["mail"] = mail = {}
        mail.setdefault("show", False)
        mail.setdefault("subject", "")
        mail.setdefault("recipient", "")
        mail.setdefault("mail_level", "warning")
        mail.setdefault("interval", 0)
        mail.setdefault("smtp_server", "")
        mail.setdefault("smtp_port", 465)
        mail.setdefault("smtp_user", "")
        mail.setdefault("smtp_password", "")
        mail.setdefault("smtp_starttls", False)
    return db


def load_db():
    if DB_FILE.exists():
        with open(DB_FILE, "r", encoding="utf-8-sig") as f:
            return _ensure_mail_schema(json.load(f))
    save_db(DEFAULT_DB)
    return DEFAULT_DB


def save_db(db):
    with open(DB_FILE, "w", encoding="utf-8") as f:
        json.dump(db, f, indent=2, ensure_ascii=False)


def _role_name(role_id: int) -> str:
    return {
        1: "global_admin",
        2: "channel_admin",
        3: "user",
        4: "guest",
    }.get(role_id, "user")


def create_tokens(user_id: int, username: str, role_id: int, channel_ids: list):
    role = _role_name(role_id)
    now = time.time()
    access_payload = {
        "sub": username,
        "id": user_id,
        "channels": channel_ids,
        "role": role,
        "exp": now + ACCESS_TOKEN_EXPIRE_MINUTES * 60,
        "iat": now,
    }
    refresh_payload = {
        "sub": username,
        "id": user_id,
        "channels": channel_ids,
        "role": role,
        "exp": now + REFRESH_TOKEN_EXPIRE_DAYS * 86400,
        "iat": now,
    }
    access = jwt.encode(access_payload, SECRET_KEY, algorithm=ALGORITHM)
    refresh = jwt.encode(refresh_payload, SECRET_KEY, algorithm=ALGORITHM)
    return access, refresh


def get_current_user(request: Request):
    auth = request.headers.get("Authorization", "")
    if not auth.startswith("Bearer "):
        raise HTTPException(status_code=401, detail="Missing token")
    token = auth[7:]
    try:
        payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])
    except Exception:
        raise HTTPException(status_code=401, detail="Invalid token")
    db = load_db()
    for u in db["users"]:
        if u["id"] == payload["id"]:
            return u
    raise HTTPException(status_code=401, detail="User not found")


def get_user_role(user):
    return _role_name(user["role_id"])


# === AUTH ROUTES ===

@app.post("/auth/login/")
async def login(request: Request):
    body = await request.json()
    username = body.get("username", "")
    password = body.get("password", "")
    db = load_db()
    for u in db["users"]:
        if u["username"] == username and verify_password(password, u["password"]):
            access, refresh = create_tokens(u["id"], u["username"], u["role_id"], u.get("channel_ids", []))
            return {"access": access, "refresh": refresh}
    raise HTTPException(status_code=401, detail="Invalid credentials")


@app.post("/auth/refresh/")
async def refresh_token(request: Request):
    body = await request.json()
    refresh = body.get("refresh", "")
    try:
        payload = jwt.decode(refresh, SECRET_KEY, algorithms=[ALGORITHM])
    except Exception:
        raise HTTPException(status_code=401, detail="Invalid refresh token")
    db = load_db()
    for u in db["users"]:
        if u["id"] == payload["id"]:
            access, _ = create_tokens(u["id"], u["username"], u["role_id"], u.get("channel_ids", []))
            return {"access": access}
    raise HTTPException(status_code=401, detail="User not found")


# === UUID ===

@app.post("/api/generate-uuid")
async def generate_uuid(request: Request):
    user = get_current_user(request)
    new_uuid = str(uuid.uuid4())
    VALID_UUIDS[new_uuid] = user["id"]
    return {"uuid": new_uuid}


# === CHANNEL ROUTES ===

@app.get("/api/channels")
async def get_channels(request: Request):
    user = get_current_user(request)
    db = load_db()
    if get_user_role(user) == "global_admin":
        return db["channels"]
    return [c for c in db["channels"] if c["id"] in user.get("channel_ids", [])]


@app.post("/api/channel/")
async def create_channel(request: Request):
    user = get_current_user(request)
    body = await request.json()
    db = load_db()
    new_id = max((c["id"] for c in db["channels"]), default=0) + 1

    name = body.get("name", f"Channel {new_id}")
    storage_dir = DATA_DIR / "storage" / name
    public_dir = DATA_DIR / "public" / name
    live_dir = DATA_DIR / "channel" / str(new_id) / "live"
    playlists_dir = DATA_DIR / "playlists"

    storage_dir.mkdir(parents=True, exist_ok=True)
    public_dir.mkdir(parents=True, exist_ok=True)
    live_dir.mkdir(parents=True, exist_ok=True)
    playlists_dir.mkdir(parents=True, exist_ok=True)

    # create the per channel logo/text/subtitles/filler folders and copy default assets
    prepare_channel_asset_folders(storage_dir)

    channel = {
        "id": new_id,
        "name": name,
        "preview_url": body.get("preview_url", f"http://127.0.0.1:8787/{new_id}/live/master.m3u8"),
        "public": str(public_dir),
        "playlists": str(playlists_dir),
        "storage": str(storage_dir),
        "extra_extensions": body.get("extra_extensions", ""),
        "timezone": body.get("timezone", "UTC"),
    }
    db["channels"].append(channel)

    str_id = str(new_id)
    db["playout_configs"][str_id] = {
        "general": {"stop_threshold": 2.0},
        "mail": {"show": False, "subject": "", "recipient": "", "mail_level": "warning", "interval": 0, "smtp_server": "", "smtp_port": 465, "smtp_user": "", "smtp_password": "", "smtp_starttls": False},
        "logging": {"ffmpeg_level": "warning", "ingest_level": "warning", "detect_silence": False, "ignore_lines": []},
        "processing": {
            "mode": "playlist", "audio_only": False, "copy_audio": True, "copy_video": False,
            "width": 1920, "height": 1080, "aspect": 1.778, "fps": 25.0,
            "add_logo": True, "logo": "logo/logo.png", "logo_scale": "", "logo_opacity": 0.0,
            "logo_position": "overlay=W-w-20:20", "audio_tracks": 1, "audio_track_index": 0,
            "audio_channels": 2, "volume": 1.0, "custom_filter": "", "override_filter": False,
            "vtt_enable": False, "vtt_dummy": "subtitles/dummy.vtt", "burn_subtitles": False,
            "subtitle": "", "subtitle_font": "DejaVu Sans", "subtitle_fontsize": 52,
            "subtitle_position": 2,
        },
        "ingest": {"enable": True, "input_param": srt_ingest_param(new_id), "custom_filter": ""},
        "playlist": {"day_start": "00:00:00", "length": "24:00:00", "infinit": False},
        "storage": {"filler": "", "extensions": ["mp4", "mxf","mpg","mov"], "shuffle": False, "shared_storage": False},
        "text": {"add_text": False, "font": "text/DejaVuSans.ttf", "text_from_filename": False, "style": "", "regex": ""},
        "task": {"enable": False, "path": ""},
        "output": {"id": 1, "mode": "stream", "output_param": f"-c:v libx264 -preset veryfast -tune zerolatency -c:a aac -f mpegts udp://127.0.0.1:{9000 + new_id * 10}?pkt_size=1316", "video_pid": 256, "audio_pid": 257, "pmt_pid": 258, "service_id": 1, "scte_pid": 768, "scte_marker_type": "splice_insert"},
    }

    next_out_id = max((o["id"] for o in db.get("outputs", [])), default=0) + 1
    db.setdefault("outputs", []).extend([
        {"id": next_out_id, "name": "Streaming Output", "parameters": f"-c:v libx264 -preset veryfast -tune zerolatency -c:a aac -f mpegts udp://127.0.0.1:{9000 + new_id * 10}?pkt_size=1316", "channel_id": new_id},
        {"id": next_out_id + 1, "name": "HLS Output", "parameters": f"-c:v libx264 -preset veryfast -tune zerolatency -c:a aac -f hls -hls_time 2 -hls_list_size 5 -hls_flags delete_segments -hls_segment_filename {str(live_dir / 'variant_1080p_%05d.ts').replace(chr(92), '/')} {str(live_dir / 'variant_1080p.m3u8').replace(chr(92), '/')}", "channel_id": new_id},
        {"id": next_out_id + 2, "name": "Desktop Null", "parameters": "-c:v libx264 -preset veryfast -tune zerolatency -c:a aac -f null", "channel_id": new_id},
    ])

    db["advanced_configs"][str_id] = {
        "id": 1,
        "name": "Default",
        "decoder": {"input_param": "", "output_param": ""},
        "encoder": {"input_param": "-c:v libx264 -preset veryfast -tune zerolatency -c:a aac"},
        "filter": {
            "deinterlace": "", "pad_video": "", "fps": "", "scale": "", "set_dar": "",
            "fade_in": "", "fade_out": "", "logo": "", "overlay_logo_scale": "",
            "overlay_logo_fade_in": "", "overlay_logo_fade_out": "", "overlay_logo": "",
            "tpad": "", "drawtext_from_file": "", "drawtext_from_zmq": "",
            "aevalsrc": "", "afade_in": "", "afade_out": "", "apad": "",
            "volume": "", "split": "",
        },
        "ingest": {"input_param": ""},
    }

    db["presets"][str_id] = []

    if new_id not in user.get("channel_ids", []):
        user.setdefault("channel_ids", []).append(new_id)

    save_db(db)
    return channel


@app.patch("/api/channel/{channel_id}")
async def update_channel(channel_id: int, request: Request):
    user = get_current_user(request)
    body = await request.json()
    db = load_db()
    for c in db["channels"]:
        if c["id"] == channel_id:
            for k, v in body.items():
                if k != "id":
                    c[k] = v
            save_db(db)
            return c
    raise HTTPException(status_code=404, detail="Channel not found")


@app.delete("/api/channel/{channel_id}")
async def delete_channel(channel_id: int, request: Request):
    user = get_current_user(request)
    db = load_db()
    db["channels"] = [c for c in db["channels"] if c["id"] != channel_id]
    save_db(db)
    return JSONResponse(status_code=200, content={"detail": "deleted"})


# === PLAYOUT CONFIG ===

@app.get("/api/playout/config/{channel_id}")
async def get_playout_config(channel_id: int, request: Request):
    get_current_user(request)
    db = load_db()
    key = str(channel_id)
    if key in db.get("playout_configs", {}):
        cfg = db["playout_configs"][key]
        # make sure a valid scte marker type exists so the web ui gets a
        # value; legacy "both" maps to splice_insert (both are never sent)
        out_ = cfg.setdefault("output", {})
        mt = str(out_.get("scte_marker_type") or "").lower()
        out_["scte_marker_type"] = (
            mt if mt in ("splice_insert", "time_signal") else "splice_insert"
        )
        # video/audio quality defaults so the web ui form always has values;
        # empty preset/bitrate means "use whatever output_param defines"
        q = cfg.setdefault("quality", {})
        for qk, qv in (
            ("x264_preset", ""),
            ("crf", None),
            ("video_bitrate", ""),
            ("maxrate", ""),
            ("bufsize", ""),
            ("audio_bitrate", "128k"),
            ("sample_rate", 48000),
        ):
            if q.get(qk) in (None, ""):
                q[qk] = qv
        # playlist timing section; the web ui does
        # `data.playlist.startInSec = ...` without a guard, so a missing key
        # throws a TypeError inside the fetch chain and its catch() wrongly
        # reports "No playout config found!"
        pl = cfg.setdefault("playlist", {})
        pl.setdefault("day_start", "00:00:00")
        pl.setdefault("length", "24:00:00")
        pl.setdefault("infinit", False)
        # ABR ladder is edited top level by the web ui but read from
        # cfg["output"]["hls_variants"] by _get_hls_variants, so expose it in
        # both places and keep them in sync
        if not isinstance(cfg.get("hls_variants"), list) or not cfg["hls_variants"]:
            cfg["hls_variants"] = [dict(v) for v in _DEFAULT_HLS_VARIANTS]
        cfg["output"].setdefault("hls_variants", cfg["hls_variants"])
        # graphics overlay defaults (secondary events); the NNL bug is
        # positioned/sized through these so the ui can edit them
        se = cfg.setdefault("secondary_events", {})
        se.setdefault("enable", True)
        se.setdefault("graphic_enable", False)
        se.setdefault("graphic", "")
        se.setdefault("graphic_position", "bottom right")
        if not isinstance(se.get("graphic_scale"), (int, float)):
            se["graphic_scale"] = 20
        se_styles = se.setdefault("styles", {})
        nnl = se_styles.setdefault("nnl", {})
        nnl.setdefault("position", "top right")
        if not isinstance(nnl.get("size"), (int, float)):
            nnl["size"] = 100
        # per channel mail/SMTP defaults; show becomes True once an SMTP
        # server + user are configured for the channel so the web ui reveals
        # the mail form, and the stored password is never leaked to the ui
        mail_ = cfg.setdefault("mail", {})
        for mk, mv in (
            ("show", False), ("subject", ""), ("recipient", ""),
            ("mail_level", "warning"), ("interval", 0),
            ("smtp_server", ""), ("smtp_port", 465), ("smtp_user", ""),
            ("smtp_password", ""), ("smtp_starttls", False),
        ):
            mail_.setdefault(mk, mv)
        mail_["show"] = bool(
            str(mail_.get("smtp_server") or "").strip()
            and str(mail_.get("smtp_user") or "").strip()
        )
        if str(mail_.get("smtp_password") or "").strip():
            mail_["smtp_password"] = ""
        return cfg
    raise HTTPException(status_code=404, detail="Config not found")


@app.put("/api/playout/config/{channel_id}")
async def update_playout_config(channel_id: int, request: Request):
    user = get_current_user(request)
    body = await request.json()
    db = load_db()
    key = str(channel_id)
    # keep the stored smtp password when the web ui posts a blank one (the
    # password field is masked on read and must not be wiped on save)
    old_mail = (db.get("playout_configs", {}).get(key) or {}).get("mail") or {}
    mail_new = body.get("mail")
    if isinstance(mail_new, dict) and not str(mail_new.get("smtp_password") or "").strip():
        mail_new["smtp_password"] = str(old_mail.get("smtp_password") or "")
    # the ui edits the ABR ladder top level; the engine reads it under output,
    # so mirror it across so a ladder saved from the ui actually takes effect
    if isinstance(body.get("hls_variants"), list) and body["hls_variants"]:
        body.setdefault("output", {})["hls_variants"] = body["hls_variants"]
    db.setdefault("playout_configs", {})[key] = body
    _clear_mail_cfg_cache(channel_id)
    for ch in db.get("channels", []):
        if ch.get("id") == channel_id:
            ch.setdefault("playout", {})["output"] = body.get("output", {})
            break
    save_db(db)
    return body


@app.get("/api/playout/outputs/{channel_id}")
async def get_playout_outputs(channel_id: int, request: Request):
    get_current_user(request)
    db = load_db()
    return [o for o in db.get("outputs", []) if o.get("channel_id") == channel_id]


# === MAIL SETTINGS (per channel) ===

def _mail_settings_out(mail: dict, channel_id: int) -> dict:
    """Return the mail config for the web ui: defaults filled in, `show`
    computed, and the stored smtp password masked."""
    out = {}
    for k, mv in (
        ("show", False), ("subject", ""), ("recipient", ""),
        ("mail_level", "warning"), ("interval", 0),
        ("smtp_server", ""), ("smtp_port", 465), ("smtp_user", ""),
        ("smtp_password", ""), ("smtp_starttls", False),
    ):
        out[k] = mail.get(k, mv) if isinstance(mail, dict) else mv
    out["show"] = _mail_enabled(channel_id)
    if str(out.get("smtp_password") or "").strip():
        out["smtp_password"] = ""
    return out


@app.get("/api/mail/settings/{channel_id}")
async def get_mail_settings(channel_id: int, request: Request):
    get_current_user(request)
    db = load_db()
    cfg = db.get("playout_configs", {}).get(str(channel_id), {})
    return _mail_settings_out(cfg.get("mail") or {}, channel_id)


@app.put("/api/mail/settings/{channel_id}")
async def update_mail_settings(channel_id: int, request: Request):
    get_current_user(request)
    body = await request.json()
    db = load_db()
    key = str(channel_id)
    cfg = db.setdefault("playout_configs", {}).setdefault(key, {})
    old = cfg.get("mail") or {}
    mail = dict(old) if isinstance(old, dict) else {}
    for k in ("subject", "recipient", "mail_level", "interval",
              "smtp_server", "smtp_port", "smtp_user", "smtp_starttls",
              "smtp_password"):
        if k in body:
            mail[k] = body[k]
    # a blank password means "keep the stored one" (the field is masked)
    if not str(mail.get("smtp_password") or "").strip():
        mail["smtp_password"] = old.get("smtp_password", "")
    cfg["mail"] = mail
    save_db(db)
    _clear_mail_cfg_cache(channel_id)
    return _mail_settings_out(mail, channel_id)


@app.post("/api/mail/settings/{channel_id}/test")
async def test_mail_settings(channel_id: int, request: Request):
    get_current_user(request)
    body = await request.json()
    db = load_db()
    cfg = db.get("playout_configs", {}).get(str(channel_id), {})
    old = cfg.get("mail") or {}
    mail_settings = dict(old) if isinstance(old, dict) else {}
    for k, v in (body or {}).items():
        mail_settings[k] = v
    if not str(mail_settings.get("smtp_password") or "").strip():
        mail_settings["smtp_password"] = old.get("smtp_password", "")

    recipients = [
        r.strip() for r in re.split(r"[;,]", str(mail_settings.get("recipient") or ""))
        if "@" in r.strip()
    ]
    if not str(mail_settings.get("smtp_server") or "").strip():
        raise HTTPException(status_code=400, detail="SMTP server is required")
    if not str(mail_settings.get("smtp_user") or "").strip():
        raise HTTPException(status_code=400, detail="SMTP user is required")
    if not recipients:
        raise HTTPException(status_code=400, detail="At least one valid recipient is required")

    subject = str(mail_settings.get("subject") or "").strip()
    if not subject:
        subject = f"ffplayout channel {channel_id} test email"
    body_text = (
        f"channel {channel_id}\n"
        f"time: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n\n"
        "This is a test email from ffplayout. If you can read this, "
        "the SMTP configuration is working.\n"
    )
    ok, err = _smtp_send(mail_settings, subject, body_text, recipients)
    if not ok:
        raise HTTPException(status_code=400, detail=f"Test email failed: {err}")
    return {"detail": "Test email sent"}


