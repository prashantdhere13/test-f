@app.put("/api/playout/advanced/{channel_id}")
async def update_advanced_config(channel_id: int, request: Request):
    user = get_current_user(request)
    body = await request.json()
    db = load_db()
    key = str(channel_id)
    cfgs = db.setdefault("advanced_configs", {}).get(key, [])
    if isinstance(cfgs, dict):
        db["advanced_configs"][key] = body
    elif isinstance(cfgs, list):
        for i, c in enumerate(cfgs):
            if c.get("id") == body.get("id"):
                cfgs[i] = body
                break
    save_db(db)
    return body


@app.delete("/api/playout/advanced/{channel_id}/{config_id}")
