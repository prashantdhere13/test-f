@app.put("/api/user/{user_id}")
async def update_user(user_id: int, request: Request):
    user = get_current_user(request)
    body = await request.json()
    db = load_db()
    for u in db["users"]:
        if u["id"] == user_id:
            if "username" in body:
                u["username"] = body["username"]
            if "mail" in body:
                u["mail"] = body["mail"]
            if body.get("password"):
                u["password"] = hash_password(body["password"])
            if "role_id" in body:
                u["role_id"] = body["role_id"]
            if "channel_ids" in body:
                u["channel_ids"] = body["channel_ids"]
            save_db(db)
            return {"id": u["id"], "username": u["username"], "mail": u.get("mail", ""), "role_id": u["role_id"], "channel_ids": u.get("channel_ids", [])}
    raise HTTPException(status_code=404, detail="User not found")


