# per channel asset folders created under each channel storage dir
ASSET_FOLDERS = ("logo", "text", "subtitles", "filler")

# base port for the per channel SRT ingest listener (channel 1 -> 9936, 2 -> 9937, ...)
SRT_INGEST_BASE_PORT = 9935


def srt_ingest_param(channel_id: int) -> str:
    port = SRT_INGEST_BASE_PORT + channel_id
    return f"-f mpegts -listen 1 -i srt://127.0.0.1:{port}?mode=listener"


def prepare_channel_asset_folders(storage_dir: Path):
    """Create logo/text/subtitles/filler folders for a channel and copy
    the default assets (logo, font, dummy subtitle) into them."""
    try:
        for folder in ASSET_FOLDERS:
            (storage_dir / folder).mkdir(parents=True, exist_ok=True)

        assets_src = Path(__file__).parent / "assets"
        default_assets = {
            "logo.png": storage_dir / "logo" / "logo.png",
            "DejaVuSans.ttf": storage_dir / "text" / "DejaVuSans.ttf",
            "dummy.vtt": storage_dir / "subtitles" / "dummy.vtt",
        }
        for src_name, target in default_assets.items():
            src = assets_src / src_name
            if src.is_file() and not target.exists():
                shutil.copy2(src, target)
    except Exception as e:
        print(f"[channels] Could not prepare asset folders in {storage_dir}: {e}")

