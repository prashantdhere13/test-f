# keep strong references to the playout tick tasks, otherwise the event loop
# may garbage collect them (it only holds weak refs) and playout silently dies
_tick_tasks = set()

# background auto-preprocess watcher tasks (one per channel with auto_preprocess)
_watcher_tasks = set()


def _watcher_task_done(task: asyncio.Task):
    _watcher_tasks.discard(task)
    if not task.cancelled() and task.exception():
        print(f"[preprocess] watcher task crashed: {task.exception()}")


def _stray_ffmpeg_markers() -> list[str]:
    """Substrings that identify an ffmpeg process owned by THIS server instance.

    HLS / transcode processes always embed the DATA_DIR path (segment file
    names), so they are caught by the DATA_DIR marker. The mpegts UDP/SRT
    output processes have no file path in their command line (they just write
    to `udp://127.0.0.1:9001` or `srt://...`), so they must be matched by
    their stream destination instead - otherwise an orphaned UDP process
    survives a server restart and keeps streaming forever."""
    markers = {str(DATA_DIR).lower(), str(DATA_DIR).lower().replace("\\", "/")}

    def _norm(s: str) -> str:
        return s.replace("\\", "/").lower().strip()

    # default UDP destination
    if UDP_OUTPUT:
        markers.add(_norm(UDP_OUTPUT))
        markers.add(_norm(UDP_OUTPUT.split("?", 1)[0]))

    # per-channel output destinations from output_param (udp:// or srt://)
    try:
        db = load_db()
    except Exception:
        db = {"channels": [], "playout_configs": {}}
    for ch in db.get("channels", []):
        cid = ch.get("id")
        if cid is None:
            continue
        out_param = ""
        pcfg = db.get("playout_configs", {}).get(str(cid), {})
        if pcfg:
            out_param = (pcfg.get("output") or {}).get("output_param", "")
        else:
            out_param = (ch.get("playout", {}) or {}).get("output", {}).get("output_param", "")
        if not out_param:
            continue
        for part in shlex.split(out_param):
            low = _norm(part)
            if low.startswith("udp://") or low.startswith("srt://"):
                markers.add(low)
                markers.add(low.split("?", 1)[0])
    return [m for m in markers if m]


def _kill_process_tree(pid: int):
    """Terminate `pid` and any children it spawned (cross platform)."""
    import psutil as _ps
    victims = []
    try:
        victims = _ps.Process(pid).children(recursive=True)
    except Exception:
        pass
    for p in reversed(victims):
        try:
            p.kill()
        except Exception:
            pass
    try:
        _ps.Process(pid).kill()
    except Exception:
        pass


def _sweep_stray_ffmpeg():
    """Kill leftover ffmpeg processes from a previous server run that still
    write into this instance's live folders or stream outputs (they corrupt
    the HLS output / keep an orphan UDP stream alive).

    Uses psutil so the same code works on Windows and Linux (the original
    implementation shelled out to PowerShell/Get-CimInstance + taskkill, which
    does not exist on Ubuntu)."""
    markers = [m.lower() for m in _stray_ffmpeg_markers() if m]
    killed = 0
    try:
        import psutil as _ps
        for proc in _ps.process_iter(["pid", "name", "cmdline"]):
            try:
                name = (proc.info.get("name") or "").lower()
                cmdline = " ".join(proc.info.get("cmdline") or []).lower()
            except Exception:
                continue
            if not name.startswith("ffmpeg"):
                continue
            if any(m in cmdline for m in markers):
                try:
                    _kill_process_tree(proc.pid)
                    killed += 1
                    print(f"[playout] killed stray ffmpeg pid {proc.pid}")
                except Exception:
                    pass
    except Exception as e:
        print(f"[playout] stray ffmpeg sweep failed: {e}")
        return
    if killed:
        print(f"[playout] stray ffmpeg sweep: killed {killed} leftover process(es)")


_autostart_tasks: set = set()


def _autostart_channel(ch_id: int) -> bool:
    """Resume a channel's playout after the server process starts.

    Playout state (program, index, running) lives only in this process, so a
    service restart or a reboot used to leave the channel dark until somebody
    pressed Start in the UI - which is not acceptable for a 24/7 channel.
    Channels flagged ``auto_start`` in db.json now sync themselves to the
    scheduled slot for the current day on startup.
    """
    state = playout_states.get(ch_id)
    if not state or state.get("running"):
        return False
    try:
        today = _get_now_in_tz(_get_channel_timezone(ch_id)).strftime("%Y-%m-%d")
        program = load_playlist_for_date(ch_id, today)
        if not program:
            print(f"[playout] channel {ch_id}: auto-start skipped, no program")
            return False
        pcfg = _get_playout_config(ch_id)
        day_start = (pcfg.get("playlist") or {}).get("day_start", "00:00:00")
        idx, elapsed = _get_start_index(program, day_start, ch_id)
        # same cleanup the manual start/restart path does - without it the
        # stale playlist and segments of the previous run survive, and with
        # append_list the new muxer would keep appending to them
        _cleanup_hls_files(ch_id, include_m3u8=True)
        state.pop("exhausted", None)
        state["program"] = program
        state["index"] = idx
        state["elapsed"] = max(elapsed, 0.0)
        state["running"] = True
        print(f"[playout] channel {ch_id}: auto-start at {idx + 1}/{len(program)}")
        return True
    except Exception as exc:
        print(f"[playout] channel {ch_id}: auto-start failed: {exc}")
        return False


async def _delayed_autostart(ch_id: int, delay: float = 8.0):
    # give the playout tick loop and the HTTP server a moment to settle
    await asyncio.sleep(delay)
    _autostart_channel(ch_id)


@asynccontextmanager
async def lifespan(application: FastAPI):
    _sweep_stray_ffmpeg()
    for ch in load_db()["channels"]:
        ch_id = ch["id"]
        if ch_id not in playout_states:
            playout_states[ch_id] = {
                "running": False,
                "program": [],
                "index": 0,
                "elapsed": 0,
                "shift": 0,
                "gen": 0,
            }
        prepare_channel_asset_folders(Path(ch["storage"]))
        task = asyncio.create_task(playout_tick(ch_id))
        _tick_tasks.add(task)
        task.add_done_callback(_tick_task_done)
        # 24x7: resume playback automatically after a restart / reboot
        if ch.get("auto_start", False):
            _autostart_tasks.add(asyncio.create_task(_delayed_autostart(ch_id)))
        # Background auto-preprocess watcher: transcode files as soon as they
        # appear in the channel's media folder (only if auto_preprocess is on).
        if ch.get("auto_preprocess", False):
            watcher = asyncio.create_task(_preprocess_watcher(ch_id, True))
            _watcher_tasks.add(watcher)
            watcher.add_done_callback(_watcher_task_done)
    # periodic per-channel email flusher
    mail_flush_task = asyncio.create_task(_mail_flush_loop())
    _mail_flush_tasks.add(mail_flush_task)
    mail_flush_task.add_done_callback(_worker_task_done)
    yield
    # server shutting down: don't orphan the ffmpeg children
    for ch_id in list(playout_states.keys()):
        _kill_ffmpeg(ch_id)
    for task in list(_autostart_tasks):
        task.cancel()
    # stop the background preprocess watchers
    for task in list(_watcher_tasks):
        task.cancel()
    for task in list(_mail_flush_tasks):
        task.cancel()


def _tick_task_done(task: asyncio.Task):
    _tick_tasks.discard(task)
    if not task.cancelled() and task.exception():
        print(f"[playout] tick task crashed: {task.exception()}")


def _worker_task_done(task: asyncio.Task):
    _mail_flush_tasks.discard(task)
    if not task.cancelled() and task.exception():
        print(f"[mail] flush task crashed: {task.exception()}")


app = FastAPI(lifespan=lifespan)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# FFPU_SECRET_KEY / SECRET_KEY override the literal below, so the signing key can
# be rotated from /etc/ffplayout/ffplayout.env without touching this file.
# The literal is only a dev fallback - always set the env var in production.
SECRET_KEY = os.environ.get("FFPU_SECRET_KEY") or os.environ.get("SECRET_KEY") or "ffplayout-secret-key-change-in-production"
ALGORITHM = "HS256"
ACCESS_TOKEN_EXPIRE_MINUTES = 1440
REFRESH_TOKEN_EXPIRE_DAYS = 30
VALID_UUIDS = {}

FFMPEG_BIN = "ffmpeg"
FFPROBE_BIN = "ffprobe"


def _find_ffmpeg():
    global FFMPEG_BIN, FFPROBE_BIN
    import shutil
    found = shutil.which("ffmpeg")
    if found:
        FFMPEG_BIN = found
    else:
        for candidate in [
            r"D:\ffmpeg\ffmpeg\bin\ffmpeg.exe",
            r"C:\ffmpeg\bin\ffmpeg.exe",
            r"/usr/bin/ffmpeg",
            r"/usr/local/bin/ffmpeg",
        ]:
            if os.path.isfile(candidate):
                FFMPEG_BIN = candidate
                break
    found_probe = shutil.which("ffprobe")
    if found_probe:
        FFPROBE_BIN = found_probe
    else:
        for candidate in [
            r"D:\ffmpeg\ffmpeg\bin\ffprobe.exe",
            r"C:\ffmpeg\bin\ffprobe.exe",
            r"/usr/bin/ffprobe",
            r"/usr/local/bin/ffprobe",
        ]:
            if os.path.isfile(candidate):
                FFPROBE_BIN = candidate
                break

_find_ffmpeg()

VIDEO_EXTENSIONS = {".mp4", ".mkv", ".avi", ".mov", ".ts", ".flv", ".wmv", ".webm", ".mpg", ".mpeg", ".mxf", ".m4v"}
