    db = load_db()
    db["users"] = [u for u in db["users"] if u["id"] != user_id]
    save_db(db)
    return JSONResponse(status_code=200, content={"detail": "deleted"})


# === PLAYOUT STATE ===

playout_states = {}
playout_processes = {}
sse_subscribers = {}

# Runtime graphic (channel bug) overlay override, per channel. This lets the
# Player "Enable graphics with duration" control push the graphic onto the
# live on-air stream immediately without touching the persistent config.
# Value shape: {"enabled": bool, "enable_until": float|None, "timer": task|None,
#               "graphic_rel": str, "sq_phase": "off"|"in"|"on"|"out",
#               "sq_epoch": float|None, "sq_timer": task|None}
_graphic_runtime: dict[int, dict] = {}

# Default duration (seconds) of the smooth L-band squeeze transition: the main
# video animated scale into the graphic's "video hole" (in) and back to full
# resolution (out). Overridable per channel via processing.squeeze_fade.
_SQUEEZE_FADE_DEFAULT = 1.0
# when the outputs of a channel were last spawned; the hls stale check must
# not kill a fresh ffmpeg before it had a chance to write its first playlist
_SPAWN_AT: dict[int, float] = {}
_FFMPEG_STARTUP_GRACE = 25.0

# Limit the number of threads each libx264 encode may use. Reducing the
# parallel slice count avoids saturating every core when the HLS and UDP
# processes are both encoding the same clip, keeping CPU headroom for the
# server and other channels so playout stays smooth under load.
# 0 = let ffmpeg auto-detect (no limit).
_FFMPEG_THREADS = 4

# Threads reserved for the high-quality production (UDP/SRT mpegts) stream so
# a slow preset (e.g. medium at 1080p) can still encode in realtime and never
# fall behind -> no HLS/stream buffering. Kept separate from _FFMPEG_THREADS
# so the lightweight monitor/ABR renditions stay cheap.
_FFMPEG_STREAM_THREADS = 6

# Windows process priority class for encode subprocesses. Encoding is done at
# a lower priority than the server so heavy transcode work never starves the
# playout loop / API (smoother HLS/UDP output during heavy load).
# CREATE_BELOW_NORMAL_PRIORITY_CLASS = 0x00004000
_WIN_BELOW_NORMAL = 0x00004000


def _popen_flags():
    """subprocess creation flags for ffmpeg encode subprocesses on Windows:
    no console window plus below-normal priority so encodes don't compete
    with the server's own scheduling for smooth playout."""
    flags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
    if os.name == "nt":
        flags |= _WIN_BELOW_NORMAL
    return flags


def _thread_args(n: int = 0):
    """-threads args for libx264 encodes; empty when no limit is configured.
    When n is > 0 it overrides the global cap for that specific encode (used to
    give the high-quality production stream enough threads to keep up with
    realtime without throttling the lightweight monitor/ABR renditions)."""
    threads = n if n and n > 0 else _FFMPEG_THREADS
    if threads and threads > 0:
        return ["-threads", str(threads)]
    return []


# HLS ABR ladder: one HLS rendition per entry, each encoded at its own
# resolution and video bitrate, listed together under master.m3u8 so players
# can switch quality on the fly. The default ladder matches the production
# processing resolution at the top (full-res high quality), down to a mobile
# rendition. Override per channel via pcfg["output"]["hls_variants"].
# This ladder is used for streaming output only; monitoring uses a single
# 480p rendition (see _get_monitor_variants).
_DEFAULT_HLS_VARIANTS = [
    {"name": "1080p", "width": 1920, "height": 1080, "bitrate": "6000k", "audio": "192k"},
    {"name": "720p", "width": 1280, "height": 720, "bitrate": "2800k", "audio": "128k"},
    {"name": "480p", "width": 854, "height": 480, "bitrate": "1400k", "audio": "128k"},
    {"name": "240p", "width": 426, "height": 240, "bitrate": "400k", "audio": "64k"},
]


def _get_hls_variants(channel_id: int) -> list:
    """ABR ladder for a channel: configured list or the default ladder."""
    pcfg = _get_playout_config(channel_id)
    variants = (pcfg.get("output") or {}).get("hls_variants")
    if isinstance(variants, list) and variants:
        cleaned = []
        for v in variants:
            if isinstance(v, dict) and v.get("name") and v.get("width") and v.get("height"):
                cleaned.append(v)
        if cleaned:
            return cleaned
    return [dict(v) for v in _DEFAULT_HLS_VARIANTS]


# Monitoring renders a single low-resolution rendition: it is only ever seen by
# the operators watching the web UI, so encoding it at production resolution
# just burns CPU that the ad slate / SCTE-35 / NNL graphics work needs.
_MONITOR_RENDITION = {"name": "480p", "width": 854, "height": 480,
                     "bitrate": "1400k", "audio": "128k"}


def _get_monitor_variant_name(channel_id: int) -> str:
    variants = _get_monitor_variants(channel_id)
    return variants[0]["name"] if variants else _MONITOR_RENDITION["name"]


def _get_monitor_variants(channel_id: int) -> list:
    """Monitoring HLS: a single 480p rendition. The multi-variant ABR ladder
    is reserved for the streaming output, so the preview stays a single encode
    that never lags behind realtime, and it is deliberately kept well below the
    production resolution so the monitor encode is cheap. Picks the "480p" entry
    of the ABR ladder when present; otherwise falls back to the default 480p
    rendition."""
    ladder = _get_hls_variants(channel_id)
    for v in ladder:
        if v.get("name") == _MONITOR_RENDITION["name"]:
            return [dict(v)]
    return [dict(_MONITOR_RENDITION)]


def _write_hls_master(channel_id: int, variants: list, vtt_on: bool = False):
    """Write master.m3u8 listing every ABR rendition as a media playlist.
    ffmpeg's own -master_pl_name can only name the variants of a single
    process, so with multiple renditions we author the master here. When a
    soft WebVTT subtitle track rides along (processing.vtt_enable), a
    #EXT-X-MEDIA:TYPE=SUBTITLES rendition is declared per variant, pointing
    at the `variant_<name>_vtt.m3u8` playlist ffmpeg writes for the mapped
    subtitle stream, and each STREAM-INF joins the shared subtitle group."""
    try:
        live_dir = _get_live_dir(channel_id)
        lines = ["#EXTM3U", "#EXT-X-VERSION:3"]
        for v in variants:
            name = v["name"]
            bw = str(int(float(str(v.get("bitrate", "5000k")).rstrip("kK")) * 1000))
            sub_attr = ""
            if vtt_on:
                lines.append(
                    '#EXT-X-MEDIA:TYPE=SUBTITLES,GROUP-ID="subs",NAME="Subtitles",'
                    f'DEFAULT=YES,AUTOSELECT=YES,FORCED=NO,URI="variant_{name}_vtt.m3u8"'
                )
                sub_attr = ',SUBTITLES="subs"'
            lines.append(
                f'#EXT-X-STREAM-INF:BANDWIDTH={bw},RESOLUTION='
                f'{v["width"]}x{v["height"]}{sub_attr}'
            )
            lines.append(f"variant_{name}.m3u8")
        (live_dir / "master.m3u8").write_text(
            "\n".join(lines) + "\n", encoding="utf-8")
    except OSError:
        pass


def load_playlist_for_date(channel_id: int, date: str):
    pl_file = DATA_DIR / "playlists" / f"{channel_id}_{date}.json"
    if pl_file.exists():
        with open(pl_file, "r", encoding="utf-8") as f:
            data = json.load(f)
        program = data.get("program", [])
        if program:
            return program

    program = _generate_fallback_playlist(channel_id)
    if program:
        print(f"[playout] channel {channel_id}: no playlist for {date}, "
              f"generated fallback schedule from {len(program)} available clips")
        return program
    return []


_FALLBACK_SEGMENT_SECS = 300.0
_FALLBACK_BREAK_EVERY = 315.0
_FALLBACK_AD_STEMS = {"adslate", "p17mecfp0093"}
_FALLBACK_GRAPHICS = (("Aston", 60.0, 20.0), ("L-band", 120.0, 20.0))


def _fallback_graphic_available(channel_id: int, template: str) -> bool:
    """True when an NNL render exists for ``template``.

    Renders may carry a work-in-progress suffix - "Aston-test.mov" answers
    to the template name "Aston" - so both the plain and the suffixed stem
    are accepted. Templates with no render are skipped rather than
    scheduled, so the schedule never references a graphic that cannot render.
    """
    try:
        nnl_dir = _get_channel_storage(channel_id) / "graphics" / "NNL"
    except Exception:
        return False
    if not nnl_dir.is_dir():
        return False
    try:
        for entry in nnl_dir.iterdir():
            stem = entry.stem
            if stem == template or stem.startswith(template + "-"):
                return True
    except OSError:
        return False
    return False


def _generate_fallback_playlist(channel_id: int) -> list:
    """Build a 24-hour loop schedule from the channel's media files when no
    playlist file exists for the requested date.

    Every date without a hand-built playlist file gets a continuous 24/7
    loop that exercises the full feature set rather than a bare back-to-back
    file list:

      * long programme media is sliced into ``_FALLBACK_SEGMENT_SECS`` chunks
        so breaks and graphics land every few minutes instead of once per
        multi-hour clip,
      * a short advertisement slot (category "advertisement") is inserted
        after every ``_FALLBACK_BREAK_EVERY`` seconds of programme time, so
        ``_is_ad_clip`` matches on category and an SCTE-35 splice_insert is
        generated for every break,
      * "Aston" and "L-band" secondary events are attached to every programme
        slice long enough to hold them.

    Without this the fallback path produced no categories and no secondary
    events at all, so a date with no playlist file aired with neither SCTE
    markers nor NNL graphics.
    """
    storage = _get_channel_storage(channel_id)
    pcfg = _get_playout_config(channel_id)
    day_start = (pcfg.get("playlist") or {}).get("day_start", "00:00:00")
    start_sec = _day_start_seconds(day_start)

    extensions = set(pcfg.get("storage", {}).get("extensions", []) or [])
    if not extensions:
        extensions = {"mp4", "mxf", "mpg", "mov", "mpeg", "mkv", "avi",
                       "wmv", "flv", "m4v", "ts"}

    media_files = []
    media_dir = storage / "media"
    search_dirs = [d for d in (media_dir, storage) if d.is_dir()]

    # When storage IS the process dir (legacy layout), also scan its parent
    # directory where the raw source files live.
    if storage.name.lower() == "process" and storage.parent.is_dir():
        search_dirs.append(storage.parent)

    seen_paths = set()
    for search_dir in search_dirs:
        try:
            entries = sorted(search_dir.iterdir())
        except OSError:
            continue
        for entry in entries:
            if entry.is_file() and entry.suffix.lower().lstrip(".") in extensions:
                abs_path = _resolve_source(channel_id, entry.name)
                if not abs_path or not os.path.isfile(abs_path):
                    abs_path = str(entry)
                # several source files can resolve onto the same processed
                # .ts - only schedule each target once
                if os.path.isfile(abs_path) and abs_path not in seen_paths:
                    seen_paths.add(abs_path)
                    media_files.append(abs_path)

    if not media_files:
        return []

    # split the pool into advertisement slots and programme media
    ads, shows = [], []
    for path in sorted(media_files, key=lambda p: os.path.basename(p).lower()):
        stem = Path(path).stem.lower()
        if stem in _FALLBACK_AD_STEMS or stem.startswith("adslate"):
            ads.append(path)
        else:
            shows.append(path)

    # no advertisement asset means no SCTE breaks can be built
    if not ads or not shows:
        return []

    graphics = [g for g in _FALLBACK_GRAPHICS
                if _fallback_graphic_available(channel_id, g[0])]

    durations = {}
    for path in ads + shows:
        try:
            dur = _probe_cached(path)
        except Exception:
            dur = 10.0
        durations[path] = dur if dur and dur > 0 else 10.0

    program = []
    cursor = float(start_sec)
    since_break = 0.0
    show_i = 0
    ad_i = 0
    n = 0

    while cursor < 86400:
        src = shows[show_i % len(shows)]
        show_i += 1
        total = durations[src]
        title = Path(src).stem
        offset = 0.0

        # slice one source into segment sized chunks
        while offset < total and cursor < 86400:
            take = min(_FALLBACK_SEGMENT_SECS, total - offset)

            events = []
            for template, at, length in graphics:
                if at + length <= take:
                    events.append({
                        "template": template,
                        "offset": at,
                        "duration": length,
                        "in": round(offset + at, 3),
                        "out": round(offset + at + length, 3),
                        "text": title,
                    })

            program.append({
                "uid": f"fb_{channel_id}_{n}_{int(cursor)}",
                "begin": round(cursor, 3),
                "title": title,
                "source": src,
                "in": round(offset, 3),
                "out": round(offset + take, 3),
                "duration": round(take, 3),
                "category": "",
                "secondary_events": events,
            })
            n += 1
            cursor += take
            offset += take
            since_break += take

            if since_break >= _FALLBACK_BREAK_EVERY and cursor < 86400:
                ad_src = ads[ad_i % len(ads)]
                ad_i += 1
                ad_dur = min(durations[ad_src], 30.0)
                program.append({
                    "uid": f"fb_{channel_id}_{n}_{int(cursor)}",
                    "begin": round(cursor, 3),
                    "title": Path(ad_src).stem,
                    "source": ad_src,
                    "in": 0.0,
                    "out": round(ad_dur, 3),
                    "duration": round(ad_dur, 3),
                    "category": "advertisement",
                    "secondary_events": [],
                })
                n += 1
                cursor += ad_dur
                since_break = 0.0

    return program

def _get_channel_timezone(channel_id: int) -> str:
    db = load_db()
    for ch in db.get("channels", []):
        if ch.get("id") == channel_id:
            return ch.get("timezone", "UTC")
    return "UTC"


def _get_now_in_tz(tz_name: str) -> datetime:
    try:
        from zoneinfo import ZoneInfo
        return datetime.now(ZoneInfo(tz_name))
    except Exception:
        try:
            import pytz
            return datetime.now(pytz.timezone(tz_name))
        except Exception:
            return datetime.now()


def _day_start_seconds(day_start: str) -> int:
    """'HH:MM:SS[.ms]' -> seconds from midnight; invalid input -> 0."""
    try:
        parts = [int(float(x)) for x in str(day_start or "00:00:00").split(":")[:3]]
        while len(parts) < 3:
            parts.append(0)
        return parts[0] * 3600 + parts[1] * 60 + parts[2]
    except (TypeError, ValueError):
        return 0


def _int_to_hms(seconds: float) -> str:
    s = int(max(float(seconds or 0), 0))
    return f"{s // 3600:02d}:{(s % 3600) // 60:02d}:{s % 60:02d}"


def _current_rel_seconds(channel_id: int, day_start: str) -> float:
    """Current wall-clock time of the channel timezone as seconds relative
    to the playlist day start (wraps around midnight)."""
    now = _get_now_in_tz(_get_channel_timezone(channel_id))
    current_sec = now.hour * 3600 + now.minute * 60 + now.second + now.microsecond / 1e6
    rel_sec = current_sec - _day_start_seconds(day_start)
    if rel_sec < 0:
        rel_sec += 86400
    return rel_sec


def _get_start_index(program: list, day_start: str, channel_id: int = 1) -> tuple:
    if not program:
        return (0, 0.0)

    rel_sec = _current_rel_seconds(channel_id, day_start)

    for i, item in enumerate(program):
        begin = item.get("begin", 0)
        clip_duration = item.get("out", 0) - item.get("in", 0)
        if clip_duration <= 0:
            clip_duration = item.get("duration", 10)
        if begin + clip_duration > rel_sec:
            elapsed = rel_sec - begin
            return (i, max(elapsed, 0.0))

    return (len(program) - 1, 0.0)


# HLS continuity flags for the live playlist.
#
# Every clip is a separate ffmpeg run writing the same variant playlist, so
# without these the muxer overwrote the playlist on each clip change: the
# segment filenames carried a per-run timestamp prefix, MEDIA-SEQUENCE jumped
# back to 0, and no EXT-X-DISCONTINUITY was emitted. Players that validate
# continuity rejected the manifest right where an SCTE-35 splice insert lands.
#
# append_list         - keep appending to the existing playlist instead of
#                       rewriting it, so MEDIA-SEQUENCE keeps climbing
# omit_endlist        - a finished clip must not write #EXT-X-ENDLIST, which
#                       would tell players the stream ended
# delete_segments     - honour -hls_list_size so the live folder does not
#                       grow without bound over a 24/7 run
# independent_segments- every segment starts on a keyframe, so a player can
#                       join at any ad boundary
HLS_CONTINUITY_FLAGS = "append_list+omit_endlist+delete_segments+independent_segments"


def _get_live_dir(channel_id: int) -> Path:
    live_dir = DATA_DIR / "channel" / str(channel_id) / "live"
    live_dir.mkdir(parents=True, exist_ok=True)
    return live_dir


def _cleanup_hls_files(channel_id: int, include_m3u8: bool = False):
    live_dir = _get_live_dir(channel_id)
    # old vtt cue tracks accumulate every clip run; always sweep them
    patterns = ["*.ts", "*.vtt"]
    if include_m3u8:
        patterns.append("*.m3u8")
    for pattern in patterns:
        for f in live_dir.glob(pattern):
            try:
                f.unlink(missing_ok=True)
            except PermissionError:
                pass


_HLS_SWEEP_AT: dict[int, float] = {}


def _sweep_old_hls_segments(channel_id: int, max_age: float = 90.0,
                            min_interval: float = 15.0):
    """Delete hls segment/vtt files old enough that no playlist can list
    them anymore; recently written files are kept, so players polling a
    cached playlist never get a 404."""
    now = time.time()
    if now - _HLS_SWEEP_AT.get(channel_id, 0.0) < min_interval:
        return
    _HLS_SWEEP_AT[channel_id] = now

    live_dir = _get_live_dir(channel_id)
    for pattern in ("*.ts", "*.vtt"):
        for f in live_dir.glob(pattern):
            try:
                if now - f.stat().st_mtime > max_age:
                    f.unlink(missing_ok=True)
            except OSError:
                continue


def _prune_dead_hls_entries(playlist: Path) -> int:
    """Drop playlist entries whose segment file no longer exists.

    ffmpeg's delete_segments retires old segments as the muxer runs, and
    _sweep_old_hls_segments removes stragglers, so a playlist written before
    a clip change can still list segments that are already gone. With
    append_list the next muxer inherits that playlist, so the dead entries
    persist: players 404 on them and the stale-playlist watchdog kills a
    perfectly healthy encoder over and over (it did exactly that, respawning
    both outputs every ~37s).

    Only a trailing run of existing segments is kept so the sequence numbers
    stay contiguous, and MEDIA-SEQUENCE is advanced by the number of dropped
    entries to match. Returns how many entries were dropped.
    """
    try:
        lines = playlist.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return 0

    seg_idx = [i for i, ln in enumerate(lines)
               if ln.strip() and not ln.strip().startswith("#")]
    if not seg_idx:
        return 0

    live_dir = playlist.parent
    # first index of the TRAILING run of segments that all still exist: walk
    # back from the newest entry and stop at the first hole. Anything older
    # than that hole is dead and gets dropped.
    keep_from = len(seg_idx)
    for n in range(len(seg_idx) - 1, -1, -1):
        if not (live_dir / lines[seg_idx[n]].strip()).is_file():
            break
        keep_from = n
    # the newest segment is missing -> the muxer is genuinely wedged, not a
    # stale-retirement artefact; leave the playlist alone and let the
    # stale-playlist watchdog respawn instead of pruning to nothing
    if keep_from == 0 or keep_from == len(seg_idx):
        return 0

    try:
        first_extinf = next(i for i, ln in enumerate(lines)
                            if ln.startswith("#EXTINF"))
    except StopIteration:
        return 0

    m = re.search(r"^#EXT-X-MEDIA-SEQUENCE:(\d+)$", "\n".join(lines), re.M)
    old_ms = int(m.group(1)) if m else 0

    header = lines[:first_extinf]
    # a discontinuity inside the dropped span must survive as a single tag,
    # otherwise the surviving sequence numbers claim to be continuous
    if any(ln.startswith("#EXT-X-DISCONTINUITY") for ln in lines[first_extinf:seg_idx[keep_from]]):
        header = header + ["#EXT-X-DISCONTINUITY"]

    out = header + lines[seg_idx[keep_from] - 1:]
    out = [re.sub(r"^#EXT-X-MEDIA-SEQUENCE:\d+$",
                  "#EXT-X-MEDIA-SEQUENCE:%d" % (old_ms + keep_from), ln)
           for ln in out]

    try:
        tmp = playlist.with_suffix(playlist.suffix + ".tmp")
        tmp.write_text("\n".join(out) + "\n", encoding="utf-8")
        tmp.replace(playlist)
    except OSError:
        return 0
    return keep_from


def _hls_playlist_stale(channel_id: int, grace: float = 12.0) -> bool:
    """True when the primary HLS ABR playlist lists at least one segment file
    missing on disk and was not rewritten for `grace` seconds - the sign of a
    dead or wedged hls muxer that leaves players endless 404ing."""
    try:
        live_dir = _get_live_dir(channel_id)
        # primary = the monitoring rendition (the 480p playlist the playout
        # {channel}_hls process actually writes). using the full ABR ladder's
        # first variant would watch e.g. a stale 1080p playlist left over from
        # a previous HLS stream run, falsely reporting the healthy live
        # playout as stalled and needlessly respawning it.
        variants = _get_monitor_variants(channel_id)
        m3u8 = live_dir / f"variant_{variants[0]['name']}.m3u8"
        if not m3u8.is_file():
            m3u8 = live_dir / "stream.m3u8"
        if not m3u8.is_file():
            return False
        if time.time() - m3u8.stat().st_mtime < grace:
            return False
        # Only the NEWEST listed segment decides staleness. Retired segments
        # are supposed to disappear (delete_segments / _sweep_old_hls_segments)
        # while the playlist still lists them, so treating any missing entry as
        # a dead muxer produced false positives and a respawn loop.
        segs = [ln.strip() for ln in
                m3u8.read_text(encoding="utf-8", errors="replace").splitlines()
                if ln.strip() and not ln.strip().startswith("#")]
        if segs and not (live_dir / segs[-1]).is_file():
            return True
        return False
    except OSError:
        return False


def _kill_ffmpeg(channel_id: int):
    # kill the udp process plus every HLS ABR variant process
    keys = [k for k in list(playout_processes.keys())
            if k == channel_id
            or (isinstance(k, str) and k.startswith(f"{channel_id}_hls"))
            or (isinstance(k, str) and k.startswith(f"{channel_id}_abr"))]
    for key in keys:
        proc = playout_processes.pop(key, None)
        if proc and proc.poll() is None:
            try:
                proc.kill()
                proc.wait(timeout=3)
            except Exception:
                pass
    _scrub_hls_endlist(channel_id)


def _kill_udp(channel_id: int):
    """Stop only the streaming (UDP/SRT mpegts) output process, leaving the
    playout loop + HLS variants untouched. Safely handles the case where the
    UDP process was already stopped or replaced by a newer spawn."""
    proc = playout_processes.pop(channel_id, None)
    if proc and proc.poll() is None:
        try:
            proc.kill()
            proc.wait(timeout=3)
        except Exception:
            pass


def _kill_hls_abr(channel_id: int):
    """Stop only the HLS ABR ladder streaming variant processes, leaving the
    single 480p monitoring process untouched. The ABR ladder is the multi-
    rendition HLS output used for streaming; the preview uses only 480p."""
    keys = [k for k in list(playout_processes.keys())
            if isinstance(k, str) and k.startswith(f"{channel_id}_abr")]
    for key in keys:
        proc = playout_processes.pop(key, None)
        if proc and proc.poll() is None:
            try:
                proc.kill()
                proc.wait(timeout=3)
            except Exception:
                pass
    _scrub_hls_endlist(channel_id)


def _spawn_udp(channel_id: int):
    """(Re)start only the streaming (UDP/SRT) output process using the exact
    command that built it for the current clip. No-op if the playout has not
    spawned anything yet (no stored cmd) or if streaming is already disabled."""
    st_ = playout_states.get(channel_id)
    cmd = (st_ or {}).get("udp_cmd")
    if not cmd or not (st_ or {}).get("stream_enabled", False):
        return
    # Make sure we are not already running (or a stale entry lingers).
    prev = playout_processes.get(channel_id)
    if prev and prev.poll() is None:
        return
    try:
        udp_log = _ffmpeg_log_file(channel_id, "udp")
        try:
            udp_proc = subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=udp_log,
                creationflags=_popen_flags(),
            )
            playout_processes[channel_id] = udp_proc
        finally:
            udp_log.close()
    except Exception as e:
        print(f"[playout] UDP output restart failed for channel {channel_id}: {e}")


def _ingest_input_param(channel_id: int) -> str:
    """Resolve the live-ingest source for a channel. The per-channel advanced
    config (Advanced settings > Ingest > Input Parameter) wins, then the
    playout ingest section (enable + input_param, typically an SRT listener)."""
    db = load_db()
    adv = db.get("advanced_configs", {}).get(str(channel_id))
    candidates = adv if isinstance(adv, list) else ([adv] if adv else [])
    for c in candidates:
        inp = (c.get("ingest") or {}).get("input_param", "") if isinstance(c, dict) else ""
        if inp and str(inp).strip():
            return str(inp).strip()
    pcfg = _get_playout_config(channel_id)
    ing = pcfg.get("ingest") or {}
    if ing.get("enable") and str(ing.get("input_param") or "").strip():
        return str(ing.get("input_param")).strip()
    return ""


def _parse_ingest_inputs(input_param: str) -> list[str]:
    """Turn the raw ingest input parameter into ffmpeg input args. A bare URL
    gets wrapped in -i; anything already starting with an option (e.g. an
    `-i "srt://...?mode=listener"`) is passed through verbatim."""
    try:
        toks = shlex.split(input_param)
    except ValueError:
        toks = input_param.split()
    if not toks:
        return []
    if toks[0] == "-i":
        return toks
    return ["-i"] + toks[:1]


def _kill_ingest(channel_id: int):
    """Stop just the ingest-owned processes (480p preview + UDP/SRT), leaving
    the playlist state intact so a normal respawn can take over."""
    for key in (f"{channel_id}_hls", channel_id):
        proc = playout_processes.pop(key, None)
        if proc and proc.poll() is None:
            try:
                proc.kill()
                proc.wait(timeout=3)
            except Exception:
                pass
    _scrub_hls_endlist(channel_id)


def _spawn_ingest(channel_id: int) -> bool:
    """Feed the configured live-ingest source into the 480p monitoring preview
    and the UDP/SRT stream output, replacing the scheduled playout while the
    source stays alive. Returns True when at least the preview came up."""
    input_args = _parse_ingest_inputs(_ingest_input_param(channel_id))
    if not input_args:
        return False

    st_ = playout_states.setdefault(channel_id, {
        "running": False, "program": [], "index": 0, "elapsed": 0,
        "shift": 0, "gen": 0, "stream_enabled": False,
    })
    live_dir = _get_live_dir(channel_id)
    map_args = ["-map", "0:v:0", "-map", "0:a:0?"]
    launched = 0

    variants = _get_monitor_variants(channel_id)
    for v in variants:
        vp = str(live_dir / f"variant_{v['name']}_%05d.ts").replace("\\", "/")
        vpl = str(live_dir / f"variant_{v['name']}.m3u8").replace("\\", "/")
        # append_list inherits whatever the previous muxer left behind, so drop
        # entries whose segments are already gone before handing it over
        _prune_dead_hls_entries(Path(vpl))
        codec = ["-c:v", "libx264", "-preset", "ultrafast", "-tune", "zerolatency",
                 "-b:v", str(v.get("bitrate", "5000k")),
                 "-maxrate", str(v.get("bitrate", "5000k")),
                 "-bufsize", str(int(float(str(v.get("bitrate", "5000k")).rstrip('kK')) * 2)) + "k",
                 "-c:a", "aac", "-b:a", str(v.get("audio", "128k")), "-ar", "48000"]
        cmd = ([FFMPEG_BIN, "-y"] + input_args + map_args + codec + _thread_args()
               + ["-g", "50", "-f", "hls", "-hls_time", "2", "-hls_list_size", "30",
               "-hls_flags", HLS_CONTINUITY_FLAGS,
                  "-hls_segment_filename", vp, vpl])
        try:
            v_log = _ffmpeg_log_file(channel_id, "hls_ingest")
            try:
                proc = subprocess.Popen(
                    cmd,
                    stdout=subprocess.DEVNULL,
                    stderr=v_log,
                    creationflags=_popen_flags(),
                )
                playout_processes[f"{channel_id}_hls"] = proc
                launched += 1
            finally:
                v_log.close()
        except Exception as e:
            print(f"[playout] ingest HLS start failed for channel {channel_id}: {e}")

    if launched:
        _write_hls_master(channel_id, _get_monitor_variants(channel_id))
        _SPAWN_AT[channel_id] = time.time()

    # UDP/SRT stream output follows the ingest source when streaming is on
    output_mode = (_get_playout_config(channel_id).get("output") or {}).get("mode", "stream")
    if output_mode != "hls" and st_.get("stream_enabled", False):
        codec_params, output_dest = _get_output_params(channel_id)
        pid_args = _get_mpegts_pid_args(channel_id)
        udp_cmd = ([FFMPEG_BIN, "-y"] + input_args + map_args + codec_params
                   + _thread_args(_FFMPEG_STREAM_THREADS) + ["-f", "mpegts"]
                   + pid_args + [output_dest])
        try:
            udp_log = _ffmpeg_log_file(channel_id, "udp_ingest")
            try:
                proc = subprocess.Popen(
                    udp_cmd,
                    stdout=subprocess.DEVNULL,
                    stderr=udp_log,
                    creationflags=_popen_flags(),
                )
                playout_processes[channel_id] = proc
            finally:
                udp_log.close()
        except Exception as e:
            print(f"[playout] ingest UDP start failed for channel {channel_id}: {e}")

    return launched > 0


def _spawn_hls_abr(channel_id: int):
    """(Re)start the HLS ABR ladder streaming variant processes. Reads the
    current ABR ladder from the playout config and spawns one ffmpeg process
    per rendition, separate from the single 480p monitoring rendition."""
    st_ = playout_states.get(channel_id)
    if not st_ or not (st_ or {}).get("stream_enabled", False):
        return
    pcfg = _get_playout_config(channel_id)
    output_mode = (pcfg.get("output") or {}).get("mode", "stream")
    if output_mode != "hls":
        return

    abr_variants = _get_hls_variants(channel_id)
    if not abr_variants:
        return

    # If the playout is currently on a generated test-pattern stall, spawn the
    # ABR ladder from the lavfi test signal instead of a file source.
    if st_.get("cur_is_test"):
        proc = pcfg.get("processing", {})
        _spawn_hls_abr_test_pattern(
            channel_id,
            int(proc.get("width", 1920)),
            int(proc.get("height", 1080)),
            int(proc.get("fps", 25)),
        )
        return

    live_dir = _get_live_dir(channel_id)
    current = st_.get("cur_source")
    if not current:
        return

    try:
        source = _resolve_source(channel_id, current)
        if not source:
            return
        seek_in = st_.get("cur_seek", 0)
        duration = st_.get("cur_dur", 10)
        item = st_.get("cur_item")

        hls_procs = []
        spawn_had_vtt = False
        monitor_name = _get_monitor_variant_name(channel_id)
        for v in abr_variants:
            if v.get("name") == monitor_name:
                # The monitor rendition is reserved for monitoring (already
                # spawned by the playout loop); skip it here to avoid double
                # encoding.
                continue
            v_input, v_map, v_cc = _build_ffmpeg_inputs_and_maps(
                channel_id, source, seek_in, duration,
                item=item, variant_scale=(v["width"], v["height"]), skip_logo=True,
            )
            if v_cc:
                spawn_had_vtt = True
            vp = str(live_dir / f"variant_{v['name']}_%05d.ts").replace("\\", "/")
            vpl = str(live_dir / f"variant_{v['name']}.m3u8").replace("\\", "/")
            codec = ["-c:v", "libx264", "-preset", "veryfast", "-tune", "zerolatency",
                     "-b:v", str(v.get("bitrate", "5000k")),
                     "-maxrate", str(v.get("bitrate", "5000k")),
                     "-bufsize", str(int(float(str(v.get("bitrate", "5000k")).rstrip('kK')) * 2)) + "k",
                     "-c:a", "aac", "-b:a", str(v.get("audio", "128k")), "-ar", "48000"]
            cmd = ([FFMPEG_BIN, "-y", "-re"] + v_input + v_map + v_cc
                   + codec + _thread_args()
                   + ["-g", "50", "-f", "hls", "-hls_time", "2", "-hls_list_size", "30",
                   "-hls_flags", HLS_CONTINUITY_FLAGS,
                      "-hls_segment_filename", vp,
                      vpl])
            try:
                v_log = _ffmpeg_log_file(channel_id, f"abr_{v['name']}")
                try:
                    v_proc = subprocess.Popen(
                        cmd,
                        stdout=subprocess.DEVNULL,
                        stderr=v_log,
                        creationflags=_popen_flags(),
                    )
                    playout_processes[f"{channel_id}_abr_{v['name']}"] = v_proc
                    hls_procs.append(v_proc)
                finally:
                    v_log.close()
            except Exception as e:
                print(f"[playout] HLS ABR variant start failed ({v['name']}): {e}")
                _notify_mail(channel_id, "WARNING",
                             f"HLS ABR variant start failed ({v['name']}): {e}")

        if hls_procs:
            _write_hls_master(channel_id, abr_variants, vtt_on=spawn_had_vtt)
            print(f"[playout] HLS ABR streaming spawned {len(hls_procs)} renditions for channel {channel_id}")
    except Exception as e:
        print(f"[playout] HLS ABR spawn failed for channel {channel_id}: {e}")
        _notify_mail(channel_id, "WARNING", f"HLS ABR spawn failed: {e}")


def _spawn_hls_abr_test_pattern(channel_id: int, width: int, height: int, fps: int):
    """Spawn the HLS ABR ladder streaming renditions for a test-pattern
    stall, separate from the 480p monitoring process. The test pattern is
    generated (lavfi), so no file source is needed."""
    abr_variants = _get_hls_variants(channel_id)
    if not abr_variants:
        return
    live_dir = _get_live_dir(channel_id)

    hls_procs = []
    monitor_name = _get_monitor_variant_name(channel_id)
    for v in abr_variants:
        if v.get("name") == monitor_name:
            # the monitor rendition is already running as {channel_id}_hls
            continue
        vp = str(live_dir / f"variant_{v['name']}_%05d.ts").replace("\\", "/")
        vpl = str(live_dir / f"variant_{v['name']}.m3u8").replace("\\", "/")
        codec = ["-c:v", "libx264", "-preset", "veryfast", "-tune", "zerolatency",
                 "-s", f"{v['width']}x{v['height']}",
                 "-b:v", str(v.get("bitrate", "5000k")),
                 "-maxrate", str(v.get("bitrate", "5000k")),
                 "-bufsize", str(int(float(str(v.get("bitrate", "5000k")).rstrip('kK')) * 2)) + "k",
                 "-c:a", "aac", "-b:a", str(v.get("audio", "128k")), "-ar", "48000",
                 "-shortest"]
        cmd = ([FFMPEG_BIN, "-y", "-re"]
               + ["-f", "lavfi", "-i", f"testsrc2=size={v['width']}x{v['height']}:rate={fps}",
                  "-f", "lavfi", "-i", "sine=frequency=1000:sample_rate=48000",
                  "-map", "0:v", "-map", "1:a"]
               + codec + _thread_args()
               + ["-g", str(int(fps) * 2), "-f", "hls", "-hls_time", "2", "-hls_list_size", "30",
               "-hls_flags", HLS_CONTINUITY_FLAGS,
                  "-hls_segment_filename", vp,
                  vpl])
        try:
            v_log = _ffmpeg_log_file(channel_id, f"abr_{v['name']}")
            try:
                v_proc = subprocess.Popen(
                    cmd,
                    stdout=subprocess.DEVNULL,
                    stderr=v_log,
                    creationflags=_popen_flags(),
                )
                playout_processes[f"{channel_id}_abr_{v['name']}"] = v_proc
                hls_procs.append(v_proc)
            finally:
                v_log.close()
        except Exception as e:
            print(f"[playout] HLS ABR test pattern start failed ({v['name']}): {e}")

    if hls_procs:
        _write_hls_master(channel_id, abr_variants)
        print(f"[playout] HLS ABR test-pattern spawned {len(hls_procs)} renditions for channel {channel_id}")


def _scrub_hls_endlist(channel_id: int):
    """Remove a trailing #EXT-X-ENDLIST from every HLS ABR media playlist
    (variant_*.m3u8) and the legacy stream.m3u8. ffmpeg writes the trailer
    when the muxer closes (clip transition, respawn), but players treat it
    as 'stream over' and stop polling - during the ~1s until the next muxer
    rewrites the playlist they would all bail out. Stripping the tag keeps
    them waiting for the next segment."""
    try:
        live_dir = _get_live_dir(channel_id)
        candidates = list(live_dir.glob("variant_*.m3u8"))
        candidates.append(live_dir / "stream.m3u8")
        for m3u8 in candidates:
            if not m3u8.is_file():
                continue
            text = m3u8.read_text(encoding="utf-8", errors="replace")
            if "#EXT-X-ENDLIST" not in text:
                continue
            cleaned = "\n".join(
                ln for ln in text.splitlines() if ln.strip() != "#EXT-X-ENDLIST"
            )
            m3u8.write_text(cleaned + ("\n" if cleaned and not cleaned.endswith("\n") else ""),
                            encoding="utf-8")
    except (OSError, PermissionError):
        # the next muxer rewrite or serve request cleans it up instead
        pass


def _ffmpeg_log_file(channel_id: int, tag: str):
    """Per output ffmpeg log file; without it all errors vanish into
    DEVNULL and playback failures stay undiagnosable.

    Bytes are written to the live `ffmpeg_<tag>.log` (surfaced by the
    logger for the current day) and mirrored to a dated file per calendar
    day so the frontend date picker can pull up past logs."""
    log_dir = DATA_DIR / "channel" / str(channel_id) / "logs"
    log_dir.mkdir(parents=True, exist_ok=True)
    live = open(log_dir / f"ffmpeg_{tag}.log", "wb")
    day = datetime.now().strftime("%Y-%m-%d")
    dated = open(log_dir / f"ffmpeg_{tag}_{day}.log", "ab")

    class _Tee:
        """File-like object usable as subprocess stderr/stdout on Windows.

        subprocess.Popen resolves the stream via ``fileno()`` and hands that
        OS handle to the child, so the tee must be backed by a real pipe
        instead of in-process file objects. A daemon pump thread copies the
        child's output into both the live log and the dated mirror."""

        def __init__(self):
            self._read_fd, self._write_fd = os.pipe()
            self._buf = b""
            os.set_inheritable(self._write_fd, True)
            threading.Thread(target=self._pump, daemon=True).start()

        def fileno(self):
            return self._write_fd

        def _pump(self):
            try:
                reader = os.fdopen(self._read_fd, "rb", buffering=0)
            except OSError:
                return
            try:
                while True:
                    try:
                        chunk = reader.read(65536)
                    except OSError:
                        break
                    if not chunk:
                        break
                    self.write(chunk)
            finally:
                try:
                    reader.close()
                except OSError:
                    pass
                self._close_underlying()

        def write(self, b):
            try:
                live.write(b)
                live.flush()
            except OSError:
                pass
            try:
                dated.write(b)
                dated.flush()
            except OSError:
                pass
            try:
                self._buf += b
                while b"\n" in self._buf:
                    ln, self._buf = self._buf.split(b"\n", 1)
                    _capture_ffmpeg_mail_line(channel_id, ln)
                if len(self._buf) > 65536:
                    _capture_ffmpeg_mail_line(channel_id, self._buf)
                    self._buf = b""
            except Exception:
                pass

        def flush(self):
            try:
                live.flush()
            except OSError:
                pass
            try:
                dated.flush()
            except OSError:
                pass

        def close(self):
            try:
                os.close(self._write_fd)
            except OSError:
                pass

        def _close_underlying(self):
            try:
                live.close()
            except OSError:
                pass
            try:
                dated.close()
            except OSError:
                pass

    return _Tee()


def _append_channel_log(channel_id: int, tag: str, line: str):
    """Append an application-level INFO line to the channel's log files so it
    shows up in the frontend logger (live + dated mirror), the same way the
    per-output ffmpeg stderr is teed. The line must carry an uppercase
    severity marker (`[INFO]`, `[WARN]`, ...) for the logger filter."""
    try:
        log_dir = DATA_DIR / "channel" / str(channel_id) / "logs"
        log_dir.mkdir(parents=True, exist_ok=True)
        day = datetime.now().strftime("%Y-%m-%d")
        text = line if line.endswith("\n") else line + "\n"
        with open(log_dir / f"ffmpeg_{tag}.log", "a", encoding="utf-8") as f:
            f.write(text)
        with open(log_dir / f"ffmpeg_{tag}_{day}.log", "a", encoding="utf-8") as f:
            f.write(text)
    except OSError:
        pass

    # feed app-level log lines into the per channel mail notification queue
    _queue_mail_line(channel_id, line)


# === MAIL NOTIFICATIONS ===
#
# Per-channel email notification. Every channel's playout config carries its
# own mail section (subject, recipient, mail_level, interval plus the SMTP
# server credentials). Log lines at/above the configured mail_level are queued
# and flushed periodically every `interval` seconds; explicit channel state
# events (playout start/stop/restart, ingest switch, filler fallback, respawns,
# ...) are queued the same way but trigger a prompt (throttled) send so
# operators are informed without waiting for the next interval flush.

_mail_state: dict[int, dict] = {}
_mail_lock = threading.RLock()
_mail_flush_tasks: set = set()
_mail_cfg_cache: dict[int, tuple] = {}

_MAIL_SEVERITY_RANK = {
    "TRACE": 0, "DEBUG": 1, "INFO": 2, "NOTICE": 2, "VERBOSE": 2,
    "WARNING": 3, "WARN": 3, "ERROR": 4, "FATAL": 4, "PANIC": 4,
}

_MAIL_SEVERITY_RE = re.compile(
    r"\[(TRACE|DEBUG|INFO|NOTICE|VERBOSE|WARNING|WARN|ERROR|FATAL|PANIC)\]",
    re.IGNORECASE,
)


def _mail_severity(line: str) -> str:
    """Severity marker of a log line (`[WARN]`, `[error]`, ...); bare lines
    default to INFO."""
    if line:
        m = _MAIL_SEVERITY_RE.search(line)
        if m:
            return m.group(1).upper()
    return "INFO"


def _mail_interval(cfg: dict) -> int:
    """Normalized mail interval: at least 30 seconds, rounded to tens."""
    try:
        iv = int(float(cfg.get("interval") or 0))
    except (TypeError, ValueError):
        iv = 0
    return max(30, int(round(max(iv, 30) / 10.0)) * 10)


def _get_mail_config(channel_id: int) -> dict | None:
    """Return the collected mail config for a channel, or None when email
    notifications are not usable (no SMTP server / user / recipient).

    Reads the raw stored config (not the web-facing `get_playout_config`,
    which masks the smtp password). A short TTL cache keeps the per-line log
    capture from re-reading the config file on every ffmpeg output line."""
    with _mail_lock:
        cached = _mail_cfg_cache.get(channel_id)
        if cached and time.time() - cached[0] < 2.0:
            return cached[1]
    db = load_db()
    mail = (db.get("playout_configs", {}).get(str(channel_id)) or {}).get("mail") or {}
    if not isinstance(mail, dict):
        mail = {}
    recipients = [
        r.strip() for r in re.split(r"[;,]", str(mail.get("recipient") or ""))
        if "@" in r.strip()
    ]
    usable = None
    if (str(mail.get("smtp_server") or "").strip()
            and str(mail.get("smtp_user") or "").strip()
            and recipients):
        usable = mail
    with _mail_lock:
        _mail_cfg_cache[channel_id] = (time.time(), usable)
    return usable


def _clear_mail_cfg_cache(channel_id: int = None):
    with _mail_lock:
        if channel_id is None:
            _mail_cfg_cache.clear()
        else:
            _mail_cfg_cache.pop(channel_id, None)


def _mail_enabled(channel_id: int) -> bool:
    return _get_mail_config(channel_id) is not None


def _queue_mail_line(channel_id: int, line: str) -> bool:
    """Queue a single log line for the channel's mail notification when its
    severity is at/above the configured mail_level. Returns True when the line
    was accepted into the queue."""
    cfg = _get_mail_config(channel_id)
    if cfg is None:
        return False
    threshold = _MAIL_SEVERITY_RANK.get(
        str(cfg.get("mail_level") or "warning").upper(), 3)
    level = _MAIL_SEVERITY_RANK.get(_mail_severity(line), 2)
    if level < threshold:
        return False
    text = line.rstrip()
    if not text:
        return False
    stamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with _mail_lock:
        st = _mail_state.setdefault(channel_id, {"lines": [], "last_sent": 0.0})
        st["lines"].append(f"[{stamp}] {text}")
    return True


def _capture_ffmpeg_mail_line(channel_id: int, chunk: bytes):
    """Feed raw ffmpeg stderr bytes into the channel mail queue; only complete
    lines at/above the configured level survive the severity filter."""
    try:
        text = chunk.decode("utf-8", errors="replace")
    except Exception:
        return
    for ln in text.splitlines():
        _queue_mail_line(channel_id, ln)


def _smtp_send(cfg: dict, subject: str, body: str,
               recipients: list[str]) -> tuple[bool, str]:
    import smtplib
    from email.mime.text import MIMEText
    from email.utils import formatdate

    host = str(cfg.get("smtp_server") or "").strip()
    if not host:
        return False, "no SMTP server configured"
    try:
        port = int(cfg.get("smtp_port") or 465)
    except (TypeError, ValueError):
        port = 465
    user = str(cfg.get("smtp_user") or "")
    password = str(cfg.get("smtp_password") or "")

    msg = MIMEText(body, "plain", "utf-8")
    msg["Subject"] = subject or "ffplayout notification"
    msg["From"] = user
    msg["To"] = ", ".join(recipients)
    msg["Date"] = formatdate(localtime=True)

    try:
        if cfg.get("smtp_starttls"):
            # STARTTLS (usually the 587 submission port)
            server = smtplib.SMTP(host, port, timeout=15)
            server.ehlo()
            server.starttls()
            server.ehlo()
        else:
            # implicit TLS (usually 465); fall back to a plain connection
            try:
                server = smtplib.SMTP_SSL(host, port, timeout=15)
            except Exception:
                server = smtplib.SMTP(host, port, timeout=15)
                server.ehlo()
        try:
            if user and password:
                server.login(user, password)
            server.sendmail(user, recipients, msg.as_string())
        finally:
            try:
                server.quit()
            except Exception:
                pass
        return True, ""
    except Exception as e:
        return False, str(e)


def _flush_mail(channel_id: int) -> tuple[bool, str]:
    """Send the queued lines of a channel in one email. Blocks (SMTP), so call
    it from a worker thread. The queue is cleared even when the send fails so
    an unreachable server cannot grow an endless queue."""
    with _mail_lock:
        st = _mail_state.get(channel_id)
        if not st or not st.get("lines"):
            return False, "no queued mail"
        lines = st["lines"]
        st["lines"] = []
        st["last_sent"] = time.time()

    cfg = _get_mail_config(channel_id)
    if not cfg:
        return False, "no mail configured"

    recipients = [
        r.strip() for r in re.split(r"[;,]", str(cfg.get("recipient") or ""))
        if "@" in r.strip()
    ]
    if not recipients:
        return False, "no valid recipient configured"

    subject = str(cfg.get("subject") or "").strip()
    if not subject:
        subject = f"ffplayout channel {channel_id} notification"
    body = (
        f"channel {channel_id}\n"
        f"time: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n\n"
        + "\n".join(lines) + "\n"
    )
    ok, err = _smtp_send(cfg, subject, body, recipients)
    if not ok:
        print(f"[mail] channel {channel_id}: failed to send mail: {err}")
    return ok, err


def _notify_mail(channel_id: int, level: str, message: str):
    """Queue an explicit channel state event at the given level and send it
    promptly (throttled to the configured interval)."""
    cfg = _get_mail_config(channel_id)
    if cfg is None:
        return
    if not _queue_mail_line(channel_id, f"[{level.upper()}] {message}"):
        return
    window = _mail_interval(cfg)
    with _mail_lock:
        st = _mail_state[channel_id]
        if time.time() - st.get("last_sent", 0.0) < window:
            return  # bundled with the next periodic flush
    threading.Thread(target=_flush_mail, args=(channel_id,), daemon=True).start()


async def _mail_flush_loop():
    """Periodic mail flusher: every 10s send the accumulated lines of every
    channel whose configured interval elapsed since its last send."""
    while True:
        await asyncio.sleep(10)
        now = time.time()
        db = load_db()
        ch_ids = [c.get("id") for c in db.get("channels", [])]
        for ch_id in set(list(ch_ids) + list(_mail_state.keys())):
            if ch_id is None:
                continue
            with _mail_lock:
                st = _mail_state.get(ch_id)
                if not st or not st.get("lines"):
                    continue
                cfg = _get_mail_config(ch_id)
                if cfg is None:
                    continue
                if now - st.get("last_sent", 0.0) < _mail_interval(cfg):
                    continue
            await asyncio.to_thread(_flush_mail, ch_id)


UDP_OUTPUT = "udp://127.0.0.1:9001?pkt_size=1316"


def _get_playout_config(channel_id: int) -> dict:
    db = load_db()
    key = str(channel_id)
    pcfg = db.get("playout_configs", {}).get(key, {})
    if not pcfg:
        for ch in db.get("channels", []):
            if ch.get("id") == channel_id:
                pcfg = ch.get("playout", {})
                break
    return pcfg


def _get_output_params(channel_id: int) -> tuple[list[str], str]:
    pcfg = _get_playout_config(channel_id)
    fallback_params = ["-c:v", "libx264", "-preset", "veryfast", "-tune", "zerolatency",
                       "-c:a", "aac", "-b:a", "128k", "-ar", "48000"]
    fallback_dest = UDP_OUTPUT

    output_param = pcfg.get("output", {}).get("output_param", "")
    if not output_param:
        return fallback_params, fallback_dest

    parts = shlex.split(output_param)
    codec_params = []
    dest = fallback_dest
    i = 0
    while i < len(parts):
        if parts[i] in ("-f",) and i + 1 < len(parts):
            fmt = parts[i + 1]
            if i + 2 < len(parts):
                dest = parts[i + 2]
                i += 3
            else:
                i += 2
        elif parts[i] in ("-s", "-size"):
            # skip the -s / -size flag and its value: the processing
            # pipeline already scales/pads to the configured width x height
            i += 2
        elif parts[i].startswith("-s") and "x" in parts[i]:
            # skip combined form like -s1920x1080
            i += 1
        elif parts[i] in ("-c:v", "-c:a", "-b:v", "-b:a", "-ar", "-preset", "-tune"):
            codec_params.append(parts[i])
            if i + 1 < len(parts):
                codec_params.append(parts[i + 1])
                i += 2
            else:
                i += 1
        else:
            i += 1

    # explicit video/audio quality settings from the web ui win over the
    # output_param flags: they are appended last so ffmpeg takes them
    q = pcfg.get("quality") or {}
    preset = str(q.get("x264_preset") or "").strip()
    v_bitrate = str(q.get("video_bitrate") or "").strip()
    crf = q.get("crf")
    a_bitrate = str(q.get("audio_bitrate") or "").strip()
    sample_rate = q.get("sample_rate")
    if codec_params:
        if preset:
            codec_params += ["-preset", preset]
        if v_bitrate:
            codec_params += ["-b:v", v_bitrate]
            maxrate = str(q.get("maxrate") or "").strip()
            bufsize = str(q.get("bufsize") or "").strip()
            if maxrate:
                codec_params += ["-maxrate", maxrate]
            if bufsize:
                codec_params += ["-bufsize", bufsize]
        elif crf is not None and str(crf).strip() != "":
            try:
                codec_params += ["-crf", str(max(0, min(51, int(crf))))]
            except (TypeError, ValueError):
                pass
        if a_bitrate:
            codec_params += ["-b:a", a_bitrate]
        if sample_rate:
            try:
                codec_params += ["-ar", str(int(sample_rate))]
            except (TypeError, ValueError):
                pass

    return codec_params or fallback_params, dest


LOGO_POSITIONS = {
    "top left": "20:20",
    "top right": "W-w-20:20",
    "bottom left": "20:H-h-20",
    "bottom right": "W-w-20:H-h-20",
}


def _normalize_logo_position(value) -> str:
    """Accept named corners ('top right', 'top_right', ...) or raw overlay
    expressions ('overlay=W-w-20:20') and return a bare x:y expression."""
    if not isinstance(value, str) or not value.strip():
        return LOGO_POSITIONS["top right"]
    v = value.strip()
    if v.lower().startswith("overlay="):
        v = v[len("overlay="):]
    key = v.lower().replace("_", " ").replace("-", " ")
    return LOGO_POSITIONS.get(key, v)


def _resolve_logo_path(channel_id: int, logo: str) -> str:
    """Resolve a configured logo path to an existing file on disk.

    Accepts an absolute path, a storage-relative path (e.g.
    ``media/process/logo/foo.mov``) or a web-style path prefixed with ``/``.
    Returns the POSIX-style absolute path if the file exists, else ""."""
    if not logo:
        return ""
    storage = _get_channel_storage(channel_id)
    cand = logo.strip().lstrip("/\\")
    p = Path(logo)
    if not os.path.isabs(logo) and not p.is_absolute():
        p = storage / cand
    elif p.is_absolute():
        p = Path(logo)
    else:
        p = storage / cand
    try:
        if p.is_file():
            return str(p).replace("\\", "/")
    except OSError:
        pass
    return ""


# "Original Size" in the Logo Scale dropdown normalises the logo file's height
# to the base frame width, which is only correct for a logo authored as a
# full-frame overlay. Anything narrower than the frame gets scaled up by the
# same factor and can swallow the picture. Cap the result at this fraction of
# the frame height so a plain logo asset always renders as a logo.
_LOGO_MAX_FRAME_FRACTION = 0.22


def _normalise_logo_scale(logo_scale: str) -> str:
    """Validate a logo scale and return it as ``W:H``, or "" if unusable.

    ``logo_scale`` comes straight from the playout configuration and is
    interpolated into the ffmpeg graph as ``scale=W:H``. A malformed value
    ("320:", ":180", "-1:abc", "abc") would otherwise build a filter ffmpeg
    rejects, which takes the whole playout process down with it. Anything
    unusable is dropped so the logo simply renders unscaled instead of
    killing the channel.

    A negative width is legitimate: ``-1`` tells the scale filter to derive
    the width from the height (which is what the Small/Medium/Large presets
    use). The height must stay a real positive pixel count because it drives
    the per-rendition logo sizing.
    """
    if not logo_scale:
        return ""
    parts = str(logo_scale).strip().split(":")
    if len(parts) != 2:
        return ""
    try:
        w = float(parts[0])
        h = float(parts[1])
    except ValueError:
        return ""
    if w != w or h != h:  # NaN
        return ""
    # width: positive size, or a negative integer ffmpeg flag such as -1
    if not ((w > 0) or (w < 0 and w.is_integer())):
        return ""
    if h <= 0:
        return ""
    return f"{parts[0].strip()}:{parts[1].strip()}"


def _logo_base_height(channel_id: int, logo: str, logo_scale: str, base_width: int) -> float:
    """Display height in px of the logo at the base/production resolution.

    When ``logo_scale`` provides a height (``-1:54`` or ``W:H``) that height is
    used directly. Without an explicit scale ("Original Size" in the UI) the
    logo keeps its native resolution, which we normalise to the base frame width
    by scaling from the file's own dimensions."""
    if logo_scale:
        logo_scale = _normalise_logo_scale(logo_scale)
        parts = logo_scale.split(":") if logo_scale else []
        if len(parts) == 2:
            try:
                return float(parts[1])
            except ValueError:
                pass
    p = _resolve_logo_path(channel_id, logo)
    if not p:
        return 0.0
    try:
        probe = subprocess.run(
            [FFPROBE_BIN, "-v", "error",
             "-select_streams", "v:0",
             "-show_entries", "stream=width,height",
             "-of", "json", p],
            capture_output=True, text=True, timeout=30,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
        import json as _json
        info = _json.loads(probe.stdout or "{}")
        st = (info.get("streams") or [{}])[0]
        w = st.get("width") or 0
        h = st.get("height") or 0
        if w and h and base_width:
            native = h * base_width / w
            # Normalising to the base frame width only makes sense for a logo
            # authored as a full-frame overlay. A logo that is just the logo
            # (e.g. 320x172) would be blown up to ~1030 px and swallow the
            # picture, so cap "Original Size" at a sane logo-bug height.
            cap = base_width * _LOGO_MAX_FRAME_FRACTION
            if native > cap:
                print(f"[logo] {os.path.basename(p)} is {w}x{h}; 'Original Size'"
                      f" would render it {int(native)} px tall at base width"
                      f" {base_width}, capping to {int(cap)} px. Set an explicit"
                      f" logo_scale (e.g. -1:108) to choose the size.")
                return cap
            return native
    except Exception:
        pass
    return 0.0


def _variant_logo_filters(logo_filters, base_height, base_width, variant_width) -> list:
    """Rescale the logo overlay filters so the logo keeps the same fraction of
    the frame in an ABR rendition as it does at the base resolution.

    When no explicit ``scale=`` filter exists (native-size logo), one is added
    so the logo never overflows/clips the smaller variant frame.

    A leading downscale cap is prepended so the decoded (often full-resolution,
    e.g. ProRes 4444) logo frames are reduced to a small working size *before*
    the rgba/colorchannelmixer conversion and the overlay. This keeps the
    per-frame pixel work of a low-res 480p monitor rendition cheap, so it can
    keep up at realtime without lag."""
    if not logo_filters or base_height <= 0 or base_width <= 0:
        return logo_filters
    factor = variant_width / base_width
    new_h = max(1, int(round(base_height * factor)))
    # Cap the logo to ~4x the final display height before any conversion, so
    # the exact final scale afterwards is a tiny, fast resize.
    #
    # The cap must never UPSCALE. For the 480p monitor rendition new_h is 721,
    # so new_h * 4 is 2884 - larger than the 1080p logo source - and the
    # "cap" turned into a ~5125x2888 rgba frame on every single frame. That
    # one filter held the monitor rendition to 0.58x on its own (measured:
    # scale=-1:2884 -> rgba -> scale=-1:721 = 14fps, versus 25fps without the
    # intermediate). Ceiling the cap at the base rendition height keeps the
    # shrink semantics and makes it a no-op when there is nothing to shrink.
    cap_h = max(2, min(new_h * 4, base_height))
    out = []
    has_scale = False
    for f in logo_filters:
        if f.startswith("scale="):
            has_scale = True
            out.append(f"scale=-1:{new_h}")
        else:
            out.append(f)
    if not has_scale:
        out.append(f"scale=-1:{new_h}")
    # prepend the cheap downscale *first* so downstream rgba/overlay run at
    # low resolution; use force_original_aspect_ratio to avoid distortion
    if cap_h < base_height:
        out.insert(0, f"scale=-1:{cap_h}:force_original_aspect_ratio=decrease")
    return out


def _advanced_filter_chain(channel_id: int, width: int, height: int, fps: float, duration: float) -> tuple:
    """Return (pre_filters, video_post_filters, audio_filters) derived from the
    channel's active advanced config.

    The advanced config (decoder/encoder/filter) is the raw ffmpeg filter
    chain equivalent of the processing section. The base processing chain in
    `_build_processing_args` already owns fps/scale/pad/setsar and the logo
    overlay, so this only applies the *additional* filter fields that have no
    counterpart there: fade in/out, tpad, drawtext sources, audio fades/pad,
    volume and split. `{}` placeholders are filled from the production
    geometry, and `{language}` from the channel locale."""
    pcfg = _get_playout_config(channel_id) or {}
    db = load_db()
    key = str(channel_id)
    cfg = db.get("advanced_configs", {}).get(key)
    if isinstance(cfg, list):
        cfg = cfg[0] if cfg else None
    if not isinstance(cfg, dict):
        return ([], [], [])
    flt = cfg.get("filter") or {}

    lang = (pcfg.get("general") or {}).get("pref_language", "en") or "en"

    def sub(s: str) -> str:
        s = s.replace("{}", f"{width}:{height}")
        s = s.replace("{language}", lang)
        return s

    pre, vpost, afilt = [], [], []

    if flt.get("deinterlace"):
        pre.append(sub(flt["deinterlace"]))

    for field in ("fade_in", "fade_out", "tpad", "drawtext_from_file", "drawtext_from_zmq"):
        v = flt.get(field)
        if v:
            vpost.append(sub(v))

    for field in ("afade_in", "afade_out", "apad", "volume"):
        v = flt.get(field)
        if v:
            afilt.append(sub(v))

    if flt.get("split"):
        # split needs the stream index handled by the caller; emit as video post
        vpost.append(sub(flt["split"]))

    return pre, vpost, afilt


def _build_processing_args(channel_id: int) -> dict:
    """Build processing args. Returns dict with keys: v_pre, v_post, a_filters, logo_filters, logo_position, has_overlay."""
    pcfg = _get_playout_config(channel_id)
    proc = pcfg.get("processing", {})

    width = proc.get("width", 1920)
    height = proc.get("height", 1080)
    fps = proc.get("fps", 25)
    copy_audio = proc.get("copy_audio", True)
    copy_video = proc.get("copy_video", False)
    audio_only = proc.get("audio_only", False)
    audio_channels = proc.get("audio_channels", 2)
    volume = proc.get("volume", 1.0)
    add_logo = proc.get("add_logo", False)
    logo = proc.get("logo", "")
    logo_scale = proc.get("logo_scale", "")
    logo_opacity = proc.get("logo_opacity", 0.0)
    logo_position = _normalize_logo_position(proc.get("logo_position", "W-w-20:20"))
    add_text = proc.get("add_text", False)
    text_style = proc.get("style", "")
    font = proc.get("font", "")
    # text settings live in their own config section, fall back to it
    if not any([add_text, text_style, font]):
        text_cfg = pcfg.get("text", {})
        add_text = text_cfg.get("add_text", False)
        text_style = text_cfg.get("style", "")
        font = text_cfg.get("font", "")
    override_filter = proc.get("override_filter", False)
    custom_filter = proc.get("custom_filter", "")

    result = {"v_pre": [], "v_post": [], "a_filters": [], "logo_filters": [], "logo_position": logo_position, "has_overlay": False}

    if override_filter and custom_filter:
        try:
            parts = shlex.split(custom_filter)
            result["v_pre"] = parts
            return result
        except Exception:
            pass

    v_pre = []
    v_post = []
    a_filters = []
    logo_filters = []
    has_overlay = False

    if not audio_only and not copy_video:
        v_pre.append(f"fps={fps}")
        v_pre.append(f"scale={width}:{height}:force_original_aspect_ratio=decrease")
        v_pre.append(f"pad={width}:{height}:(ow-iw)/2:(oh-ih)/2")
        v_pre.append(f"setsar=1")

    if add_logo and logo:
        logo_path = _resolve_logo_path(channel_id, logo)
        if logo_path:
            has_overlay = True
            if logo_opacity > 0:
                logo_filters.append(f"format=rgba,colorchannelmixer=aa={logo_opacity}")
            if logo_scale:
                logo_scale = _normalise_logo_scale(logo_scale)
            if logo_scale:
                logo_parts = logo_scale.split(":")
                if len(logo_parts) == 2:
                    logo_filters.append(f"scale={logo_parts[0]}:{logo_parts[1]}")

    if not copy_audio:
        a_filters.append(f"pan={audio_channels}|c0=c0|c1=c1")
    if volume != 1.0:
        a_filters.append(f"volume={volume}")

    if add_text and text_style and not audio_only:
        drawtext = text_style
        if font:
            font_path = str(_get_channel_storage(channel_id) / font).replace("\\", "/")
            if os.path.isfile(font_path):
                drawtext = f"fontfile='{font_path}':{drawtext}"
        v_post.append(f"drawtext={drawtext}")

    if custom_filter and not override_filter:
        if "[c_v_out]" in custom_filter or "[c_a_out]" in custom_filter:
            try:
                parts = shlex.split(custom_filter)
                result["v_pre"] = parts
                return result
            except Exception:
                pass
        else:
            for f in custom_filter.split(";"):
                f = f.strip()
                if not f:
                    continue
                if "drawtext" in f or "scale" in f or "overlay" in f or "fps" in f:
                    v_post.append(f)
                else:
                    a_filters.append(f)

    result["v_pre"] = v_pre
    result["v_post"] = v_post
    result["a_filters"] = a_filters
    result["logo_filters"] = logo_filters
    result["has_overlay"] = has_overlay
    return result


_SUBTITLE_EXTS = (".srt", ".stl", ".pac")


def _find_sidecar_subtitle(channel_id: int, source: str) -> str:
    """Find a matching subtitle for a clip: next to the video, or in the
    channel subtitles folder (same basename). Supports .srt (SubRip),
    .stl (EBU STL / Spruce) and .pac (winCAPS PAC) files, searching the
    extensions in priority order."""
    src = Path(source)
    for ext in _SUBTITLE_EXTS:
        candidates = [
            src.with_suffix(ext),
            _get_channel_storage(channel_id) / "subtitles" / f"{src.stem}{ext}",
        ]
        for c in candidates:
            try:
                if c.is_file():
                    return str(c)
            except OSError:
                continue
    return ""


def _escape_filter_path(p: str) -> str:
    return p.replace("\\", "/").replace(":", r"\:").replace("'", r"\'")


def _escape_sub_filter_path(p: str) -> str:
    """Escape a path for the `subtitles` filter's filename/fontsdir options.

    The libass `subtitles` filter parses its option list by splitting on the
    first colon of each ``key=value`` pair, but only when that colon is escaped
    by *two* backslashes (``\\\\:``). A single ``\\:`` (which works inside the
    single-quoted drawtext ``fontfile=``) is not honored here, so an absolute
    Windows path like ``C:/Users/...`` would split at ``C:`` and fail with
    "No option name near '...'". This is macOS/Linux-agnostic too: it only
    rewrites the separator and keeps forward slashes for the rest.
    """
    return p.replace("\\", "/").replace(":", r"\\:")


# === SECONDARY EVENTS (timed graphics overlays) ===


def _parse_timecode(tc: str, fps: float = 25.0) -> float:
    """HH:MM:SS:FF broadcast timecode -> seconds."""
    parts = str(tc).strip().split(":")
    if len(parts) != 4:
        return 0.0
    try:
        h, m, s, f = (int(p) if p else 0 for p in parts)
    except ValueError:
        return 0.0
    return h * 3600 + m * 60 + s + f / float(fps or 25.0)


_SE_STYLE_DEFAULTS = {
    # NNL template defaults: movie name sits top-left like the reference
    # NOW/NEXT/LATER renders, with a fade in/out per base animation loop
    "now": {"fontsize": 72, "x": 60, "y": 150, "boxcolor": "black@0.65", "boxborderw": 16},
    "next": {"fontsize": 72, "x": 60, "y": 150, "boxcolor": "black@0.55", "boxborderw": 14},
    "later": {"fontsize": 68, "x": 60, "y": 148, "boxcolor": "black@0.45", "boxborderw": 12},
    # NNL channel bug: positioned via the configurable corner selector
    "nnl": {"fontsize": 28, "position": "top right", "boxcolor": "black@0.50", "boxborderw": 10},
    # Current-Movie: the render is a full-width banner across the bottom of the
    # frame, so the title belongs at the left edge of that band. Without its
    # own entry this key fell through to "_default" below, which centres the
    # name on the bottom line and put "Deva" in the middle of the frame.
    "currentmovie": {"fontsize": 40, "position": "bottom left",
                     "boxcolor": "black@0.60", "boxborderw": 14},
    # aston-style lower third / clip-info banners and any custom name
    "_default": {"fontsize": 34, "x": "(w-text_w)/2", "y": "h-72", "boxcolor": "black@0.60", "boxborderw": 12},
}

# named corners -> ffmpeg drawtext x/y expressions ({m} = scaled margin);
# text aware, so every corner keeps a symmetric padding like the logo does
_SE_POSITIONS = {
    "top left": ("{m}", "{m}"),
    "top centre": ("(w-text_w)/2", "{m}"),
    "top right": ("w-text_w-{m}", "{m}"),
    "bottom left": ("{m}", "h-text_h-{m}"),
    "bottom centre": ("(w-text_w)/2", "h-text_h-{m}"),
    "bottom right": ("w-text_w-{m}", "h-text_h-{m}"),
}


def _se_position_xy(position: str, margin: int):
    """Map a corner name ('top right', 'top_right', ...) to x/y expressions."""
    key = str(position or "").strip().lower().replace("_", " ").replace("-", " ")
    xy = _SE_POSITIONS.get(key)
    if not xy:
        return None
    return tuple(p.format(m=margin) for p in xy)


def _resolve_ttf_font(preferred: str | None = None,
                      bold: bool = False) -> str:
    """Return a usable TTF path for drawtext on this platform.

    The advanced-settings default was ``C:\\Windows\\Fonts\\arial.ttf``, which
    simply does not exist on Linux; ffmpeg's drawtext then aborts the whole
    filter graph ("Could not load font"), taking the subtitle/NNL overlay and
    every downstream rendition with it. Prefer an explicit font, then the
    channel's bundled text font, then any installed metric-compatible
    substitute. Returns "" when nothing usable is found so callers can skip
    the drawtext instead of crashing ffmpeg.
    """
    candidates = []
    if preferred:
        candidates.append(str(preferred))
    windir = os.environ.get("WINDIR") or ""
    if os.name == "nt":
        candidates.append(os.path.join(windir or r"C:\Windows", "Fonts",
                                       "arialbd.ttf" if bold else "arial.ttf"))
    # fonts shipped with the channel (the migration put DejaVuSans.ttf there)
    for cid in (1, 2):
        try:
            td = _get_channel_storage(cid) / "text"
            candidates += [str(td / "DejaVuSans-Bold.ttf" if bold
                               else "DejaVuSans.ttf"),
                           str(td / "DejaVuSans.ttf")]
        except Exception:
            pass
    for n in (("DejaVuSans-Bold.ttf" if bold else "DejaVuSans.ttf"),
              "LiberationSans-Bold.ttf" if bold else "LiberationSans-Regular.ttf",
              "NotoSans-Regular.ttf"):
        candidates += [f"/usr/share/fonts/truetype/dejavu/{n}",
                       f"/usr/share/fonts/truetype/liberation/{n}",
                       f"/usr/share/fonts/truetype/noto/{n}"]
    if bold:
        candidates.append("/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf")
        candidates.append("/usr/share/fonts/truetype/noto/NotoSansDevanagari-Regular.ttf")
    candidates.append("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf")
    candidates.append("/usr/share/fonts/truetype/noto/NotoSansDevanagari-Regular.ttf")

    seen = set()
    for c in candidates:
        if not c or c in seen:
            continue
        seen.add(c)
        try:
            if os.path.isfile(c):
                return c
        except OSError:
            continue
    return ""


def _get_se_config(channel_id: int):
    pcfg = _get_playout_config(channel_id)
    cfg = pcfg.get("secondary_events")
    if not isinstance(cfg, dict):
        cfg = {}
    enable = cfg.get("enable", True)
    fontfile = _resolve_ttf_font(cfg.get("fontfile"))
    styles = cfg.get("styles") if isinstance(cfg.get("styles"), dict) else {}
    return bool(enable), str(fontfile), styles


def _resolve_graphic_overlay(channel_id: int, rel: str) -> str:
    """Resolve a graphic overlay source to the actual overlay file.

    Accepts either the processed MOV directly (as stored in the configured
    ``graphic``) or a source zip archive (the ``graphic_source`` of a media
    library asset). For a zip, the processed alpha MOV is used instead.
    Returns "" when nothing usable exists."""
    rel = (rel or "").strip().lstrip("/\\")
    if not rel:
        return ""
    path = _resolve_logo_path(channel_id, rel)
    if not path:
        return ""
    if path.lower().endswith(".zip"):
        for target in (
            _animated_graphic_target(channel_id, path),
            _animated_logo_target(channel_id, path),
        ):
            try:
                if target and target.is_file():
                    return str(target).replace("\\", "/")
            except OSError:
                continue
        return ""
    return path


def _load_squeeze_info(graphic_path: str):
    """Return the alpha "video hole" rectangle of an L-band-style full-frame
    graphic, read from the sidecar next to the processed MOV
    (``<mov>.squeeze.json``). Returns None when absent/invalid.

    The rect is stored in the MOV's native pixel coordinates together with the
    native frame size so it can be mapped to any render resolution: when such a
    graphic is on air the main video is scaled into that rectangle and the
    full-frame graphic is overlaid on top, exposing the video through its
    transparent cut-out."""
    import json as _json

    if not graphic_path:
        return None
    sidecar = f"{graphic_path}.squeeze.json"
    try:
        with open(sidecar, "r", encoding="utf-8") as f:
            data = _json.load(f)
        fw = int(data.get("frame_width") or 0)
        fh = int(data.get("frame_height") or 0)
        x = int(data.get("x") or 0)
        y = int(data.get("y") or 0)
        w = int(data.get("w") or 0)
        h = int(data.get("h") or 0)
        if fw > 0 and fh > 0 and w > 0 and h > 0:
            return {
                "frame_width": fw, "frame_height": fh,
                "x": x, "y": y, "w": w, "h": h,
            }
    except (OSError, ValueError, TypeError):
        return None
    return None


def _squeeze_fade_duration(channel_id: int) -> float:
    """Seconds of the smooth L-band squeeze transition (in and out). Read from
    ``processing.squeeze_fade`` when set, clamped to a sane window."""
    proc = _get_playout_config(channel_id).get("processing") or {}
    try:
        d = float(proc.get("squeeze_fade") or _SQUEEZE_FADE_DEFAULT)
    except (TypeError, ValueError):
        d = _SQUEEZE_FADE_DEFAULT
    return min(max(d, 0.2), 5.0)


def _is_squeeze_graphic(channel_id: int, graphic_rel: str) -> bool:
    """True when ``graphic_rel`` resolves to an L-band-style full-frame graphic
    (one carrying a ``.squeeze.json`` sidecar next to its processed MOV)."""
    rel = (graphic_rel or "").strip().lstrip("/\\")
    if not rel:
        return False
    path = _resolve_graphic_overlay(channel_id, rel)
    return bool(path) and _load_squeeze_info(path) is not None


def _squeeze_fade_state(channel_id: int) -> tuple:
    """Return the L-band squeeze render state ``(phase, progress, fade_dur)``.

    ``phase`` is ``"in"`` (entering the squeeze), ``"out"`` (leaving it) or
    ``"on"`` (steady L-band, no animation). ``progress`` (0..1) is the fraction
    of the transition already elapsed when this graph is built, so a graph
    rebuilt in the middle of a transition (clip boundary, ABR respawn) keeps
    animating from the current position instead of snapping back to the start.
    """
    runtime = _graphic_runtime.get(channel_id, {})
    phase = runtime.get("sq_phase")
    if phase not in ("in", "out"):
        return "on", 0.0, 0.0
    fade_dur = _squeeze_fade_duration(channel_id)
    epoch = runtime.get("sq_epoch")
    if epoch is None:
        # First filter build for this transition.  Anchor to wall-clock time
        # but compensate for the typical respawn latency (~0.5 s) so the
        # visible animation starts close to frame 0 instead of jumping ahead.
        runtime["sq_epoch"] = time.time()
        runtime["sq_render_lag"] = 0.0
        return phase, 0.0, fade_dur
    elapsed = time.time() - epoch
    lag = runtime.get("sq_render_lag", 0.0)
    p = max(0.0, min((elapsed - lag) / fade_dur, 1.0))
    return phase, p, fade_dur


def _cancel_sq_timer(runtime: dict):
    """Cancel any pending squeeze transition bookkeeping task."""
    timer = runtime.get("sq_timer")
    if timer is not None:
        try:
            timer.cancel()
        except Exception:
            pass
    runtime["sq_timer"] = None


def _cancel_bug_timer(runtime: dict):
    """Cancel any pending non-squeeze bug fade bookkeeping task."""
    timer = runtime.get("bug_timer")
    if timer is not None:
        try:
            timer.cancel()
        except Exception:
            pass
    runtime["bug_timer"] = None


def _begin_bug_exit(channel_id: int):
    """Start a smooth fade-out for a non-squeeze bug graphic: keep the bug in
    the filter graph one more transition window while its alpha animates to
    zero, then drop it and restart the clip without it."""
    runtime = _graphic_runtime.setdefault(channel_id, {})
    rel = str(runtime.get("graphic_rel") or "").strip()
    if not rel:
        cfg = _get_playout_config(channel_id).get("secondary_events")
        if isinstance(cfg, dict):
            rel = str(cfg.get("graphic") or "").strip()
    if _is_squeeze_graphic(channel_id, rel):
        return
    fade_dur = _squeeze_fade_duration(channel_id)
    _cancel_bug_timer(runtime)
    runtime["bug_phase"] = "out"
    runtime.pop("bug_epoch", None)

    async def _bug_drop():
        respawn_margin = max(2.0, runtime.get("sq_last_respawn_time", 1.0) + 1.0)
        try:
            await asyncio.sleep(fade_dur + respawn_margin)
        except asyncio.CancelledError:
            return
        r = _graphic_runtime.get(channel_id, {})
        if r.get("bug_phase") != "out":
            return
        r["bug_phase"] = "off"
        r.pop("bug_epoch", None)
        r["bug_timer"] = None
        _restart_current_clip(channel_id)

    task = asyncio.get_event_loop().create_task(_bug_drop())
    runtime["bug_timer"] = task


def _begin_squeeze_exit(channel_id: int):
    """Start the smooth L-band fade-out: keep the squeeze composite alive for
    one more transition window with a reversed animation (video scales back to
    full resolution while the graphic fades out), then drop the graphic and
    restart the clip without it."""
    runtime = _graphic_runtime.setdefault(channel_id, {})
    rel = str(runtime.get("graphic_rel") or "").strip()
    if not rel:
        cfg = _get_playout_config(channel_id).get("secondary_events")
        if isinstance(cfg, dict):
            rel = str(cfg.get("graphic") or "").strip()
    if not _is_squeeze_graphic(channel_id, rel):
        return
    fade_dur = _squeeze_fade_duration(channel_id)
    _cancel_sq_timer(runtime)
    runtime["sq_phase"] = "out"
    runtime.pop("sq_epoch", None)
    runtime.pop("sq_render_lag", None)

    async def _drop():
        # Wait for the full animation plus a generous safety margin to
        # account for process respawn latency.  The margin is based on the
        # observed respawn time (if available) plus a fixed buffer.
        respawn_margin = max(2.0, runtime.get("sq_last_respawn_time", 1.0) + 1.0)
        try:
            await asyncio.sleep(fade_dur + respawn_margin)
        except asyncio.CancelledError:
            return
        r = _graphic_runtime.get(channel_id, {})
        if r.get("sq_phase") != "out":
            return
        r["sq_phase"] = "off"
        r.pop("sq_epoch", None)
        r.pop("sq_render_lag", None)
        r["sq_timer"] = None
        _restart_current_clip(channel_id)

    task = asyncio.get_event_loop().create_task(_drop())
    runtime["sq_timer"] = task


def _graphic_overlay_config(channel_id: int) -> tuple:
    """Read the graphic-overlay (channel bug) config.

    Returns ``(enabled, abs_mov_path, position, scale_pct, fade_expr)``.
    Position is a bare x:y overlay expression (corner names are normalized);
    scale_pct is a percentage relative to the base render width. Returns an
    disabled tuple when nothing is configured.

    ``fade_expr`` is an appended ffmpeg ``fade`` filter (``fade=t=in/out:alpha=1``)
    used to fade the bug in/or out smoothly when the runtime state has an
    active ``bug_phase`` of ``"in"``/``"out"``; ``None`` when the graphic
    should render at full alpha (steady on).

    The ``graphic_enable`` flag comes from the persistent ``secondary_events``
    settings, unless the Player "Enable graphics with duration" runtime control
    has actively turned it on/off for this channel (which takes precedence).
    The Player may also select a specific graphic to show (runtime override of
    ``graphic``), which wins over the configured graphic file.
    """
    pcfg = _get_playout_config(channel_id)
    cfg = pcfg.get("secondary_events")
    if not isinstance(cfg, dict):
        cfg = {}

    runtime = _graphic_runtime.get(channel_id, {})
    if runtime.get("enabled") is not None:
        enabled = bool(runtime.get("enabled"))
    else:
        enabled = bool(cfg.get("graphic_enable", False))

    # During a smooth L-band fade-out the graphic was already logically
    # switched off (enabled=False), but the squeeze composite must stay in the
    # filter graph a little longer so the video can animate back to full
    # resolution and the graphic can fade out gracefully. (When no graphic is
    # configured at all the path resolution below already returns disabled.)
    if runtime.get("sq_phase") == "out":
        enabled = True
    # Same for the non-squeeze bug: keep it in the filter graph while the
    # alpha fades out.
    if runtime.get("bug_phase") == "out":
        enabled = True

    if not enabled:
        return False, "", "", 100, None

    runtime_rel = str(runtime.get("graphic_rel") or "").strip()
    rel = runtime_rel or str(cfg.get("graphic") or "").strip()
    if not rel:
        return False, "", "", 100, None
    path = _resolve_graphic_overlay(channel_id, rel)
    if not path:
        return False, "", "", 100, None
    try:
        scale_pct = float(cfg.get("graphic_scale", 100) or 100)
    except (TypeError, ValueError):
        scale_pct = 100.0
    scale_pct = min(max(scale_pct, 1.0), 400.0)
    pos = _normalize_logo_position(str(cfg.get("graphic_position") or "bottom right"))

    fade_expr = None
    bug_phase = runtime.get("bug_phase")
    if bug_phase in ("in", "out"):
        fade_dur = _squeeze_fade_duration(channel_id)
        epoch = runtime.get("bug_epoch")
        if epoch is None:
            runtime["bug_epoch"] = time.time()
            runtime["sq_render_lag"] = 0.0
            p0 = 0.0
        else:
            elapsed = time.time() - epoch
            lag = runtime.get("sq_render_lag", 0.0)
            p0 = max(0.0, min((elapsed - lag) / fade_dur, 1.0))
        fade_type = "in" if bug_phase == "in" else "out"
        fade_expr = (
            f",fade=t={fade_type}:st=0:d={max(fade_dur * (1 - p0), 0.05):.3f}:alpha=1"
        )

    return True, path, pos, scale_pct, fade_expr


def _set_graphic_runtime(channel_id: int, enabled: bool, graphic_rel: str = ""):
    """Update the runtime graphic-overlay override and restart the current
    on-air clip so the change takes effect immediately.

    ``graphic_rel`` optionally selects a specific graphic (storage-relative
    path) to show instead of the configured one. It is remembered until the
    override is fully cleared (``enabled=None``), so an auto-off keeps the
    selection for the next enable.

    When the selected graphic is an L-band-style squeeze graphic (it carries a
    ``.squeeze.json`` sidecar), enabling starts a smooth fade-in that animates
    the main video into the graphic's "video hole", and disabling runs the
    reverse animation before the graphic is finally dropped.
    """
    cur = _graphic_runtime.setdefault(channel_id, {"enabled": None, "enable_until": None, "timer": None})
    timer = cur.get("timer")
    if timer is not None:
        try:
            timer.cancel()
        except Exception:
            pass
        cur["timer"] = None
    _cancel_sq_timer(cur)
    _cancel_bug_timer(cur)
    if enabled is None:
        cur.pop("enabled", None)
        cur.pop("enable_until", None)
        cur.pop("graphic_rel", None)
        cur["sq_phase"] = "off"
        cur.pop("sq_epoch", None)
        cur.pop("sq_render_lag", None)
        cur["bug_phase"] = "off"
        cur.pop("bug_epoch", None)
        _restart_current_clip(channel_id)
    elif enabled:
        cur["enabled"] = True
        cur["enable_until"] = None
        if graphic_rel:
            cur["graphic_rel"] = graphic_rel
        rel = str(cur.get("graphic_rel") or "").strip()
        if _is_squeeze_graphic(channel_id, rel):
            fade_dur = _squeeze_fade_duration(channel_id)
            cur["sq_phase"] = "in"
            cur.pop("sq_epoch", None)
            cur.pop("sq_render_lag", None)
            cur["bug_phase"] = "off"
            cur.pop("bug_epoch", None)

            async def _steady():
                # Wait for the full animation plus a generous safety margin.
                respawn_margin = max(2.0, cur.get("sq_last_respawn_time", 1.0) + 1.0)
                try:
                    await asyncio.sleep(fade_dur + respawn_margin)
                except asyncio.CancelledError:
                    return
                r = _graphic_runtime.get(channel_id, {})
                if r.get("sq_phase") != "in":
                    return
                # entry transition finished: the running ffmpeg has already
                # settled into the hole; mark the phase so future restarts
                # (clip boundaries) build a static squeeze, not a replay.
                r["sq_phase"] = "on"
                r.pop("sq_epoch", None)
                r.pop("sq_render_lag", None)
                r["sq_timer"] = None

            task = asyncio.get_event_loop().create_task(_steady())
            cur["sq_timer"] = task
        else:
            # Non-squeeze bug: fade it in smoothly instead of popping on.
            fade_dur = _squeeze_fade_duration(channel_id)
            cur["bug_phase"] = "in"
            cur.pop("bug_epoch", None)
            cur["sq_phase"] = "off"
            cur.pop("sq_epoch", None)
            cur.pop("sq_render_lag", None)

            async def _bug_steady():
                respawn_margin = max(2.0, cur.get("sq_last_respawn_time", 1.0) + 1.0)
                try:
                    await asyncio.sleep(fade_dur + respawn_margin)
                except asyncio.CancelledError:
                    return
                r = _graphic_runtime.get(channel_id, {})
                if r.get("bug_phase") != "in":
                    return
                r["bug_phase"] = "on"
                r.pop("bug_epoch", None)
                r["bug_timer"] = None

            task = asyncio.get_event_loop().create_task(_bug_steady())
            cur["bug_timer"] = task
        _restart_current_clip(channel_id)
    else:
        cur["enabled"] = False
        cur["enable_until"] = None
        _begin_bug_exit(channel_id)
        _begin_squeeze_exit(channel_id)
        _restart_current_clip(channel_id)


def _schedule_graphic_autoff(channel_id: int, duration: float, graphic_rel: str = ""):
    """Enable the graphic for ``duration`` seconds, then disable it again."""
    _set_graphic_runtime(channel_id, True, graphic_rel)
    cur = _graphic_runtime.setdefault(channel_id, {})
    cur["enable_until"] = time.time() + max(0.0, duration)

    async def _autoff():
        try:
            await asyncio.sleep(max(0.0, duration))
        except asyncio.CancelledError:
            return
        runtime = _graphic_runtime.get(channel_id, {})
        if runtime.get("enabled") is False:
            return
        runtime["enabled"] = False
        runtime["enable_until"] = None
        runtime["timer"] = None
        _begin_bug_exit(channel_id)
        _begin_squeeze_exit(channel_id)
        _restart_current_clip(channel_id)

    task = asyncio.get_event_loop().create_task(_autoff())
    cur["timer"] = task


def _restart_current_clip(channel_id: int):
    """Bump the generation counter and kill the running ffmpeg so the playout
    loop respawns the current clip with the new filter graph applied."""
    if channel_id not in playout_states:
        return
    st_ = playout_states.setdefault(channel_id, {})
    st_["gen"] = st_.get("gen", 0) + 1
    # note when the process was killed so the squeeze/bug animation can
    # exclude the respawn downtime from its progress (see _squeeze_fade_state)
    grt = _graphic_runtime.setdefault(channel_id, {})
    grt["sq_kill_at"] = time.time()
    _kill_ffmpeg(channel_id)


def _scale_se_value(val, scale: float):
    """Scale numeric style values (and h-N/w-N expressions) to the render size."""
    import re as _re
    if isinstance(val, (int, float)):
        return max(1, int(round(val * scale)))
    if isinstance(val, str):
        def sub_num(m):
            return f"{m.group(1)}-{max(1, int(round(int(m.group(2)) * scale)))}"
        return _re.sub(r"\b([hw])-((?:\d+))", sub_num, val)
    return val


def _escape_drawtext(t: str) -> str:
    # NOTE: this ffmpeg build splits option values on ':' even inside
    # single quotes, so colons must be backslash escaped
    return (
        t.replace("\\", r"\\")
        .replace(":", r"\:")
        .replace("'", r"\'")
        .replace("%", r"\%")
    )


def _secondary_event_filters(channel_id: int, item: dict | None):
    """Build timed overlay filters for the secondary graphic events of a
    playlist item; each overlay shows/disappears mid-clip via enable=between().

    Returns ``(draw_filters, nnl_overlays)``. Events whose (template, text)
    has a cached NNL alpha MOV (see ``_ensure_nnl_mov``) are rendered as
    full-frame movie overlays; the rest fall back to the classic drawtext
    lower third."""
    if not item:
        return [], []
    events = item.get("secondary_events")
    if not isinstance(events, list) or not events:
        return [], []
    enable, fontfile, style_overrides = _get_se_config(channel_id)
    if not enable:
        return [], []
    if not fontfile:
        # No usable TTF on this box. Emitting drawtext with a fontfile that
        # does not exist aborts ffmpeg's whole filter graph, so drop the
        # lower-third instead of killing every rendition.
        print("[se] no usable TTF found; skipping secondary-event drawtext")
        return [], []
    proc = _get_playout_config(channel_id).get("processing") or {}
    scale = float(proc.get("height", 1080)) / 1080.0
    filters = []
    nnl_overlays = []
    for ev in events:
        if not isinstance(ev, dict):
            continue
        try:
            # "in" (alias of legacy "offset") and "out" = in + duration;
            # out wins over duration when both are present
            off = max(float(ev.get("in", ev.get("offset", 0) or 0) or 0), 0.0)
            out_v = ev.get("out")
            if out_v is not None and str(out_v).strip() != "":
                dur = float(out_v) - off
            else:
                dur = float(ev.get("duration", 0) or 0)
        except (TypeError, ValueError):
            continue
        text = str(ev.get("text") or "").strip()
        if dur <= 0 or not text:
            continue
        template = str(ev.get("template") or "").strip() or "custom"
        mov = _ensure_nnl_mov(channel_id, template, text, off, off + dur)
        if mov:
            nnl_overlays.append({"path": mov, "in": off, "out": off + dur})
            continue
        key = template.lower()
        style = dict(_SE_STYLE_DEFAULTS.get(key, _SE_STYLE_DEFAULTS["_default"]))
        override = style_overrides.get(key)
        if isinstance(override, dict):
            style.update(override)
        # named corner ("top right", ...) wins over raw x/y; size is a
        # percentage on top of the base fontsize
        margin = max(4, int(round(24 * scale)))
        pos_xy = _se_position_xy(style.get("position"), margin)
        try:
            size_pct = float(style.get("size", 100))
        except (TypeError, ValueError):
            size_pct = 100.0
        size_pct = min(max(size_pct, 25.0), 400.0)
        fontsize = _scale_se_value(style.get("fontsize", 34), scale)
        fontsize = max(6, int(round(fontsize * size_pct / 100.0)))
        if pos_xy:
            x, y = pos_xy
        else:
            x = _scale_se_value(style.get("x", 60), scale)
            y = _scale_se_value(style.get("y", "h-72"), scale)
        boxcolor = style.get("boxcolor", "black@0.6")
        boxborderw = _scale_se_value(style.get("boxborderw", 12), scale)
        label = template.upper() if key in ("now", "next", "later") else ""
        display = f"{label}: {text}" if label else text
        enable_expr = f"between(t,{off:.3f},{off + dur:.3f})"
        filters.append(
            "drawtext="
            f"fontfile='{_escape_filter_path(fontfile)}'"
            f":text='{_escape_drawtext(display)}'"
            f":fontsize={fontsize}:fontcolor=white"
            f":x='{x}':y='{y}'"
            f":box=1:boxcolor={boxcolor}:boxborderw={boxborderw}"
            f":enable='{enable_expr}'"
        )
    return filters, nnl_overlays


# === NNL DYNAMIC GRAPHICS (NOW/NEXT/LATER/Current-Movie) ===

# The NNL templates arrive as After Effects projects (zips) that ffmpeg
# cannot render. Instead the operator provides a rendered alpha base MOV per
# template under <storage>/graphics/NNL - the template WITHOUT the dynamic
# name text - OR uploads the template as a zip of TGA frames with alpha
# (NOW.zip / next.zip / LATER.zip / ...) which is converted to that base MOV
# automatically. At bake time the playlist's Line1 value (the movie name) is
# drawn onto a copy and the result cached under
# <storage>/media/process/graphics as "nnl_<template>_<text>_<dur>s.mov"
# (ProRes 4444 with alpha), so identical (template, movie title) pairs are
# generated exactly once.

_NNL_SOURCE_DIRNAME = "NNL"
_NNL_MOV_EXTS = {".mov", ".mp4", ".webm"}
_NNL_FADE_DEFAULT = 0.25
_NNL_BLEND_META_CACHE: dict = {}

# Acceptable base-render file/folder names per template (normalized): the
# operator's renders may use several spellings (current movie, currentmovie,
# ZEE-CLIPINFO, clipinfo, ...).
_NNL_TEMPLATE_ALIASES = {
    "now": {"now"},
    "next": {"next"},
    "later": {"later"},
    "currentmovie": {"currentmovie", "currentmovies", "currentmovie",
                     "movie", "clipinfo", "zee-clipinfo", "zeeclipinfo",
                     "zeecclipinfo", "current movie"},
}


def _normalize_nnl_template(template: str) -> str:
    return re.sub(r"[\s_\-]+", "", str(template or "").strip().lower())


def _nnl_text_tag(text: str, limit: int = 60) -> str:
    """ASCII-safe stem for cache filenames. Non-ASCII characters (Arabic
    titles etc.) are replaced with '_'; when the original text contains any
    non-ASCII bytes a short sha1 hash is appended so distinct texts never
    collide on disk (Windows/ffmpeg cannot write non-ASCII output paths)."""
    s = str(text or "").strip()
    tag = re.sub(r"[^0-9A-Za-z]+", "_", s)[:limit].strip("_")
    if not tag:
        tag = "text"
    if s.isascii():
        return tag
    digest = hashlib.sha1(s.encode("utf-8")).hexdigest()[:8]
    return f"{tag}_{digest}"


def _nnl_base_fingerprint(base_mov: str) -> str:
    """Short stable hash of a base render's size + mtime, so swapping in a new
    After-Effects render invalidates its cached baked copies (a changed render
    must never be silently served to an old cache entry keyed only on the
    movie title)."""
    if not base_mov:
        return ""
    try:
        st = os.stat(base_mov)
    except OSError:
        return ""
    return hashlib.sha1(f"{st.st_size}:{st.st_mtime_ns}".encode()).hexdigest()[:8]


def _nnl_base_mov_path(channel_id: int, template: str) -> str:
    """Resolve the operator-provided rendered base MOV for a template name
    (NOW / NEXT / LATER / Current-Movie). Looks for a matching video file at
    the root of <storage>/graphics/NNL first, then inside a per-template
    subfolder (now/, next/, later/, currentmovies/, ...). The file name is
    matched case-insensitively against the template stem."""
    d = _get_channel_storage(channel_id) / "graphics" / _NNL_SOURCE_DIRNAME
    if not d.is_dir():
        return ""
    want = _normalize_nnl_template(template)
    if not want:
        return ""
    aliases = {want} | {_normalize_nnl_template(a)
                        for a in _NNL_TEMPLATE_ALIASES.get(want, ())}

    def _pick(entries) -> str:
        for entry in entries:
            if not entry.is_file() or entry.suffix.lower() not in _NNL_MOV_EXTS:
                continue
            stem = _normalize_nnl_template(Path(entry.name).stem)
            if stem in aliases or any(a.startswith(stem) or stem.startswith(a)
                                      for a in aliases if a):
                return str(entry)
        return ""

    # 1) flat files at the NNL root
    direct = sorted(d.iterdir(), key=lambda p: p.name.lower())
    found = _pick(direct)
    if found:
        return found

    # 2) per-template subfolders (now/, next/, later/, currentmovies/, ...)
    for sub in sorted(p for p in direct if p.is_dir()):
        subwant = _normalize_nnl_template(sub.name)
        if not (subwant == want or subwant.startswith(want) or want.startswith(subwant)):
            continue
        try:
            found = _pick(sorted(sub.iterdir(), key=lambda p: p.name.lower()))
        except OSError:
            continue
        if found:
            return found
    return ""


def _nnl_tga_zip_path(channel_id: int, template: str) -> str:
    """Find an uploaded TGA-sequence zip for an NNL template (NOW.zip,
    NEXT.zip, LATER.zip, ZEE-CLIPINFO.zip, ...).

    Searches the NNL source dir (<storage>/graphics/NNL) first, then the
    generic graphic/logo candidate folders, and returns the path of the first
    zip whose name resolves to this template (or '' when none exists). The zip
    is treated as the rendered base animation of the template WITHOUT the
    dynamic movie-title text; see ``_nnl_tga_base_mov``."""
    want = _normalize_nnl_template(template)
    if not want:
        return ""
    storage = _get_channel_storage(channel_id)
    candidates = [storage / "graphics" / _NNL_SOURCE_DIRNAME]
    candidates += _graphic_candidate_folders(storage)
    seen = set()
    for d in candidates:
        if not d.is_dir():
            continue
        try:
            key = str(d.resolve())
        except OSError:
            key = str(d)
        if key in seen:
            continue
        seen.add(key)
        for f in _collect_files(d, {".zip"}):
            if _nnl_template_for_zip(str(f)) == want:
                return str(f)
    return ""


def _nnl_extract_tga_frames(zip_path: str) -> str:
    """Dump every .tga frame of an NNL zip into a fresh temp dir as
    ``frame_%06d.tga`` (ordered by the frame number embedded in the archive
    entry names) and return that dir. Raises RuntimeError when the archive
    holds no TGA sequence."""
    import tempfile
    entries = _tga_entry_index(zip_path)
    if not entries:
        raise RuntimeError("no .tga frames found in NNL archive")
    outdir = tempfile.mkdtemp(prefix="nnl_tga_")
    for i, (_, entry) in enumerate(entries):
        with open(os.path.join(outdir, f"frame_{i:06d}.tga"), "wb") as f:
            f.write(_read_tga(zip_path, entry))
    return outdir


def _nnl_tga_base_mov(channel_id: int, template: str, zip_path: str) -> str:
    """Convert an uploaded NNL TGA sequence (a zip of alpha TGA frames) into a
    reusable base alpha MOV stored at <storage>/graphics/NNL/<template>.mov,
    so ``_nnl_base_mov_path`` finds it and ``_bake_nnl_mov`` can draw the
    playlist Line1 movie title on top. Re-encodes only when the archive is
    newer than the cached base (a changed render never silently reuses the old
    base). Returns the base MOV path, or '' on failure."""
    want = _normalize_nnl_template(template) or "nnl"
    target = (_get_channel_storage(channel_id) / "graphics" / _NNL_SOURCE_DIRNAME
              / f"{want}.mov")
    if target.is_file():
        try:
            if os.path.getmtime(str(target)) >= os.path.getmtime(zip_path):
                return str(target)
        except OSError:
            return str(target)
    outdir = None
    try:
        outdir = _nnl_extract_tga_frames(zip_path)
        names = sorted(p for p in os.listdir(outdir) if p.endswith(".tga"))
        if not names:
            return ""
        target.parent.mkdir(parents=True, exist_ok=True)
        cmd = [
            FFMPEG_BIN, "-hide_banner", "-y",
            "-framerate", "25", "-start_number", "0",
            "-i", os.path.join(outdir, "frame_%06d.tga"),
            "-c:v", "prores_ks",
            "-profile:v", "4444",
            "-pix_fmt", "yuva444p10le",
            "-q:v", "9",
            "-movflags", "+faststart",
            *_thread_args(),
            "-an",
            str(target),
        ]
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=3600,
                              creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
        if proc.returncode != 0 or not target.is_file():
            print(f"[nnl] channel {channel_id}: TGA base encode failed for "
                  f"{want}: {(proc.stderr or '')[-400:]}")
            return ""
        print(f"[nnl] channel {channel_id}: TGA base for {want} "
              f"-> {target.name}")
        return str(target)
    except Exception as e:
        print(f"[nnl] channel {channel_id}: TGA base encode interrupted for "
              f"{want}: {e}")
        return ""
    finally:
        if outdir:
            try:
                shutil.rmtree(outdir, ignore_errors=True)
            except Exception:
                pass


def _nnl_mov_target(channel_id: int, template: str, text: str, dur: float,
                    seed: str = "") -> Path:
    """Cache path for (template, text, duration). ``seed`` is the source file
    the movie graphic derives from (a Blender .blend scene or a rendered base
    MOV); its fingerprint is folded into the name so an edited source produces
    a fresh render instead of a stale cache hit.

    The text style is folded in as well. Without it a repositioning/sizing
    change to ``_SE_STYLE_DEFAULTS`` was invisible: the already-baked MOV still
    matched and ``_bake_nnl_mov`` returned it untouched."""
    tgt_dir = _animated_graphic_dir(channel_id)
    tgt_dir.mkdir(parents=True, exist_ok=True)
    fp = f"_{_nnl_base_fingerprint(seed)}" if seed else ""
    key = _normalize_nnl_template(template) or "nnl"
    _, _, style_overrides = _get_se_config(channel_id)
    style = dict(_SE_STYLE_DEFAULTS.get(key, _SE_STYLE_DEFAULTS["_default"]))
    override = style_overrides.get(key) or style_overrides.get(str(template).lower())
    if isinstance(override, dict):
        style.update(override)
    style_fp = hashlib.sha1(
        json.dumps(style, sort_keys=True).encode()).hexdigest()[:6]
    stem = (
        f"nnl_{key}_"
        f"{_nnl_text_tag(text)}_{int(round(max(dur, 1.0)))}s{fp}s{style_fp}"
    )
    return tgt_dir / f"{stem}.mov"


def _bake_nnl_mov(channel_id: int, template: str, text: str,
                  base_mov: str, dur: float) -> str:
    """Render the Line1 text onto a rendered NNL base MOV, looping the base so
    the baked copy is exactly ``dur`` seconds long, and cache the alpha ProRes
    4444 result. Returns the cached path, or '' on failure."""
    if dur <= 0:
        return ""
    target = _nnl_mov_target(channel_id, template, text, dur, base_mov)
    if target.is_file():
        return str(target)
    if not os.path.isfile(base_mov):
        return ""
    _, fontfile, style_overrides = _get_se_config(channel_id)
    if not fontfile or not os.path.isfile(fontfile):
        return ""

    key = _normalize_nnl_template(template) or "nnl"
    style = dict(_SE_STYLE_DEFAULTS.get(key, _SE_STYLE_DEFAULTS["_default"]))
    override = style_overrides.get(key) or style_overrides.get(str(template).lower())
    if isinstance(override, dict):
        style.update(override)

    margin = max(4, int(round(24)))
    pos_xy = _se_position_xy(style.get("position"), margin)
    try:
        size_pct = float(style.get("size", 100))
    except (TypeError, ValueError):
        size_pct = 100.0
    size_pct = min(max(size_pct, 25.0), 400.0)
    fontsize = _scale_se_value(style.get("fontsize", 34), 1.0)
    fontsize = max(6, int(round(fontsize * size_pct / 100.0)))
    if pos_xy:
        x, y = pos_xy
    else:
        x = _scale_se_value(style.get("x", 60), 1.0)
        y = _scale_se_value(style.get("y", "h-72"), 1.0)
    boxcolor = style.get("boxcolor", "black@0.6")
    boxborderw = _scale_se_value(style.get("boxborderw", 12), 1.0)

    # fade the movie name in/out following the base animation's own loop
    # timing (like the reference NNL renders): each pass of the loop the name
    # fades in over `fadein` seconds and fades out over `fadeout` seconds. The
    # loop duration is probed from the base so mod(t, loop) realigns it with
    # every graphic repeat; whole-window fades are useless because the baked
    # copy loops the base many times.
    try:
        loop_d = float(_probe_file_meta(str(base_mov)).get("duration") or dur)
    except Exception:
        loop_d = dur
    loop_d = max(0.5, loop_d)
    f_in = max(0.05, min(float(style.get("fadein", 1.0) or 1.0), loop_d * 0.45))
    f_out = max(0.05, min(float(style.get("fadeout", 1.0) or 1.0), loop_d * 0.45))
    if f_in + f_out > loop_d * 0.9:
        scale = (loop_d * 0.9) / (f_in + f_out)
        f_in *= scale
        f_out *= scale
    tl = f"mod(t,{loop_d:.3f})"
    alpha_exp = (
        f"if(lt({tl},{f_in:.3f}),{tl}/{f_in:.3f},"
        f"if(lt({tl},{loop_d - f_out:.3f}),1,({loop_d:.3f}-{tl})/{f_out:.3f}))"
    )

    vf = (
        "drawtext="
        f"fontfile='{_escape_filter_path(fontfile)}'"
        f":text='{_escape_drawtext(text)}'"
        f":fontsize={fontsize}:fontcolor=white"
        f":x='{x}':y='{y}'"
        f":alpha='{alpha_exp}'"
        f":box=1:boxcolor={boxcolor}:boxborderw={boxborderw}"
    )
    cmd = [
        FFMPEG_BIN, "-hide_banner", "-loglevel", "error", "-y",
        "-stream_loop", "-1",
        "-i", base_mov,
        "-t", f"{dur:.3f}",
        "-vf", vf,
        "-c:v", "prores_ks",
        "-profile:v", "4444",
        "-pix_fmt", "yuva444p10le",
        "-q:v", "9",
        *_thread_args(),
        "-an",
        str(target),
    ]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=3600,
                              creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
    except Exception as e:  # timeout / spawn errors must never kill playout
        print(f"[nnl] channel {channel_id}: bake interrupted for "
              f"{template!r}/{text!r}: {e}")
        return ""
    if proc.returncode == 0 and target.is_file():
        _nnl_bake_preview(str(target))
        print(f"[nnl] channel {channel_id}: baked {template!r}/{text!r} "
              f"({dur:.1f}s) -> {target.name}")
        return str(target)
    try:
        target.unlink(missing_ok=True)
    except OSError:
        pass
    print(f"[nnl] channel {channel_id}: bake failed for {template!r}/{text!r}: "
          f"{(proc.stderr or '')[-500:]}")
    return ""


_NNL_BLEND_RENDER_SCRIPT = None
_BLENDER_EXE = None


def _find_blender_executable() -> str:
    """Locate a headless-capable Blender binary. Checks $BLENDER_BIN, PATH, then
    the standard Windows install locations; the result is cached."""
    global _BLENDER_EXE
    if _BLENDER_EXE:
        return _BLENDER_EXE
    for cand in (os.environ.get("BLENDER_BIN") or "",
                 shutil.which("blender") or ""):
        if cand and os.path.isfile(cand):
            _BLENDER_EXE = cand
            return cand
    bases = []
    local = os.environ.get("LOCALAPPDATA", "")
    for base in (
        r"C:\Program Files\Blender Foundation",
        r"C:\Program Files (x86)\Blender Foundation",
        os.path.join(local, "Programs", "Blender Foundation") if local else "",
        os.path.join(local, "Blender Foundation") if local else "",
    ):
        if base and os.path.isdir(base):
            bases.append(base)
    for base in bases:
        try:
            for sub in sorted(os.listdir(base)):
                cand = os.path.join(base, sub, "blender.exe")
                if os.path.isfile(cand):
                    _BLENDER_EXE = cand
                    return cand
        except OSError:
            continue
    _BLENDER_EXE = ""
    return _BLENDER_EXE


def _nnl_blend_path(channel_id: int, template: str) -> str:
    """Resolve the operator-authored Blender scene for a template
    (NOW.blend / NEXT.blend / LATER.blend / ZEE-CLIPINFO.blend) at the root of
    <storage>/graphics/NNL or inside a per-template subfolder (now/, next/, ...).
    Returns '' when no scene exists yet."""
    d = _get_channel_storage(channel_id) / "graphics" / _NNL_SOURCE_DIRNAME
    if not d.is_dir():
        return ""
    want = _normalize_nnl_template(template)
    if not want:
        return ""
    aliases = {want} | {_normalize_nnl_template(a)
                        for a in _NNL_TEMPLATE_ALIASES.get(want, ())}

    def _pick(entries) -> str:
        for entry in entries:
            if not entry.is_file() or entry.suffix.lower() != ".blend":
                continue
            stem = _normalize_nnl_template(Path(entry.name).stem)
            if stem in aliases or any(a.startswith(stem) or stem.startswith(a)
                                      for a in aliases if a):
                return str(entry)
        return ""

    direct = sorted(d.iterdir(), key=lambda p: p.name.lower())
    found = _pick(direct)
    if found:
        return found
    for sub in sorted(p for p in direct if p.is_dir()):
        subwant = _normalize_nnl_template(sub.name)
        if not (subwant == want or subwant.startswith(want) or want.startswith(subwant)):
            continue
        try:
            found = _pick(sorted(sub.iterdir(), key=lambda p: p.name.lower()))
        except OSError:
            continue
        if found:
            return found
    return ""


def _blender_scene_meta(blender_bin: str, blend_path: str) -> dict:
    """Read render fps/resolution/frame range from a .blend by booting Blender
    headless and asking it to print them. The result is cached per scene
    fingerprint (a changed scene invalidates cached renders anyway)."""
    import tempfile as _tf
    fp = _nnl_base_fingerprint(blend_path)
    cache_key = f"blend_meta_{fp}"
    meta = _NNL_BLEND_META_CACHE.get(cache_key) or {}
    if meta:
        return meta
    expr = (
        "import bpy;"
        "s=bpy.context.scene;"
        "fps=max(1,int(round(s.render.fps/s.render.fps_base)));"
        "print('NNLMETA %d %d %d %d' % (fps,s.render.resolution_x,"
        "s.render.resolution_y,s.frame_start,s.frame_end))"
    )
    try:
        proc = subprocess.run(
            [blender_bin, "-b", blend_path, "-y", "--python-expr", expr],
            capture_output=True, text=True, timeout=300,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
    except Exception as e:
        print(f"[nnl] blender meta probe failed for {blend_path}: {e}")
        return {}
    for line in (proc.stdout or "").splitlines():
        if line.startswith("NNLMETA"):
            parts = line.split()
            if len(parts) == 5:
                meta = {"fps": int(parts[1]), "width": int(parts[2]),
                        "height": int(parts[3]), "start": int(parts[4]),
                        "end": 0}
                _NNL_BLEND_META_CACHE[cache_key] = meta
                return meta
    return {}


def _render_nnl_blender(channel_id: int, template: str, text: str,
                        dur: float) -> str:
    """Render a playlist movie graphic in Blender headless: the .blend scene
    (authored with a replaceable TITLE text object, transparent film) is opened,
    the Line1 title is injected, the animation is rendered to a PNG sequence and
    transcoded by ffmpeg to a cached alpha ProRes 4444 MOV. Returns the MOV path
    or '' (no blender / no scene / render failure)."""
    import tempfile as _tf
    import shutil as _sh
    blender = _find_blender_executable()
    blend = _nnl_blend_path(channel_id, template)
    if not blender or not blend:
        return ""
    meta = _blender_scene_meta(blender, blend)
    fps = int(meta.get("fps") or 25)
    if fps <= 0:
        fps = 25
    frames = max(1, int(round(float(dur) * fps)))
    target = _nnl_mov_target(channel_id, template, text, dur, blend)
    if target.is_file():
        return str(target)

    script = _nnl_render_script_path()
    tmp_dir = _tf.mkdtemp(prefix="nnl_blend_")
    cmd = [
        blender, "-b", blend, "-y",
        "--python", script,
        "--",
        "--title", text,
        "--out", tmp_dir,
        "--fps", str(fps),
        "--frames", str(frames),
    ]
    _, fontfile, _ = _get_se_config(channel_id)
    if fontfile and os.path.isfile(fontfile) and not str(text).isascii():
        cmd += ["--font", fontfile]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=7200,
                              creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
    except Exception as e:
        print(f"[nnl] channel {channel_id}: blender interrupted for "
              f"{template!r}/{text!r}: {e}")
        _sh.rmtree(tmp_dir, ignore_errors=True)
        return ""
    frame_files = sorted(Path(tmp_dir).glob("frame_*.png"))
    if proc.returncode != 0 or not frame_files:
        print(f"[nnl] channel {channel_id}: blender render failed for "
              f"{template!r}/{text!r}: {(proc.stderr or '')[-600:]}")
        _sh.rmtree(tmp_dir, ignore_errors=True)
        return ""
    try:
        enc = subprocess.run(
            [FFMPEG_BIN, "-hide_banner", "-y", "-loglevel", "error",
             "-framerate", str(fps),
             "-i", os.path.join(tmp_dir, "frame_%05d.png"),
             "-vf", "format=yuva444p10le",
             "-c:v", "prores_ks",
             "-profile:v", "4444",
             "-pix_fmt", "yuva444p10le",
             "-frames:v", str(frames),
             *_thread_args(),
             "-an",
             str(target)],
            capture_output=True, text=True, timeout=3600,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
        ok = enc.returncode == 0 and target.is_file()
    except Exception as e:
        print(f"[nnl] channel {channel_id}: blender transcode interrupted "
              f"for {template!r}/{text!r}: {e}")
        ok = False
    _sh.rmtree(tmp_dir, ignore_errors=True)
    if ok:
        _nnl_bake_preview(str(target))
        print(f"[nnl] channel {channel_id}: blender-rendered {template!r}/"
              f"{text!r} ({dur:.1f}s @{fps}fps) -> {target.name}")
        return str(target)
    try:
        target.unlink(missing_ok=True)
    except OSError:
        pass
    return ""


_nnl_default_base_cache: dict = {}


def _write_transparent_png(path) -> bool:
    """Write a tiny fully-transparent RGBA PNG (pure stdlib: struct+zlib) so
    the placeholder base can be built from a genuinely alpha=0 source. Older
    ffmpeg color filters drop alpha (black@0.0 -> opaque), so we avoid lavfi
    for the transparent background entirely."""
    import struct as _st
    import zlib as _zl

    def _chunk(tag: bytes, data: bytes) -> bytes:
        c = tag + data
        return (_st.pack(">I", len(data)) + c +
                _st.pack(">I", _zl.crc32(c) & 0xFFFFFFFF))

    try:
        w = h = 4
        ihdr = _st.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0)
        raw = b"".join(b"\x00" + b"\x00\x00\x00\x00" * w for _ in range(h))
        png = (b"\x89PNG\r\n\x1a\n"
               + _chunk(b"IHDR", ihdr)
               + _chunk(b"IDAT", _zl.compress(raw, 9))
               + _chunk(b"IEND", b""))
        with open(path, "wb") as fh:
            fh.write(png)
        return True
    except Exception:
        return False


def _nnl_template_label(template: str) -> str:
    key = _normalize_nnl_template(template)
    return {"now": "NOW", "next": "NEXT", "later": "LATER",
            "currentmovie": "CURRENT MOVIE"}.get(key, str(template).upper())


def _nnl_default_base_mov(channel_id: int, template: str) -> str:
    """Synthesize a transparent 1080p placeholder base for a template (template
    name watermark only) so the NNL pipeline runs end-to-end before the real
    Blender scene / base render is dropped in. Disable with env
    FFPLAYOUT_NNL_SYNTH=0. Returns the MOV path or ''."""
    if os.environ.get("FFPLAYOUT_NNL_SYNTH", "1").strip().lower() in (
            "0", "false", "no", "off"):
        return ""
    cached = _nnl_default_base_cache.get((channel_id, template))
    if cached:
        return cached if os.path.isfile(cached) else ""
    key = _normalize_nnl_template(template) or "nnl"
    target = _animated_graphic_dir(channel_id) / f"nnl_default_{key}_base.mov"
    fontfile = _resolve_ttf_font(None, bold=True)
    if not fontfile:
        _nnl_default_base_cache[(channel_id, template)] = ""
        return ""
    label = _nnl_template_label(template)
    bg_png = _animated_graphic_dir(channel_id) / "nnl_bg_transparent.png"
    if not _write_transparent_png(bg_png):
        _nnl_default_base_cache[(channel_id, template)] = ""
        return ""
    vf = (
        "scale=1920:1080:flags=bilinear,"
        "drawbox=x=0:y=ih-260:w=iw:h=240:color=0x1e3a5f@0.88:t=fill,"
        "drawbox=x=0:y=ih-264:w=iw:h=4:color=0xf4a93b@1.0:t=fill,"
        "drawtext="
        f"fontfile='{_escape_filter_path(fontfile)}'"
        f":text='{_escape_drawtext(label)}'"
        ":fontsize=56:fontcolor=white@0.95"
        ":x=60:y=h-240,"
        "drawtext="
        f"fontfile='{_escape_filter_path(fontfile)}'"
        ":text='placeholder - replace with Blender scene / base render'"
        ":fontsize=24:fontcolor=white@0.55"
        ":x=w-text_w-40:y=h-70"
        ",format=yuva444p10le"
    )
    cmd = [FFMPEG_BIN, "-hide_banner", "-y", "-loglevel", "error",
           "-loop", "1", "-framerate", "25", "-i", str(bg_png),
           "-vf", vf,
           "-t", "30",
           "-c:v", "prores_ks",
           "-profile:v", "4444",
           "-pix_fmt", "yuva444p10le",
           "-q:v", "9",
           *_thread_args(),
           "-an",
           str(target)]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=600,
                              creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
    except Exception as e:
        print(f"[nnl] channel {channel_id}: default base interrupted "
              f"for {template!r}: {e}")
        _nnl_default_base_cache[(channel_id, template)] = ""
        return ""
    if proc.returncode != 0 or not target.is_file():
        print(f"[nnl] channel {channel_id}: default base failed for "
              f"{template!r}: {(proc.stderr or '')[-300:]}")
        _nnl_default_base_cache[(channel_id, template)] = ""
        return ""
    _nnl_default_base_cache[(channel_id, template)] = str(target)
    print(f"[nnl] channel {channel_id}: placeholder base for "
          f"{label} -> {target.name}")
    return str(target)


def _render_nnl_mov(channel_id: int, template: str, text: str,
                    dur: float, zip_path: str = "") -> str:
    """Produce a cached alpha MOV for an NNL (template, movie title, duration).
    Source priority: Blender headless render (scene + Blender present) →
    operator base MOV bake → uploaded TGA-sequence zip (converted to a base
    alpha MOV, then baked) → synthesized placeholder base bake. Returns the
    cached path or '' (nothing to build from currently)."""
    blend = _nnl_blend_path(channel_id, template)
    if blend and _find_blender_executable():
        return _render_nnl_blender(channel_id, template, text, dur)
    base = _nnl_base_mov_path(channel_id, template)
    if base:
        return _bake_nnl_mov(channel_id, template, text, base, dur)
    zp = zip_path or _nnl_tga_zip_path(channel_id, template)
    if zp:
        base = _nnl_tga_base_mov(channel_id, template, zp)
        if base:
            return _bake_nnl_mov(channel_id, template, text, base, dur)
    default = _nnl_default_base_mov(channel_id, template)
    if default:
        return _bake_nnl_mov(channel_id, template, text, default, dur)
    return ""


def _nnl_render_script_path() -> str:
    """Absolute path of the Blender render helper shipped next to server.py."""
    global _NNL_BLEND_RENDER_SCRIPT
    if not _NNL_BLEND_RENDER_SCRIPT:
        _NNL_BLEND_RENDER_SCRIPT = str(
            Path(__file__).resolve().parent / "blender_nnl_render.py")
    return _NNL_BLEND_RENDER_SCRIPT


def _nnl_bake_preview(mov_path: str, fade_d: float = 0.3) -> str:
    """Generate a browser-playable 960x540 webm copy of a baked NNL MOV so the
     Media Library Graphics tab can show a preview (bare ProRes 4444 MOVs do not
     play in browsers). Returns the webm path when ready, else the MOV path."""
    target = Path(mov_path)
    webm = target.parent / f"{target.stem}_preview.webm"
    if webm.is_file():
        return str(webm)
    try:
        cmd = [
            FFMPEG_BIN, "-hide_banner", "-y", "-loglevel", "error",
            "-i", mov_path,
            "-filter_complex",
            "color=c=black:s=960x540:r=25:d=100[b];"
            "[0:v]format=rgba,scale=960:540"
            f",fade=t=in:st=0:d={fade_d:.3f}:alpha=1"
            "[fg];[b][fg]overlay=shortest=1:format=auto,format=yuv420p[v]",
            "-map", "[v]",
            "-c:v", "libvpx-vp9",
            "-b:v", "800k",
            "-deadline", "realtime",
            "-cpu-used", "8",
            *_thread_args(),
            "-an",
            str(webm),
        ]
        subprocess.run(cmd, capture_output=True, text=True, timeout=1800,
                       creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
    except Exception:
        pass
    return str(webm) if webm.is_file() else mov_path


def _nnl_library_assets(channel_id: int, asset_relative) -> list:
    """Media Library entries for the baked NNL alpha MOVs (dynamic NOW/NEXT/
    LATER/Current-Movie graphics), so each movie's processed graphic shows up
    under Graphics with a playable preview."""
    assets = []
    nnl_dir = _animated_graphic_dir(channel_id)
    if not nnl_dir.is_dir():
        return assets
    for file in _collect_files(nnl_dir, {".mov"}):
        if not file.name.lower().startswith("nnl_"):
            continue
        rel = asset_relative(file)
        meta = _probe_file_meta(str(file))
        fps = _parse_frame_rate(meta["frame_rate"])
        preview = file.parent / f"{file.stem}_preview.webm"
        play_rel = asset_relative(preview) if preview.is_file() else rel
        assets.append({
            "asset_id": file.stem,
            "title": file.name,
            "category": "graphics",
            "media_type": "video",
            "segments": 0,
            "duration": _smpte_time(meta["duration"], fps),
            "duration_seconds": round(meta["duration"], 3),
            "audio": meta["audio"],
            "cc": False,
            "status": "processed",
            "frame_rate": f"{fps:g}" if fps > 0 else "",
            "path": f"/{rel}",
            "play_path": f"/{play_rel}",
            "graphic_source": f"/{rel}",
        })
    return assets


def _nnl_template_for_zip(zip_path: str) -> str:
    """Return the normalized NNL template name (now/next/later/currentmovie)
    when a zip belongs to the NNL family (NOW.zip, NEXT.zip, LATER.zip,
    ZEE-CLIPINFO.zip, ...), else ''."""
    stem = _normalize_nnl_template(Path(zip_path).stem)
    if not stem:
        return ""
    for tpl, aliases in _NNL_TEMPLATE_ALIASES.items():
        names = {_normalize_nnl_template(a) for a in aliases}
        if stem in names:
            return tpl
    # prefix/accent matching so "NOW 2", "ZEE-CLIPINFO-1" still resolve
    for tpl, aliases in _NNL_TEMPLATE_ALIASES.items():
        names = {_normalize_nnl_template(a) for a in aliases}
        for a in names:
            if a and (stem.startswith(a) or a.startswith(stem)):
                return tpl
    return ""


def _nnl_cached_for_template(channel_id: int, template: str) -> list:
    """All already-baked NNL MOVs for a template (most recent first)."""
    d = _animated_graphic_dir(channel_id)
    if not d.is_dir():
        return []
    pref = f"nnl_{_normalize_nnl_template(template)}_"
    hits = [f for f in _collect_files(d, {".mov"})
            if f.name.lower().startswith(pref)]
    return sorted(hits, key=lambda p: p.stat().st_mtime, reverse=True)


# How the four built-in aliases are spelled in the playlist, so the UI offers
# exactly the names that must be stored.
_NNL_BUILTIN_TEMPLATES = ["NOW", "NEXT", "LATER", "Current-Movie"]

_NNL_SOURCE_EXTS = {".mov", ".mp4", ".webm", ".zip", ".blend"}


def _nnl_template_display_name(stem: str) -> str:
    """Playlist-facing name for a discovered template file stem.

    The resolution of a template to its base render is a prefix match (see
    ``_nnl_base_mov_path``), so a render named ``Aston-test.mov`` is reachable
    as ``Aston``. Strip that work-in-progress suffix so the UI offers the same
    short name the playlist already uses instead of the file name.
    """
    name = str(stem or "").strip()
    trimmed = re.sub(r"[\s_\-]*(?:test|final|draft|tmp)$", "", name,
                     flags=re.IGNORECASE).strip(" _-")
    return trimmed or name


def _available_nnl_templates(channel_id: int) -> list:
    """Every graphic template the NNL pipeline can render for this channel.

    The four built-in aliases plus anything the operator has dropped into
    ``<storage>/graphics/NNL`` as a base MOV, a TGA-sequence zip or a Blender
    scene. Those extras are the station-specific ones the playlist refers to
    as e.g. ``Aston`` or ``L-band``; without listing them the UI could only
    offer NOW/NEXT/LATER/Current-Movie and those overlays could not be
    scheduled from the browser at all."""
    names = list(_NNL_BUILTIN_TEMPLATES)
    seen = {_normalize_nnl_template(n) for n in names}
    try:
        storage = _get_channel_storage(channel_id)
    except HTTPException:
        return names
    # Only the NNL source folder: the graphic/logo candidate folders also cover
    # the channel's whole media tree, which would offer every programme file as
    # a "template".
    dirs = [storage / "graphics" / _NNL_SOURCE_DIRNAME]
    for d in dirs:
        if not d.is_dir():
            continue
        for f in _collect_files(d, _NNL_SOURCE_EXTS):
            stem = Path(f.name).stem
            if not stem or stem.lower().startswith("nnl_"):
                continue
            # derived preview proxies / editor leftovers are not templates
            if stem.lower().endswith(("_preview", ".origcanvas", ".orig")):
                continue
            display = _nnl_template_display_name(stem)
            key = _normalize_nnl_template(display)
            if not key or key in seen:
                continue
            seen.add(key)
            names.append(display)
    return names


def _ensure_nnl_mov(channel_id: int, template: str, text: str,
                    start: float, end: float) -> str:
    """Cached NNL generator: return the produced MOV for (template, text)
    covering the ``start..end`` window, building it on first use (Blender
    render, or ffmpeg bake onto the base MOV). Returns '' when nothing to
    build from exists yet (no scene, no blender, no base render)."""
    dur = float(end) - float(start)
    if dur <= 0 or not text:
        return ""
    return _render_nnl_mov(channel_id, template, text, dur)


def _se_event_window(ev: dict) -> tuple:
    """Resolve a secondary event's (start, end) window; returns (0, 0) when
    the window cannot be read or is invalid."""
    if not isinstance(ev, dict):
        return 0.0, 0.0
    try:
        start = max(float(ev.get("in", ev.get("offset", 0) or 0) or 0), 0.0)
        out_v = ev.get("out")
        if out_v is not None and str(out_v).strip() != "":
            end = float(out_v)
        else:
            end = start + float(ev.get("duration", 0) or 0)
    except (TypeError, ValueError):
        return 0.0, 0.0
    if end <= start:
        return 0.0, 0.0
    return start, end


def _ensure_nnl_graphics(channel_id: int, program: list) -> dict:
    """Pre-build cached NNL MOVs for every secondary event of the program
    (via Blender headless render or base-MOV bake).
    Returns counts: {built, skipped, missing_base, failed}."""
    counts = {"built": 0, "skipped": 0, "missing_base": 0, "failed": 0}
    seen = set()
    for item in program or []:
        for ev in (item.get("secondary_events") or []):
            template = str(ev.get("template") or "").strip()
            text = str(ev.get("text") or "").strip()
            start, end = _se_event_window(ev)
            if not template or not text or end <= start:
                continue
            key = (template, text, int(round(end - start)))
            if key in seen:
                continue
            seen.add(key)
            dur = end - start
            # a .blend scene (with Blender) is preferred; otherwise the base
            # render or an uploaded TGA-sequence zip (which becomes the base).
            # Either is the cache fingerprint seed.
            seed = ""
            blend = _nnl_blend_path(channel_id, template)
            if blend and _find_blender_executable():
                seed = blend
            if not seed:
                seed = _nnl_base_mov_path(channel_id, template)
            if not seed:
                zp = _nnl_tga_zip_path(channel_id, template)
                if zp:
                    seed = _nnl_tga_base_mov(channel_id, template, zp)
            if not seed:
                seed = _nnl_default_base_mov(channel_id, template)
            if not seed:
                counts["missing_base"] += 1
                continue
            target = _nnl_mov_target(channel_id, template, text, dur, seed)
            if target.is_file():
                _nnl_bake_preview(str(target))
                counts["skipped"] += 1
                continue
            if _render_nnl_mov(channel_id, template, text, dur):
                counts["built"] += 1
            else:
                counts["failed"] += 1
    return counts


def _nnl_prebuild_task(channel_id: int, program: list):
    """Background task that pre-bakes missing NNL graphics (cache-safe), so
    playout Start does not block on the first ffmpeg bake."""
    async def _run():
        loop = asyncio.get_event_loop()
        try:
            counts = await loop.run_in_executor(
                None, _ensure_nnl_graphics, channel_id, program)
        except Exception as e:
            print(f"[nnl] channel {channel_id}: prebuild failed: {e}")
            return
        if counts.get("built") or counts.get("failed"):
            print(f"[nnl] channel {channel_id}: prebuild done - "
                  f"{counts['built']} baked, {counts['skipped']} cached, "
                  f"{counts['missing_base']} missing base, {counts['failed']} failed")
    return asyncio.create_task(_run())


def _compose_se_overlays(parts: list, prev: str, tail: str,
                         nnl_overlays: list, rw: int, rh: int) -> str:
    """Append the post-processing tail followed by timed NNL movie overlays
    onto the running video chain (``parts`` is the accumulator, ``prev`` the
    current label). NNL overlays are full-frame alpha MOVs revealed via
    ``enable=between()`` in clip-relative time; returns the last produced
    label."""
    if tail:
        parts.append(f"[{prev}]{tail}[v_se_c]")
        prev = "v_se_c"
    for k, ov in enumerate(nnl_overlays or []):
        mv = ov.get("path") or ""
        try:
            o_in = float(ov["in"])
            o_out = float(ov["out"])
        except (TypeError, ValueError, KeyError):
            continue
        if not mv or not os.path.isfile(mv) or o_out <= o_in:
            continue
        fade = max(0.0, min(float(_NNL_FADE_DEFAULT), (o_out - o_in) / 2.0))
        mchain = (
            # `format` is a filter, not a movie option: passing it as
            # `movie=...:format=rgba` makes ffmpeg abort with "Error applying
            # option 'format' to filter 'movie'", which killed every playout
            # spawn before a single HLS segment was written.
            f"movie=filename='{_escape_filter_path(mv)}',"
            f"setpts=PTS-STARTPTS,format=rgba,scale={rw}:{rh}"
        )
        if fade > 0.05:
            mchain += (
                f",fade=t=in:st=0:d={fade:.3f}:alpha=1"
                f",fade=t=out:st={max(0.0, (o_out - o_in) - fade):.3f}:d={fade:.3f}:alpha=1"
            )
        parts.append(f"{mchain}[v_nnl{k}]")
        enable_expr = f"between(t,{o_in:.3f},{o_out:.3f})"
        parts.append(f"[{prev}][v_nnl{k}]overlay=0:0:enable='{enable_expr}'[v_se{k + 1}]")
        prev = f"v_se{k + 1}"
    return prev


_TS_RE = None


def _shifted_srt(srt_path: str, offset: float) -> str:
    """Return path to a temp srt with all cue times shifted by -offset,
    so subtitles stay in sync when the clip is played from seek_in."""
    global _TS_RE
    if offset <= 0:
        return srt_path
    import re as _re
    import tempfile
    if _TS_RE is None:
        _TS_RE = _re.compile(r"(\d{2}):(\d{2}):(\d{2})[,.](\d{3})")

    def to_ms(h, m, s, ms):
        return ((int(h) * 60 + int(m)) * 60 + int(s)) * 1000 + int(ms)

    def fmt(ms):
        ms = max(0, int(ms))
        h, rem = divmod(ms, 3600000)
        m, rem = divmod(rem, 60000)
        s, ms = divmod(rem, 1000)
        return f"{h:02d}:{m:02d}:{s:02d},{ms:03d}"

    off = int(offset * 1000)
    out_lines = []
    block = []
    dropped_all = True

    with open(srt_path, "r", encoding="utf-8-sig", errors="replace") as f:
        for line in f.read().splitlines() + [""]:
            if line.strip():
                block.append(line)
                continue
            if block:
                times = _TS_RE.findall(block[1]) if len(block) > 1 else []
                if len(times) == 2:
                    start = to_ms(*times[0]) - off
                    end = to_ms(*times[1]) - off
                    if end > 0:
                        dropped_all = False
                        block[1] = _TS_RE.sub(
                            lambda m: fmt(to_ms(*m.groups()) - off), block[1]
                        )
                        out_lines.extend(block)
                block = []

    if dropped_all:
        return srt_path

    out = os.path.join(
        tempfile.gettempdir(),
        f"ffp_{Path(srt_path).stem}_{off}.srt",
    )
    with open(out, "w", encoding="utf-8") as f:
        f.write("\n".join(out_lines) + "\n")
    return out


# ---------------------------------------------------------------------------
# Subtitle → ASS conversion (burn-in)
#
# Burn-in relies on ffmpeg's libass `subtitles` filter, which only parses
# ASS/SSA (and the textual MRI formats). EBU STL (.stl) and winCAPS PAC
# (.pac) are binary broadcast subtitle formats that libass/ffmpeg cannot read
# directly, so we convert them (plus .srt/.vtt) to a shifted .ass file first
# and point the filter at that. The conversion also applies the per-clip seek
# offset so cue timings stay in sync with the playing position.
# ---------------------------------------------------------------------------

def _ffmpeg_convert_to_ass(src: str, out: str) -> bool:
    """Convert a subtitle file ffmpeg can read (.srt/.vtt/.ass/.ssa/text stl)
    to ASS. Returns True on success."""
    try:
        cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
               "-i", src, "-c:s", "ass", out]
        proc = subprocess.run(cmd, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=60)
        return proc.returncode == 0 and os.path.isfile(out)
    except Exception:
        return False


def _ass_from_cues(cues, play_res_x: int, play_res_y: int,
                   fontname: str = "DejaVu Sans", fontsize: int = 52,
                   alignment: int = 2) -> str:
    """Build an ASS document from (start_sec, end_sec, text) cues, using the
    given font family, font size and alignment (ASS v4+ Alignment code)."""
    lines = [
        "[Script Info]",
        "ScriptType: v4.00+",
        f"PlayResX: {play_res_x}",
        f"PlayResY: {play_res_y}",
        "ScaledBorderAndShadow: yes",
        "",
        "[V4+ Styles]",
        "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, "
        "BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, "
        "BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding",
        f"Style: Default,{fontname},{fontsize},&H00FFFFFF,&H000000FF,&H00000000,&H80000000,"
        f"-1,0,0,0,100,100,0,0,1,2,1,{alignment},20,20,20,1",
        "",
        "[Events]",
        "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text",
    ]
    for start, end, text in cues:
        def ts(sec):
            h = int(sec // 3600)
            m = int((sec % 3600) // 60)
            s = int(sec % 60)
            cs = int(round((sec - int(sec)) * 100))
            return f"{h:d}:{m:02d}:{s:02d}.{cs:02d}"
        text = text.replace("\n", "\\N") if text else ""
        lines.append(f"Dialogue: 0,{ts(start)},{ts(end)},Default,,0,0,0,,{text}")
    return "\n".join(lines) + "\n"


_STL_DIACRITICS = {
    0xC1: "\u0300",  # grave
    0xC2: "\u0301",  # acute
    0xC3: "\u0302",  # circumflex
    0xC4: "\u0303",  # tilde
    0xC5: "\u0304",  # macron
    0xC8: "\u0308",  # diaeresis / umlaut
    0xCA: "\u030A",  # ring above
    0xCB: "\u0327",  # cedilla
}


def _stl_text_decoder(tti: bytes):
    """Decode an EBU STL TTI text field into a unicode string. Handles the
    Latin character code table: ASCII range, Latin-1 extended bytes and the
    stateful floating diacritics (combining marks that follow the base char)."""
    out = []
    accent = None
    for b in tti:
        if b == 0x8A:          # line separator
            out.append("\n")
            continue
        if b == 0x8F:          # end-of-subtitle / padding
            break
        if 0x20 <= b <= 0x7E:  # ASCII printable
            ch = chr(b)
        elif 0xA0 <= b <= 0xFF:
            ch = _stl_extended_char(b)
        elif b in _STL_DIACRITICS:
            accent = _STL_DIACRITICS[b]
            continue
        else:
            continue
        if accent:
            ch += accent
            accent = None
        out.append(ch)
    if accent:
        out.append(accent)
    return "".join(out)


def _stl_extended_char(b: int) -> str:
    # Map the common STL Latin extended byte values to unicode. Freely based on
    # the EBU Tech 3264 character code table 00 (Latin); bytes we cannot map
    # fall back to their Latin-1 approximation.
    table = {
        0xA0: "\u00A0", 0xA1: "\u00A1", 0xA2: "\u00A2", 0xA3: "\u00A3",
        0xA4: "\u00A4", 0xA5: "\u00A5", 0xA6: "\u00A6", 0xA7: "\u00A7",
        0xA8: "\u00A8", 0xA9: "\u00A9", 0xAA: "\u00AA", 0xAB: "\u00AB",
        0xAC: "\u00AC", 0xAD: "\u00AD", 0xAE: "\u00AE", 0xAF: "\u00AF",
        0xB0: "\u00B0", 0xB1: "\u00B1", 0xB2: "\u00B2", 0xB3: "\u00B3",
        0xB4: "\u00B4", 0xB5: "\u00B5", 0xB6: "\u00B6", 0xB7: "\u00B7",
        0xB8: "\u00B8", 0xB9: "\u00B9", 0xBA: "\u00BA", 0xBB: "\u00BB",
        0xBC: "\u00BC", 0xBD: "\u00BD", 0xBE: "\u00BE", 0xBF: "\u00BF",
        0xD0: "\u00D0", 0xD1: "\u00D1", 0xD2: "\u00D2", 0xD3: "\u00D3",
        0xD4: "\u00D4", 0xD5: "\u00D5", 0xD6: "\u00D6", 0xD7: "\u00D7",
        0xD8: "\u00D8", 0xD9: "\u00D9", 0xDA: "\u00DA", 0xDB: "\u00DB",
        0xDC: "\u00DC", 0xDD: "\u00DD", 0xDE: "\u00DE", 0xDF: "\u00DF",
        0xE0: "\u00E0", 0xE1: "\u00E1", 0xE2: "\u00E2", 0xE3: "\u00E3",
        0xE4: "\u00E4", 0xE5: "\u00E5", 0xE6: "\u00E6", 0xE7: "\u00E7",
        0xE8: "\u00E8", 0xE9: "\u00E9", 0xEA: "\u00EA", 0xEB: "\u00EB",
        0xEC: "\u00EC", 0xED: "\u00ED", 0xEE: "\u00EE", 0xEF: "\u00EF",
        0xF0: "\u00F0", 0xF1: "\u00F1", 0xF2: "\u00F2", 0xF3: "\u00F3",
        0xF4: "\u00F4", 0xF5: "\u00F5", 0xF6: "\u00F6", 0xF7: "\u00F7",
        0xF8: "\u00F8", 0xF9: "\u00F9", 0xFA: "\u00FA", 0xFB: "\u00FB",
        0xFC: "\u00FC", 0xFD: "\u00FD", 0xFE: "\u00FE", 0xFF: "\u00FF",
    }
    return table.get(b, chr(b))


def _parse_ebu_stl(path: str, offset: float):
    """Parse an EBU STL (Tech 3264) subtitle file into (start, end, text) cues,
    shifting every cue by -offset. Detects the frame-rate from the GSI disk
    format code (STL25.01 / STL30.01) and reads the 128-byte TTI blocks."""
    with open(path, "rb") as f:
        data = f.read()
    if len(data) < 1024:
        return []
    gsi = data[:1024]
    if b"STL25.01" not in gsi[3:32] and b"STL30.01" not in gsi[3:32]:
        return []
    fps = 30.0 if b"STL30.01" in gsi[3:32] else 25.0

    n_blocks = (len(data) - 1024) // 128
    first_group_ttis = {}   # SN -> text accumulator for multi-block subtitles
    def bcd(b):
        return (b >> 4) * 10 + (b & 0x0F)

    def to_sec(h, m, s, fr):
        return (h * 3600 + m * 60 + s) + fr / fps

    for i in range(n_blocks):
        tti = data[1024 + i * 128: 1024 + (i + 1) * 128]
        if len(tti) < 128:
            break
        sn = (tti[1] << 8) | tti[2]
        ebn = tti[3]
        cf = tti[15]
        h_in, m_in, s_in, f_in = (bcd(tti[5]), bcd(tti[6]), bcd(tti[7]), bcd(tti[8]))
        h_out, m_out, s_out, f_out = (bcd(tti[9]), bcd(tti[10]), bcd(tti[11]), bcd(tti[12]))
        start = max(0.0, to_sec(h_in, m_in, s_in, f_in) - offset)
        end = max(0.0, to_sec(h_out, m_out, s_out, f_out) - offset)
        if end <= 0:
            continue
        if cf & 0x01:
            continue  # comment block, not transmitted
        text = _stl_text_decoder(tti[16:]).strip("\n ").replace("\x00", "")
        if ebn == 0xFE:
            continue  # user data block
        # Multi-block subtitles share the same SN; only the first block has
        # timing, extension blocks carry extra text. Accumulate text by SN.
        if sn in first_group_ttis:
            first_group_ttis[sn][0].append(text)
        else:
            first_group_ttis[sn] = ([text], start, end)
    cues: list = []
    for sn, (parts, start, end) in first_group_ttis.items():
        full = "\\N".join(p for p in parts if p)
        if full:
            cues.append((start, end, full))
    cues.sort(key=lambda c: c[0])
    return cues


def _parse_pac(path: str, offset: float):
    """Parse a winCAPS PAC subtitle file into (start, end, text) cues, shifting
    every cue by -offset. Best-effort: returns [] when the file doesn't look
    like a PAC file."""
    with open(path, "rb") as f:
        data = f.read()
    if len(data) < 16 or data[0] not in (0x01, 0x02):
        return []
    data_off = int.from_bytes(data[1:3], "little")
    if data_off <= 0 or data_off >= len(data):
        return []
    cues = []
    i = data_off
    cur_start = 0.0
    cur_text = []
    while i < len(data):
        b = data[i]
        i += 1
        if b == 0x00:
            continue
        if b == 0xFF:  # end of subtitle frame
            if cur_text:
                cues.append((cur_start, cur_start + 4.0, "".join(cur_text).strip()))
            cur_text = []
            continue
        if b == 0x0F:  # timing/frame header
            if i + 4 <= len(data):
                hour = data[i]
                minute = data[i + 1]
                second = data[i + 2]
                centi = data[i + 3]
                i += 4
                cur_start = max(0.0, (hour * 3600 + minute * 60 + second) + centi / 100.0 - offset)
                # read a length byte + text run
                if i < len(data):
                    ln = data[i]
                    i += 1
                    if i + ln <= len(data):
                        cur_text.append(data[i:i + ln].decode("latin-1"))
                        i += ln
            continue
        # plain characters (latin-1)
        cur_text.append(chr(b))
    return cues


def _subtitle_to_ass(sub_path: str, seek_in: float,
                     play_res: tuple[int, int] = (1920, 1080),
                     fontname: str = "DejaVu Sans", fontsize: int = 52,
                     alignment: int = 2) -> str:
    """Convert a subtitle file at sub_path to a shifted .ass temp file for
    burn-in, applying the given font family, font size and alignment.
    Returns the .ass path, or "" on failure."""
    import tempfile
    p = Path(sub_path)
    ext = p.suffix.lower()
    pw, ph = play_res
    _sweep_stale_burn_ass()
    # The burn .ass path must be unique per (clip, offset). The playout loop
    # rebuilds it on every spawn, and with a shared path the rebuild deletes
    # the file while the previous ffmpeg is still alive. libass opens the
    # subtitle file when the filter graph initialises, so the in-flight ffmpeg
    # dies instantly with "Unable to open ... .ass" and the loop respawns
    # forever, never emitting a segment. Writing to a private .part file and
    # atomically renaming also stops libass ever seeing a half-written file.
    out = os.path.join(tempfile.gettempdir(),
                       f"ffp_{p.stem}_{seek_in:g}_burn.ass")
    # The scratch file must keep the .ass extension: ffmpeg picks its muxer
    # from the suffix, so "....ass.part" fails with "Unable to find a suitable
    # output format" and the caller silently falls back to burning the raw
    # .srt, losing PlayRes/font-size/alignment styling.
    part = f"{out[:-len('.ass')]}.{os.getpid()}.part.ass"

    def _finish() -> str:
        """Atomically publish the .part file as the final .ass."""
        try:
            os.replace(part, out)
        except OSError:
            return ""
        return out

    if ext in (".srt", ".vtt"):
        shifted = _shifted_srt(str(p), seek_in)
        if _ffmpeg_convert_to_ass(shifted, part):
            return _apply_ass_style(_fix_ass_playres(part, pw, ph),
                                    fontname, fontsize, alignment) and _finish()
        return ""

    if ext in (".stl", ".stl2"):
        cues = _parse_ebu_stl(str(p), seek_in)
    elif ext == ".pac":
        cues = _parse_pac(str(p), seek_in)
    elif ext in (".ass", ".ssa"):
        # no binary parsing; offset shifting of ASS is skipped (rare)
        return _apply_ass_style(str(p), fontname, fontsize, alignment)
    else:
        # let ffmpeg try any other text subtitle it may understand
        if _ffmpeg_convert_to_ass(str(p), part):
            return _apply_ass_style(_fix_ass_playres(part, pw, ph),
                                    fontname, fontsize, alignment) and _finish()
        return ""

    if not cues:
        return ""
    _write_ass(part, _ass_from_cues(cues, pw, ph, fontname, fontsize, alignment))
    return _finish()


_burn_ass_sweep_counter = 0


def _sweep_stale_burn_ass(max_age: float = 3600.0) -> None:
    """Drop long-dead burn-in .ass temp files so /tmp cannot grow without
    bound. Only files older than max_age are removed, so a concurrent
    ffmpeg is never left without the subtitle it is currently reading."""
    global _burn_ass_sweep_counter
    _burn_ass_sweep_counter += 1
    if _burn_ass_sweep_counter % 200:
        return
    import glob
    import tempfile
    import time
    cutoff = time.time() - max_age
    for pat in ("ffp_*_burn.ass", "ffp_*_burn.*.part.ass", "ffp_*_[0-9]*.srt"):
        for path in glob.glob(os.path.join(tempfile.gettempdir(), pat)):
            try:
                if os.path.getmtime(path) < cutoff:
                    os.remove(path)
            except OSError:
                pass


def _fix_ass_playres(ass_path: str, w: int, h: int) -> str:
    """Adjust PlayResX/PlayResY in a converted ASS so text scales to the real
    frame size. Works in place and returns the path."""
    try:
        with open(ass_path, "r", encoding="utf-8", errors="replace") as f:
            text = f.read()
        text = re.sub(r"^PlayResX:.*$", f"PlayResX: {w}", text, flags=re.M)
        text = re.sub(r"^PlayResY:.*$", f"PlayResY: {h}", text, flags=re.M)
        with open(ass_path, "w", encoding="utf-8") as f:
            f.write(text)
    except Exception:
        pass
    return ass_path


def _write_ass(ass_path: str, content: str) -> None:
    with open(ass_path, "w", encoding="utf-8") as f:
        f.write(content)


def _apply_ass_style(ass_path: str, fontname: str, fontsize: int,
                     alignment: int) -> str:
    """Rewrite the Default style of an existing ASS file to use the given font
    family, font size and alignment. Works in place and returns the path."""
    try:
        with open(ass_path, "r", encoding="utf-8", errors="replace") as f:
            text = f.read()
        # Style: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, ...
        def _fix(m):
            parts = m.group(0).split(",")
            # parts[0] = "Style: Default", parts[1] = Fontname, parts[2] = Fontsize
            parts[0] = parts[0].split(":")[0] + ": Default"
            if len(parts) > 1:
                parts[1] = fontname
            if len(parts) > 2:
                parts[2] = str(fontsize)
            # Alignment is the 3rd last column of the v4+ style
            if len(parts) >= 23 and parts[0].strip().endswith("Default"):
                parts[-4] = str(alignment)
            return ",".join(parts)
        text = re.sub(r"^Style:\s*Default\b.*$", _fix, text, flags=re.M)
        with open(ass_path, "w", encoding="utf-8") as f:
            f.write(text)
    except Exception:
        pass
    return ass_path


def _build_ffmpeg_inputs_and_maps(
    channel_id: int, source: str, seek_in: float, duration: float,
    item: dict | None = None, variant_scale: tuple[int, int] | None = None,
    skip_logo: bool = False,
) -> tuple[list[str], list[str], list[str]]:
    pcfg = _get_playout_config(channel_id)
    proc = pcfg.get("processing", {})
    add_logo = proc.get("add_logo", False) and not skip_logo
    logo = proc.get("logo", "") if not skip_logo else ""
    logo_scale = proc.get("logo_scale", "") if not skip_logo else ""

    input_args = [
        "-ss", str(seek_in),
        "-t", str(duration),
        "-i", source,
    ]

    logo_path = ""
    if add_logo and logo:
        lp = _resolve_logo_path(channel_id, logo)
        if lp:
            logo_path = lp
            # Animating/video logos (webm/mov/mp4 etc.) must loop: prepend an
            # infinite stream_loop so the short logo keeps playing for the whole
            # duration of the overlay intersection. Static images need no loop.
            logo_suffix = Path(logo).suffix.lower()
            if logo_suffix in {".webm", ".mov", ".mp4", ".m4v", ".avi", ".mkv", ".gif"}:
                input_args += ["-stream_loop", "-1"]
            input_args += ["-i", logo_path]

    # persistent graphic overlay (e.g. a channel "bug"): a processed alpha MOV
    # selected in the graphics settings. Loops for the whole clip like the logo.
    graphic_enable, graphic_path, graphic_position, graphic_scale_pct, graphic_fade_expr = _graphic_overlay_config(channel_id)
    if graphic_enable and graphic_path:
        input_args += ["-stream_loop", "-1"]
        input_args += ["-i", graphic_path]

    # --- subtitle source resolution --------------------------------
    # The subtitle can come from three places, in priority order:
    #   1. an explicit, configurable subtitle file (processing.subtitle)
    #   2. a sidecar next to the clip / in the channel subtitles folder,
    #      matched by basename (.srt / .stl / .pac)
    #   3. the configured VTT dummy (subtitles/dummy.vtt)
    # A .srt / .vtt is additionally exposed as a soft WebVTT track in HLS;
    # the binary .stl / .pac formats can only be burned in (see cc_args below).
    proc_subtitle = (proc.get("subtitle") or "").strip()
    sub_path = ""
    if proc_subtitle:
        cand = _get_channel_storage(channel_id) / proc_subtitle.lstrip("/\\")
        if cand.is_file():
            sub_path = str(cand)
    if not sub_path:
        sub_path = _find_sidecar_subtitle(channel_id, source)
    if not sub_path:
        vtt_dummy = str(_get_channel_storage(channel_id) / "subtitles" / "dummy.vtt")
        if os.path.isfile(vtt_dummy):
            sub_path = vtt_dummy

    # soft WebVTT track: only textual formats ffmpeg can re-mux to webvtt,
    # and only when the channel has WebVTT output enabled (processing.vtt_enable).
    # The Rust engine gates the same way: it drops the vtt/dummy input and its
    # `{i}:s?` map entirely when the flag is off.
    srt_path = ""
    if bool(proc.get("vtt_enable", False)) and sub_path and \
            Path(sub_path).suffix.lower() in (".srt", ".vtt"):
        srt_path = _shifted_srt(sub_path, seek_in)
        input_args += ["-i", srt_path]

    pargs = _build_processing_args(channel_id)
    v_pre = pargs["v_pre"]
    v_post = pargs["v_post"]
    a_filters = pargs["a_filters"]
    logo_filters = pargs["logo_filters"]
    logo_position = pargs["logo_position"]
    has_overlay = pargs["has_overlay"]

    # For an ABR HLS rendition, rescale the base processing graph to the
    # variant's target resolution: replace the scale+pad steps (which pad to
    # the configured production width x height) with the variant's size. The
    # logo overlay and everything downstream stays untouched. The base fps
    # step is kept (already the first entry of v_pre) so timing is preserved.
    if variant_scale is not None:
        vw, vh = variant_scale
        # keep fps=<...> if the base chain had it, then variant scale+pad
        base_fps = [f for f in v_pre if f.startswith("fps=")]
        v_pre = (
            base_fps
            + [f"scale={vw}:{vh}:force_original_aspect_ratio=decrease",
               f"pad={vw}:{vh}:(ow-iw)/2:(oh-ih)/2",
               "setsar=1"]
        )
        # scale the logo proportionally so it keeps a consistent fraction of
        # the frame across every ABR rendition
        base_width = proc.get("width", 1920)
        base_logo_h = _logo_base_height(channel_id, logo, logo_scale, base_width)
        if has_overlay and logo_path and base_width:
            logo_filters = _variant_logo_filters(
                logo_filters, base_logo_h, base_width, vw)

    # Burn (hardsub) the subtitle onto the video when enabled. libass by
    # default scans the whole Windows Fonts folder (C:\Windows\Fonts, full of
    # broken .fon files) which freezes ffmpeg before the muxer writes its first
    # playlist/segment, so the `subtitles` filter always gets an explicit
    # `fontsdir` pointing at the channel's subtitles asset folder. .stl/.pac
    # are binary broadcast formats that libass cannot read directly, so they
    # are converted to a shifted .ass first (see _subtitle_to_ass). When burn
    # is disabled, textual formats still ride as a soft WebVTT track.
    burn_subtitles = bool(proc.get("burn_subtitles", False))
    if burn_subtitles and sub_path:
        play_res = (int(proc.get("width", 1920)), int(proc.get("height", 1080)))
        sub_font = (proc.get("subtitle_font") or "").strip() or "DejaVu Sans"
        sub_size = int(proc.get("subtitle_fontsize", 52) or 52)
        sub_align = int(proc.get("subtitle_position", 2) or 2)
        burn_file = _subtitle_to_ass(sub_path, seek_in, play_res,
                                     sub_font, sub_size, sub_align)
        if not burn_file:
            # fall back to the raw file; the subtitles filter may still handle
            # textual inputs even if the ASS conversion failed
            burn_file = sub_path
        # Point libass at the channel's text asset folder, which holds the
        # real font files (text/DejaVuSans.ttf etc.). The subtitles folder
        # holds the .srt/.vtt cue files, which are not fonts and only produce
        # "Error opening memory font" noise (and would make libass scan them).
        cache_dir = (_get_channel_storage(channel_id) / "text")
        if not cache_dir.is_dir():
            cache_dir = (_get_channel_storage(channel_id) / "subtitles")
        burn = f"subtitles=filename={_escape_sub_filter_path(burn_file)}"
        if cache_dir.is_dir():
            burn += f":fontsdir={_escape_sub_filter_path(str(cache_dir))}"
        v_post.append(burn)

    filter_complex_parts = []
    map_args = []

    audio_track_index = proc.get("audio_track_index", 0)

    # timed secondary event overlays (NOW/NEXT/LATER lower thirds etc.)
    se_filters, nnl_overlays = _secondary_event_filters(channel_id, item)
    render_width = (variant_scale[0] if variant_scale
                    else int(proc.get("width", 1920)))
    render_height = (variant_scale[1] if variant_scale
                     else int(proc.get("height", 1080)))

    # Build the ordered list of always-on overlay inputs (logo first, then the
    # graphic bug), each chained onto the running video via its own overlay.
    overlays = []
    if has_overlay and logo_path:
        overlays.append((1, logo_filters, logo_position))

    # A graphic may be an L-band-style full-frame overlay whose alpha has a
    # rectangular "video hole" (sidecar). When it is, the main video is scaled
    # into that rectangle and the graphic is drawn over the whole frame so the
    # run shows through the hole while the L-band fills the rest. Otherwise the
    # graphic is a normal bug: sized relative to THIS rendition's video
    # resolution (proportional below 100%, exact frame fill at 100%) so a bug
    # keeps a consistent fraction of the frame on every output.
    graphic_squeeze = None
    if graphic_enable and graphic_path:
        graphic_input_idx = 1 + (1 if logo_path else 0)
        render_width = (variant_scale[0] if variant_scale else int(proc.get("width", 1920)))
        render_height = (variant_scale[1] if variant_scale else int(proc.get("height", 1080)))
        graphic_squeeze = _load_squeeze_info(graphic_path)
        if not graphic_squeeze:
            try:
                gfx_pct = float(graphic_scale_pct)
            except (TypeError, ValueError):
                gfx_pct = 100.0
            gfx_pos = graphic_position
            if gfx_pct < 100.0:
                gw = max(8, int(round(render_width * gfx_pct / 100.0)))
                gfx_scale = f"scale={gw}:-2"
            else:
                gfx_scale = f"scale={render_width}:{render_height}"
                gfx_pos = "0:0"
            gfx_fade = graphic_fade_expr or ""
            overlays.append((graphic_input_idx, [f"format=rgba,{gfx_scale}{gfx_fade}"], gfx_pos))

    if overlays or graphic_squeeze:
        main_chain = ",".join(v_pre) if v_pre else "null"
        post_chain = ",".join(v_post) if v_post else ""
        render_width = (variant_scale[0] if variant_scale else int(proc.get("width", 1920)))
        render_height = (variant_scale[1] if variant_scale else int(proc.get("height", 1080)))

        parts = [f"[0:v]{main_chain}[v_main]"]
        prev = "v_main"
        for i, (idx, flt, pos) in enumerate(overlays):
            chain = ",".join(flt) if flt else "null"
            fg = f"v_fg{i}"
            stg = f"v_stg{i}"
            parts.append(f"[{idx}:v]{chain}[{fg}]")
            parts.append(f"[{prev}][{fg}]overlay={pos}[{stg}]")
            prev = stg

        if graphic_squeeze:
            done = "v_sq_done"
            fps = int(proc.get("fps", 25) or 25)

            # Aston / L-band graphics are composited at a fixed 1920x1080 HD
            # master so SD-native 720x576 graphics are crisply scaled into the
            # HD frame, then the composed result is downscaled to each rendition.
            # PTS-based timing (t) with smoothstep easing; a graph rebuilt
            # mid-transition resumes from the current progress instead of
            # snapping back.
            sq_w, sq_h = 1920, 1080

            pre_tail = ",".join(([post_chain] if post_chain else []) + se_filters)
            if pre_tail or nnl_overlays:
                prev = _compose_se_overlays(parts, prev, pre_tail, nnl_overlays,
                                            render_width, render_height)

            # Upscale running video into the HD master canvas
            parts.append(
                f"[{prev}]scale={sq_w}:{sq_h}:force_original_aspect_ratio=decrease,"
                f"pad={sq_w}:{sq_h}:(ow-iw)/2:(oh-ih)/2:color=black,setsar=1"
                f"[v_sq_master]"
            )
            prev = "v_sq_master"

            phase, p0, fade_dur = _squeeze_fade_state(channel_id)
            gfx_chain = f"format=rgba,scale={sq_w}:{sq_h}"
            if phase == "in":
                gfx_chain += f",fade=t=in:st=0:d={max(fade_dur * (1 - p0), 0.05):.3f}:alpha=1"
            elif phase == "out":
                gfx_chain += f",fade=t=out:st=0:d={max(fade_dur * (1 - p0), 0.05):.3f}:alpha=1"

            sq_y = graphic_squeeze.get("y", 0) or 0
            raise_dur = min(max(20.0 / fps, 0.4), 1.2)
            pr = min(p0 * fade_dur / raise_dur, 1.0) if fade_dur > 0 else 0.0

            if sq_y > 0:
                # Aston lower-third: program squashes upward, keeping the top
                # axis fixed.  In the sidecar's native 720x576 space the video
                # height goes from 576 to 476 (frac ~= 0.8264).
                fh = int(graphic_squeeze.get("frame_height") or 576) or 576
                frac = 476.0 / max(fh, 1)
                if phase == "on":
                    h_expr = f"{sq_h}*{frac:.6f}"
                elif phase == "in":
                    lp = f"min(({pr:.6f}+t)/{raise_dur:.6f},1)"
                    eased = f"{lp}*{lp}*(3-2*{lp})"
                    h_expr = f"{sq_h}*(1-{1 - frac:.6f}*({eased}))"
                else:
                    rem = f"max({max(1.0 - pr, 0.0):.6f}-t/{raise_dur:.6f},0)"
                    eased = f"{rem}*{rem}*(3-2*{rem})"
                    h_expr = f"{sq_h}*(1-{1 - frac:.6f}*({eased}))"
                parts.append(
                    f"[{prev}]scale=w={sq_w}:h='{h_expr}':eval=frame,"
                    f"format=rgb24,pad={sq_w}:{sq_h}:0:0:color=black"
                    f"[v_sq_layered]"
                )
                prev = "v_sq_layered"
            else:
                # L-band corner squeeze: in the native 720x576 frame the video
                # rect shrinks from {0,0,720,576} to {180,60,540,410} over
                # ~20 frames.  Mapped to HD master (1920x1080) the final
                # fractions are: xf=0.25, yf=0.1042, wf=0.75, hf=0.7118.
                # Mechanism: scale (animated w,h) -> pad (static 0:0, video
                # top-left, black border) -> overlay onto a static black canvas
                # at animated (x,y) — the overlay secondary is constant-size
                # so per-frame eval on x/y works.
                fw = int(graphic_squeeze.get("frame_width") or 720) or 720
                fh = int(graphic_squeeze.get("frame_height") or 576) or 576
                xf = 180.0 / fw   # 0.25
                yf = 60.0 / fh    # 0.1042
                wf = 540.0 / fw   # 0.75
                hf = 410.0 / fh   # 0.7118

                if phase == "on":
                    s_expr = "1"
                elif phase == "in":
                    lp = f"min(({pr:.6f}+t)/{raise_dur:.6f},1)"
                    s_expr = f"({lp})*({lp})*(3-2*({lp}))"
                else:
                    rem = f"max({max(1.0 - pr, 0.0):.6f}-t/{raise_dur:.6f},0)"
                    s_expr = f"({rem})*({rem})*(3-2*({rem}))"

                w_expr = f"{sq_w}*(1-{1 - wf:.6f}*({s_expr}))"
                h_expr = f"{sq_h}*(1-{1 - hf:.6f}*({s_expr}))"
                parts.append(
                    f"[{prev}]scale=w='{w_expr}':h='{h_expr}':eval=frame,"
                    f"format=rgb24,pad={sq_w}:{sq_h}:0:0:color=black[v_lb_pad]"
                )
                x_expr = f"{sq_w}*{xf:.6f}*({s_expr})"
                y_expr = f"{sq_h}*{yf:.6f}*({s_expr})"
                parts.append(
                    f"color=c=black:s={sq_w}x{sq_h}:r={fps}[v_lb_bg]"
                )
                parts.append(
                    f"[v_lb_bg][v_lb_pad]overlay='{x_expr}':'{y_expr}'"
                    f":eval=frame[v_sq_layered]"
                )
                prev = "v_sq_layered"

            parts.append(f"[{graphic_input_idx}:v]{gfx_chain}[gfx_sq]")
            parts.append(f"[{prev}][gfx_sq]overlay=0:0[{done}]")
            prev = done

            # Scale the HD composite back to this rendition's resolution
            if (render_width, render_height) != (sq_w, sq_h):
                parts.append(
                    f"[{done}]scale={render_width}:{render_height}"
                    f":force_original_aspect_ratio=decrease,"
                    f"pad={render_width}:{render_height}"
                    f":(ow-iw)/2:(oh-ih)/2:color=black,setsar=1[v_sq_ds]"
                )
                prev = "v_sq_ds"
            post_chain = ""
            se_filters = []
            nnl_overlays = []

        if post_chain or se_filters or nnl_overlays:
            tail = ",".join(([post_chain] if post_chain else []) + se_filters)
            prev = _compose_se_overlays(parts, prev, tail, nnl_overlays,
                                        render_width, render_height)
            parts.append(f"[{prev}]null[v_out]")
        else:
            parts.append(f"[{prev}]null[v_out]")
        filter_complex_parts.append(";".join(parts))
        map_args += ["-map", "[v_out]"]
    elif v_pre or v_post or se_filters or nnl_overlays:
        all_v = v_pre + v_post
        all_v.extend(se_filters)
        first = ",".join(all_v) if all_v else "null"
        if nnl_overlays:
            parts = [f"[0:v]{first}[v_se_base]"]
            prev = _compose_se_overlays(parts, "v_se_base", "", nnl_overlays,
                                        render_width, render_height)
            parts.append(f"[{prev}]null[v_out]")
            filter_complex_parts.append(";".join(parts))
        else:
            filter_complex_parts.append(f"[0:v]{first}[v_out]")
        map_args += ["-map", "[v_out]"]
    else:
        map_args += ["-map", "0:v:0"]

    if a_filters:
        filter_complex_parts.append(f"[0:a:{audio_track_index}]{','.join(a_filters)}[a_out]")
        map_args += ["-map", "[a_out]"]
    else:
        map_args += ["-map", f"0:a:{audio_track_index}"]

    if filter_complex_parts:
        map_args = ["-filter_complex", ";".join(filter_complex_parts)] + map_args

    # closed caption track args (WebVTT in HLS); input index after source/logo/graphic
    cc_args = []
    if srt_path:
        srt_input_idx = 1 + (1 if logo_path else 0) + (1 if (graphic_enable and graphic_path) else 0)
        cc_args = ["-map", f"{srt_input_idx}:s", "-c:s", "webvtt"]

    # the logo is already added as input via "-i logo_path" above,
    # appending anything else here would be parsed as an output file by ffmpeg
    return input_args, map_args, cc_args


SCTE35_PID = 768  # 0x300, dedicated SCTE-35 data pid in the udp mpegts output


AD_CATEGORIES = {"advertisement", "ad", "ads", "commercial", "spot", "promo"}


def _is_ad_clip(source: str, item: dict | None = None) -> bool:
    """True for ad clips that get SCTE-35 splice_insert + time_signal markers.

    Two signals mark an ad break:
      * the playlist item category ("advertisement"), which is how a real
        schedule flags breaks, and
      * a filename stem starting with "adslate" (Adslate.mp4/.mxf/.ts ...),
        which is the fallback for hand-built test schedules.

    Checking only the filename meant that every ad clip whose asset happened
    to be named after the programme (a real ingest does that: the break is
    category=advertisement on an ordinary .ts) silently produced no SCTE at
    all, so the markers never reached the udp output.
    """
    if isinstance(item, dict):
        cat = str(item.get("category") or "").strip().lower()
        if cat in AD_CATEGORIES:
            return True
        if item.get("adslate"):
            return True
    p = Path(source)
    return p.stem.lower().startswith("adslate") and p.suffix.lower() in {
        ".mp4", ".mxf", ".mov", ".mpg", ".mpeg", ".ts"
    }


# ---------------------------------------------------------------------------
# Auto-preprocess: transcode media files into <storage>/media/process/*.ts
# ---------------------------------------------------------------------------

def _resolve_process_dir(channel_id: int) -> Path:
    """Return the directory that holds the preprocessed .ts files.

    The canonical layout is <storage>/media/process. When the channel
    storage path is itself a process directory (older / misconfigured
    setups), the storage path is used as the process directory directly, so
    a nested media/process below it is never created again.
    """
    storage = _get_channel_storage(channel_id)
    if storage.name.lower() == "process":
        return storage
    return storage / "media" / "process"


def _preprocess_dir(channel_id: int) -> Path:
    """Return the process directory for the channel."""
    return _resolve_process_dir(channel_id)


def _preprocessed_path(channel_id: int, source: str) -> Path | None:
    """Map a source file to its preprocessed .ts target.

    <storage>/media/subdir/file.mp4 -> <storage>/media/process/subdir/file.ts

    A source already living inside the process directory maps to itself, and
    a .ts that sits directly under media/ is kept in place - so a stray
    nested 'media/process' inside the process folder is never produced.
    """
    storage = _get_channel_storage(channel_id)
    process_dir = _resolve_process_dir(channel_id)

    # already inside the process dir (e.g. a processed .ts referenced by the
    # playlist) -> keep the file in place, no re-nesting
    try:
        rel = Path(source).resolve().relative_to(process_dir.resolve())
        return process_dir.joinpath(*rel.parts).with_suffix(".ts")
    except ValueError:
        pass

    try:
        rel = Path(source).relative_to(storage)
    except ValueError:
        return None

    parts = list(rel.parts)
    if not parts:
        return None

    # a source already under media/process is left where it is
    if parts[0].lower() == "media" and len(parts) >= 2 and parts[1].lower() == "process":
        return storage.joinpath(*parts).with_suffix(".ts")

    # otherwise map <storage>/media/... into <storage>/media/process/...
    if parts[0].lower() == "media":
        parts = ["media", "process"] + parts[1:]
    else:
        parts = ["media", "process"] + parts

    target = storage.joinpath(*parts).with_suffix(".ts")
    return target


def _resolve_source(channel_id: int, source: str) -> str:
    """Return preprocessed .ts path if it exists, otherwise original source."""
    target = _preprocessed_path(channel_id, source)
    if target and target.is_file():
        return str(target)
    return source


def _get_process_extensions() -> list[str]:
    """Extensions eligible for preprocessing (skip .ts which is already standard)."""
    return ["mp4", "mxf", "mpg", "mov", "mpeg", "mkv", "avi", "wmv", "flv", "m4v"]


# ---------------------------------------------------------------------------
# Animated channel logo: convert a zip of TGA frames (with alpha) into a
# looping alpha-capable WebM placed in <storage>/media/process/logo/.
# ---------------------------------------------------------------------------

_ANIMATED_LOGO_LOGO_DIR = "logo"


def _animated_logo_source(channel_id: int) -> str:
    """Absolute path of the animated logo zip (sequence of .tga frames with
    alpha), or ``""`` when the channel has none.

    A zipped logo configured in the playout processing config is preferred;
    otherwise common ``logo`` folders are scanned for a ``.zip``. Decoupled
    from the static ``logo.png`` used for the playout overlay itself.
    """
    pcfg = _get_playout_config(channel_id)
    proc = pcfg.get("processing", {}) or {}
    logo = proc.get("logo", "")
    storage = _get_channel_storage(channel_id)

    # candidate zip files: the configured one wins, otherwise the most
    # recently uploaded zip in any of the likely logo folders.
    if str(logo).lower().endswith(".zip") and (storage / logo).is_file():
        return str(storage / logo).replace("\\", "/")

    best = None
    for folder in _logo_candidate_folders(storage):
        if not folder.is_dir():
            continue
        for f in folder.iterdir():
            if f.suffix.lower() == ".zip":
                try:
                    mtime = f.stat().st_mtime
                except OSError:
                    mtime = 0
                if best is None or mtime > best[0]:
                    best = (mtime, f)
    if best:
        return str(best[1]).replace("\\", "/")
    return ""


def _logo_candidate_folders(storage: Path):
    """Possible locations of the channel's ``logo`` folder for zip archives."""
    seen = set()
    out = []
    for cand in (
        storage / "logo",
        storage / "media" / "logo",
        storage.parent / "logo",
        storage.parent.parent / "logo",
    ):
        key = str(cand.resolve()) if cand.exists() else str(cand)
        if key not in seen:
            seen.add(key)
            out.append(cand)
    return out


def _animated_logo_dir(channel_id: int) -> Path:
    """Directory holding the processed animated logo outputs (mov files)."""
    return _resolve_process_dir(channel_id) / _ANIMATED_LOGO_LOGO_DIR


def _animated_logo_target(channel_id: int, zip_path: str) -> Path:
    return _animated_logo_dir(channel_id) / f"{Path(zip_path).stem}.mov"


def _tga_entry_index(zip_path: str) -> list:
    """Return the sorted list of (frame_index, zip_entry_name) for the .tga
    frames in a zip archive. Only the archive central directory is read, so
    this is cheap even for very large frame dumps."""
    import zipfile as _zipfile
    with _zipfile.ZipFile(zip_path) as zf:
        entries = []
        for n in zf.namelist():
            if n.lower().endswith(".tga"):
                m = re.search(r"(\d+)(?=\.tga$)", n, re.IGNORECASE)
                key = int(m.group(1)) if m else 0
                entries.append((key, n))
        entries.sort(key=lambda t: t[0])
    return entries


def _read_tga(zip_path: str, entry: str) -> bytes:
    import zipfile as _zipfile
    with _zipfile.ZipFile(zip_path) as zf:
        return zf.read(entry)


def _extract_animated_logo_frames(channel_id: int, zip_path: str, window_ms: int = 16000) -> str:
    """Extract the TGA frames for the first ``window_ms`` of the animation into
    a temp dir as ``frame_%06d.tga`` and return that dir.

    Only the frames that differ (the loop window) are written, so the resulting
    webm is tight. Targets a max window so long/static tails are not encoded.
    """
    import tempfile
    entries = _tga_entry_index(zip_path)
    n = len(entries)
    if n == 0:
        raise RuntimeError("no .tga frames found in logo archive")

    loop = _find_loop_boundary(zip_path, entries, window_ms)
    if loop is None:
        # no exact repeat within the window: cap at the window, else all frames
        window_frames = max(16, int(window_ms / 40.0))
        loop = window_frames

    loop = max(16, min(loop, n))
    outdir = tempfile.mkdtemp(prefix=f"logo_{channel_id}_")
    for i in range(loop):
        entry = entries[i][1]
        with open(os.path.join(outdir, f"frame_{i:06d}.tga"), "wb") as f:
            f.write(_read_tga(zip_path, entry))
    return outdir


def _decode_framemd5(paths) -> list[str]:
    """Decode the list of tga files via a concat demuxer and return the framemd5
    (framemd5) of each frame, in order. Returns [] on any failure."""
    concat_list = None
    try:
        import tempfile as _tf
        fd, concat_list = _tf.mkstemp(suffix=".txt", prefix="ffp_concat_")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            for p in paths:
                f.write("file '%s'\n" % p.replace("\\", "/"))
        p = subprocess.run(
            [FFMPEG_BIN, "-hide_banner", "-loglevel", "error",
             "-f", "concat", "-safe", "0", "-i", concat_list,
             "-f", "framemd5", "-"],
            capture_output=True, text=True, timeout=120,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
        if p.returncode != 0:
            return []
        md5s = []
        for ln in p.stdout.splitlines():
            if not ln.startswith("0,"):
                continue
            fields = [x.strip() for x in ln.split(",")]
            if len(fields) >= 6:
                md5s.append(fields[5])
        return md5s
    except Exception:
        return []
    finally:
        if concat_list:
            try:
                os.unlink(concat_list)
            except OSError:
                pass


def _find_loop_boundary(zip_path: str, entries: list, window_ms: int):
    """Find the frame index at which the animation repeats frame 0 (the loop
    end) by comparing decoded framemd5 hashes. Returns None if no exact repeat
    is found within the first ``window`` frames."""
    import tempfile, shutil as _shutil
    n = len(entries)
    if n == 0:
        return None
    window_frames = max(2, int(window_ms / 40.0))  # 40ms/frame @25fps estimate
    window_frames = min(window_frames, n)

    td = tempfile.mkdtemp(prefix="ffp_loopscan_")
    try:
        # coarse probe every ~0.4s to skip a long static tail cheaply
        coarse = list(range(0, window_frames, 10))
        coarse_paths = []
        idx_map = []
        for ci in coarse:
            p = os.path.join(td, f"c_{ci}.tga")
            with open(p, "wb") as f:
                f.write(_read_tga(zip_path, entries[ci][1]))
            coarse_paths.append(p)
            idx_map.append(ci)
        md5s = _decode_framemd5(coarse_paths)
        if not md5s:
            return None
        base = md5s[0]
        matches = [idx_map[k] for k, m in enumerate(md5s) if m == base and idx_map[k] > 0]
        if matches:
            cand = matches[len(matches) // 2]
            # dense scan the frames just before cand to land on the true boundary
            lo = max(0, cand - 13)
            dense = list(range(lo, min(cand + 2, n)))
            dense_paths = [os.path.join(td, f"d_{di}.tga") for di in dense]
            for di, dp in zip(dense, dense_paths):
                with open(dp, "wb") as f:
                    f.write(_read_tga(zip_path, entries[di][1]))
            dmd5 = _decode_framemd5(dense_paths)
            if dmd5:
                first_match = None
                for di, m in zip(dense, dmd5):
                    if m == base:
                        first_match = di
                        break
                if first_match is not None:
                    return first_match
        return None
    finally:
        _shutil.rmtree(td, ignore_errors=True)


def _process_animated_logo_sync(channel_id: int, zip_path: str) -> dict:
    """Synchronously turn a TGA zipped animation into a looping alpha ProRes
    4444 MOV (the same MOV the playout overlay is configured to use).

    On success the channel's playout ``processing.logo`` is repointed to the
    newly produced MOV so HLS/UDP output shows the freshly processed logo.

    Returns {path, play_path, process_path, status, error, refresh}.
    """
    outdir = None
    try:
        outdir = _extract_animated_logo_frames(channel_id, zip_path)
        target_dir = _animated_logo_dir(channel_id)
        target_dir.mkdir(parents=True, exist_ok=True)
        target = _animated_logo_target(channel_id, zip_path)

        # find how many frames we extracted (the loop window) for fade timing
        names = sorted(p for p in os.listdir(outdir) if p.endswith(".tga"))
        nframes = len(names)
        if nframes == 0:
            raise RuntimeError("no tga frames extracted from logo archive")
        fps = 25
        dur = nframes / fps
        fade_d = 0.3
        # Soft alpha fade at both ends makes the (non bit-identical) start and
        # end cross-fade into a seamless loop.
        vf = (
            f"fade=t=in:st=0:d={fade_d}:alpha=1,"
            f"fade=t=out:st={max(0, dur - fade_d):.3f}:d={fade_d}:alpha=1"
        )
        pattern = f"frame_%06d.tga"
        # First pass: normalise to RGBA while we decode the TGA sequence.
        # Then encode ProRes 4444 (yuva444p10le) which carries a real alpha
        # channel inside a standard .mov container that ffmpeg can overlay and
        # stream_loop seamlessly.
        _threads = _thread_args() or ["-threads", "4"]
        cmd = [
            FFMPEG_BIN, "-hide_banner", "-y",
            "-framerate", str(fps), "-start_number", "0",
            "-i", os.path.join(outdir, pattern),
            "-vf", vf,
            "-c:v", "prores_ks",
            "-profile:v", "4444",
            "-pix_fmt", "yuva444p10le",
            "-q:v", "9",
            "-movflags", "+faststart",
            *_threads,
            "-an",
            str(target),
        ]
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=3600,
                              creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
        if proc.returncode != 0 or not target.is_file():
            return {
                "path": "", "play_path": "", "process_path": "",
                "status": "failed",
                "error": (proc.stderr or "")[-500:],
            }

        # Generate a browser-playable VP9 webm preview at 960x540 over a
        # solid black background, so the graphic/logo is clearly visible.
        webm_target = target_dir / f"{target.stem}_preview.webm"
        try:
            background = (
                f"color=c=black:s=960x540:r={fps}:d=600"
            )
            filter_complex = (
                f"{background}[bg];[0:v]format=rgba,scale=960:540[fg];"
                "[bg][fg]overlay=shortest=1:format=auto,format=yuv420p[v]"
            )
            webm_threads = _thread_args() or ["-threads", "4"]
            webm_cmd = [
                FFMPEG_BIN, "-hide_banner", "-y",
                "-loglevel", "error",
                "-i", str(target),
                "-filter_complex", filter_complex,
                "-map", "[v]",
                "-c:v", "libvpx-vp9",
                "-b:v", "800k",
                "-deadline", "realtime",
                "-cpu-used", "8",
                "-row-mt", "1",
                *webm_threads,
                str(webm_target),
            ]
            subprocess.run(
                webm_cmd, capture_output=True, text=True, timeout=600,
                creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
            )
        except Exception:
            webm_target = None

        storage = _get_channel_storage(channel_id)
        rel = target.resolve().relative_to(storage.resolve()).as_posix()
        # Repoint the playout overlay so HLS/UDP output uses this logo. The
        # path is relative to the channel storage root (media/process/logo/...)
        # so the overlay builder can resolve it.
        rel_path = rel
        _set_playout_processing_logo(channel_id, rel_path)
        play_rel = rel
        if webm_target and webm_target.is_file():
            play_rel = webm_target.resolve().relative_to(storage.resolve()).as_posix()
        return {
            "path": str(target.resolve()).replace("\\", "/"),
            "play_path": f"/{play_rel}",
            "process_path": f"/{rel}",
            "status": "processed",
            "error": "",
            "refresh": True,
        }
    except Exception as e:
        return {
            "path": "", "play_path": "", "process_path": "",
            "status": "failed", "error": str(e),
        }
    finally:
        if outdir:
            try:
                shutil.rmtree(outdir, ignore_errors=True)
            except Exception:
                pass


_ANIMATED_LOGO_LOCKS: dict[int, asyncio.Lock] = {}


def _set_playout_processing_logo(channel_id: int, logo_rel: str):
    """Repoint the channel's playout overlay logo to ``logo_rel`` and persist
    it, so the next (and active) playout uses the freshly processed logo."""
    db = load_db()
    key = str(channel_id)
    pcfg = db.get("playout_configs", {}).get(key)
    if not pcfg:
        for ch in db.get("channels", []):
            if ch.get("id") == channel_id:
                pcfg = ch.setdefault("playout", {})
                break
    if not pcfg:
        return
    proc = pcfg.setdefault("processing", {})
    proc["logo"] = logo_rel
    proc["add_logo"] = True
    save_db(db)


@app.post("/api/media/{channel_id}/logo/process/")
async def process_animated_logo(channel_id: int, request: Request):
    """Convert a zipped animated logo (TGA frames with alpha) into a looping
    alpha ProRes 4444 MOV plus a browser-playable webm preview, both saved
    under the processed logo dir.

    An optional body ``{ "source": "<storage-relative path to the zip>" }``
    processes that specific logo archive (used by the per-row logo Process
    button); without it the configured / most recent logo-folder archive is
    used. The playout overlay logo is repointed to the result and enabled.

    Returns the same JSON contract as the reprocess endpoint so the web UI can
    refresh the media library: {path, play_path, process_path, status}.
    """
    get_current_user(request)
    try:
        body = await request.json()
    except Exception:
        body = {}
    source = str(body.get("source") or "").strip()
    storage = _get_channel_storage(channel_id)

    def _rel(other):
        try:
            return other.resolve().relative_to(storage.resolve()).as_posix()
        except ValueError:
            return str(other).replace("\\", "/").lstrip("/")

    # 1) Direct resolution of the requested source if it was provided.
    zip_path = ""
    if source:
        direct = storage / source.lstrip("/")
        try:
            if direct.is_file() and direct.suffix.lower() == ".zip":
                zip_path = str(direct.resolve())
        except OSError:
            pass

    # 2) Recursive search across the candidate logo folders matched against
    #    the storage-relative source path.
    if source and not zip_path:
        for folder in _logo_candidate_folders(storage):
            if not folder.is_dir():
                continue
            for f in _collect_files(folder, {".zip"}):
                if (
                    _rel(f) == source.lstrip("/")
                    or str(f).replace("\\", "/") == source.replace("\\", "/")
                ):
                    zip_path = str(f)
                    break
            if zip_path:
                break

    # 3) Fall back to the configured / most recent logo archive.
    if not zip_path:
        zip_path = _animated_logo_source(channel_id) or ""

    if not zip_path:
        raise HTTPException(status_code=404, detail="No zipped animated logo configured")

    lock = _ANIMATED_LOGO_LOCKS.setdefault(channel_id, asyncio.Lock())
    if lock.locked():
        return JSONResponse(status_code=200, content={
            "detail": "Processing already running", "status": "processing"})

    def _run():
        return _process_animated_logo_sync(channel_id, zip_path)

    async with lock:
        result = await asyncio.get_event_loop().run_in_executor(None, _run)
    result["detailed_message"] = result.get("error", "")
    return result


def _graphic_candidate_folders(storage: Path):
    """Possible locations of the channel's ``graphics`` folders for zip
    archives (uploaded graphic source sequences with alpha)."""
    seen = set()
    out = []
    for cand in (
        storage,
        storage / "graphics",
        storage / "media" / "graphics",
        storage.parent / "graphics",
    ):
        key = str(cand.resolve()) if cand.exists() else str(cand)
        if key not in seen:
            seen.add(key)
            out.append(cand)
    return out


def _animated_graphic_dir(channel_id: int) -> Path:
    """Directory holding the processed graphic overlays (alpha mov files)."""
    return _resolve_process_dir(channel_id) / "graphics"


def _animated_graphic_target(channel_id: int, zip_path: str) -> Path:
    return _animated_graphic_dir(channel_id) / f"{Path(zip_path).stem}.mov"


def _process_animated_graphic_sync(channel_id: int, zip_path: str) -> dict:
    """Synchronously turn a TGA zipped animation into a looping alpha ProRes
    4444 MOV (an overlay graphic such as a channel bug). Unlike the animated
    logo this does NOT repoint any config; the user selects which processed
    graphic to use from the graphics settings.

    Returns {path, play_path, process_path, status, error, graphic_rel, refresh}.
    """
    outdir = None
    try:
        outdir = _extract_animated_logo_frames(channel_id, zip_path)
        target_dir = _animated_graphic_dir(channel_id)
        target_dir.mkdir(parents=True, exist_ok=True)
        target = _animated_graphic_target(channel_id, zip_path)

        names = sorted(p for p in os.listdir(outdir) if p.endswith(".tga"))
        nframes = len(names)
        if nframes == 0:
            raise RuntimeError("no tga frames found in graphic archive")
        fps = 25
        dur = nframes / fps
        fade_d = 0.3
        vf = (
            f"fade=t=in:st=0:d={fade_d}:alpha=1,"
            f"fade=t=out:st={max(0, dur - fade_d):.3f}:d={fade_d}:alpha=1"
        )
        pattern = "frame_%06d.tga"
        _threads = _thread_args() or ["-threads", "4"]
        cmd = [
            FFMPEG_BIN, "-hide_banner", "-y",
            "-framerate", str(fps), "-start_number", "0",
            "-i", os.path.join(outdir, pattern),
            "-vf", vf,
            "-c:v", "prores_ks",
            "-profile:v", "4444",
            "-pix_fmt", "yuva444p10le",
            "-q:v", "9",
            "-movflags", "+faststart",
            *_threads,
            "-an",
            str(target),
        ]
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=3600,
                              creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
        if proc.returncode != 0 or not target.is_file():
            return {
                "path": "", "play_path": "", "process_path": "",
                "status": "failed", "error": (proc.stderr or "")[-500:],
            }

        webm_target = target_dir / f"{target.stem}_preview.webm"
        try:
            background = (
                f"color=c=black:s=960x540:r={fps}:d=600"
            )
            filter_complex = (
                f"{background}[bg];[0:v]format=rgba,scale=960:540[fg];"
                "[bg][fg]overlay=shortest=1:format=auto,format=yuv420p[v]"
            )
            webm_threads = _thread_args() or ["-threads", "4"]
            webm_cmd = [
                FFMPEG_BIN, "-hide_banner", "-y",
                "-loglevel", "error",
                "-i", str(target),
                "-filter_complex", filter_complex,
                "-map", "[v]",
                "-c:v", "libvpx-vp9",
                "-b:v", "800k",
                "-deadline", "realtime",
                "-cpu-used", "8",
                "-row-mt", "1",
                *webm_threads,
                str(webm_target),
            ]
            subprocess.run(
                webm_cmd, capture_output=True, text=True, timeout=600,
                creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
            )
        except Exception:
            webm_target = None

        storage = _get_channel_storage(channel_id)
        rel = target.resolve().relative_to(storage.resolve()).as_posix()
        play_rel = rel
        if webm_target and webm_target.is_file():
            play_rel = webm_target.resolve().relative_to(storage.resolve()).as_posix()
        return {
            "path": str(target.resolve()).replace("\\", "/"),
            "play_path": f"/{play_rel}",
            "process_path": f"/{rel}",
            "graphic_rel": rel,
            "status": "processed",
            "error": "",
            "refresh": True,
        }
    except Exception as e:
        return {
            "path": "", "play_path": "", "process_path": "",
            "status": "failed", "error": str(e),
        }
    finally:
        if outdir:
            try:
                shutil.rmtree(outdir, ignore_errors=True)
            except Exception:
                pass


_GRAPHIC_LOCKS: dict[int, asyncio.Lock] = {}


@app.post("/api/media/{channel_id}/graphic/process/")
async def process_animated_graphic(channel_id: int, request: Request):
    """Convert an uploaded graphic zip (TGA frames with alpha) into a looping
    alpha ProRes 4444 MOV stored under <storage>/media/process/graphics/.

    Request body: ``{ "source": "<storage-relative path to the zip>" }``.
    Returns the same JSON contract as the logo/reprocess endpoints.
    """
    get_current_user(request)
    try:
        body = await request.json()
    except Exception:
        body = {}
    source = str(body.get("source") or "").strip()

    storage = _get_channel_storage(channel_id)

    def _rel(other: Path) -> str:
        try:
            return other.resolve().relative_to(storage.resolve()).as_posix()
        except ValueError:
            return str(other).replace("\\", "/").lstrip("/")

    # 1) Direct resolution of the requested source (it may live in a
    #    subfolder such as graphics/Bug/...).
    zips = []
    if source:
        direct = storage / source.lstrip("/")
        try:
            if direct.is_file() and direct.suffix.lower() == ".zip":
                zips = [direct.resolve()]
        except OSError:
            pass

    # 2) Recursive search across the candidate graphics folders so a zip deep
    #    in a subfolder is matched against the storage-relative source path.
    if not zips:
        seen = set()
        for folder in _graphic_candidate_folders(storage):
            if not folder.is_dir():
                continue
            for f in _collect_files(folder, {".zip"}):
                try:
                    key = str(f.resolve())
                except OSError:
                    key = str(f)
                if key in seen:
                    continue
                seen.add(key)
                if source:
                    if (
                        _rel(f) == source.lstrip("/")
                        or str(f).replace("\\", "/") == source.replace("\\", "/")
                    ):
                        zips = [f]
                        break
                else:
                    zips.append(f)
            if len(zips) == 1 and source:
                break

    if not zips:
        raise HTTPException(status_code=404, detail="No zipped graphic found")

    # Without an explicit source, prefer the most recently modified zip.
    if not source and len(zips) > 1:
        zips = [max(zips, key=lambda p: p.stat().st_mtime)]

    zip_path = str(zips[0])
    lock = _GRAPHIC_LOCKS.setdefault(channel_id, asyncio.Lock())

    # NOW/NEXT/LATER/Current-Movie are NNL templates (After-Effects zips or
    # Blender .blend scenes), not TGA frame sequences. Route the Process button
    # through the dynamic NNL pipeline (per-movie title rendered by Blender
    # headless, or baked onto the base MOV) instead of the TGA-only processor.
    nnl_tpl = _nnl_template_for_zip(zip_path)
    if nnl_tpl:
        def _run_nnl():
            # sample title: first playlist Line1 for this template, else label
            bld = _nnl_blend_path(channel_id, nnl_tpl)
            has_blender = bool(_find_blender_executable())
            if bld and not has_blender:
                return {
                    "path": "", "play_path": "", "process_path": "",
                    "status": "failed",
                    "error": (
                        f"NNL template '{nnl_tpl.upper()}': scene {bld} found "
                        f"but Blender is not installed on this machine. Install "
                        f"Blender (free) and set BLENDER_BIN or let the server "
                        f"find it on PATH."
                    ),
                }
            sample = "Deva"
            try:
                today = _get_now_in_tz(_get_channel_timezone(channel_id)).strftime("%Y-%m-%d")
                sample = next(
                    (str(ev.get("text") or "").strip()
                     for it in load_playlist_for_date(channel_id, today) or []
                     for ev in (it.get("secondary_events") or [])
                     if _normalize_nnl_template(str(ev.get("template") or "")) == nnl_tpl
                     and str(ev.get("text") or "").strip()),
                    "Deva")
            except Exception:
                pass
            out = _render_nnl_mov(channel_id, nnl_tpl, sample, 30.0, zip_path)
            if not out:
                return {"path": "", "play_path": "", "process_path": "",
                        "status": "failed", "error": "NNL render failed"}
            webm = f"{Path(out).with_suffix('')}_preview.webm"
            storage_r = _get_channel_storage(channel_id)
            rel = Path(out).resolve().relative_to(storage_r.resolve()).as_posix()
            play_rel = rel
            if os.path.isfile(webm):
                play_rel = webm.replace("\\", "/")
                try:
                    play_rel = Path(webm).resolve().relative_to(
                        storage_r.resolve()).as_posix()
                except ValueError:
                    pass
            return {
                "path": str(Path(out).resolve()).replace("\\", "/"),
                "play_path": f"/{play_rel}",
                "process_path": f"/{rel}",
                "graphic_rel": rel,
                "status": "processed",
                "error": "",
                "refresh": True,
                "nnl": True,
            }

        async with lock:
            result = await asyncio.get_event_loop().run_in_executor(None, _run_nnl)
        result["detailed_message"] = result.get("error", "")
        return result

    if lock.locked():
        return JSONResponse(status_code=200, content={
            "detail": "Processing already running", "status": "processing"})

    def _run():
        return _process_animated_graphic_sync(channel_id, zip_path)

    async with lock:
        result = await asyncio.get_event_loop().run_in_executor(None, _run)
    result["detailed_message"] = result.get("error", "")
    return result


@app.post("/api/media/{channel_id}/graphic/nnl/prebuild/")
async def nnl_graphics_prebuild(channel_id: int, request: Request):
    """(Re)build the NNL dynamic graphics for today's playlist.

    For every secondary event with an NNL template (NOW/NEXT/LATER/
    Current-Movie) the Line1 text is baked onto the rendered base MOV found in
    <storage>/graphics/NNL and cached under <storage>/media/process/graphics.
    Already-cached (template, text, duration) combinations are skipped.
    Returns counts: {built, skipped, missing_base, failed}.
    """
    get_current_user(request)
    today = _get_now_in_tz(_get_channel_timezone(channel_id)).strftime("%Y-%m-%d")
    program = load_playlist_for_date(channel_id, today)
    counts = await asyncio.get_event_loop().run_in_executor(
        None, _ensure_nnl_graphics, channel_id, program)
    detail = (
        f"NNL graphics: {counts['built']} built, {counts['skipped']} cached, "
        f"{counts['missing_base']} missing base render, {counts['failed']} failed"
    )
    return JSONResponse(status_code=200, content={"detail": detail, **counts})


@app.get("/api/media/{channel_id}/graphic/nnl/templates/")
async def nnl_graphic_templates(channel_id: int, request: Request):
    """Graphic templates that can be picked for a timed overlay.

    The four built-in aliases (NOW/NEXT/LATER/Current-Movie) plus every
    station-specific render found in <storage>/graphics/NNL (e.g. Aston,
    L-band), so a secondary event for those can be scheduled from the UI
    instead of only by editing the playlist JSON."""
    get_current_user(request)
    loop = asyncio.get_event_loop()
    templates = await loop.run_in_executor(
        None, _available_nnl_templates, channel_id)
    return JSONResponse(content={"templates": templates})


# Guard so a background watch cycle and a manual/start trigger never run the
# same channel's transcode batch at the same time (a 100+ min MPEG-1 file
# must not be started twice).
_PREPROCESS_LOCKS: dict[int, asyncio.Lock] = {}


def _preprocess_lock(channel_id: int) -> asyncio.Lock:
    return _PREPROCESS_LOCKS.setdefault(channel_id, asyncio.Lock())


def _media_duration(file_path: str) -> float:
    """Best-effort duration (seconds) of the longest stream in a file.

    Uses the per-stream duration (which is frame accurate for MPEG-1 PS
    and MPEG-TS) rather than the container `format.duration` value, which
    can be padded or unreliable for some muxers.
    """
    try:
        r = subprocess.run(
            [FFPROBE_BIN, "-v", "error",
             "-show_entries", "stream=duration",
             "-of", "default=noprint_wrappers=1:nokey=1", file_path],
            capture_output=True, text=True, timeout=60,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
        vals = []
        for ln in r.stdout.splitlines():
            ln = ln.strip()
            if ln and ln.lower() != "n/a":
                try:
                    vals.append(float(ln))
                except ValueError:
                    pass
        if vals:
            return max(vals)
    except Exception:
        pass
    return 0.0


def _target_is_complete(channel_id: int, source: Path, target: Path) -> bool:
    """Return True when an existing .ts target is a usable, COMPLETE transcode
    of source, so it can be skipped by the next pass.

    A plain "target newer than source" check is not enough: an interrupted
    transcode leaves a truncated but newer .ts on disk, and without this
    validation the background watcher would (wrongly) keep treating it as
    done forever - which is why long files like L11AFHLM0050.mpg stayed
    stuck at ~0s.
    """
    try:
        src_meta = source.stat()
        tgt_meta = target.stat()
    except OSError:
        return False

    # A real transcode is never this small; a truncated one often is.
    if tgt_meta.st_size < 100_000:
        return False

    # Force a one-time reprocess of preprocessed .ts files that were created
    # BEFORE the channel-logo was removed from the transcode step. Those old
    # files still have the logo baked in; a full refresh strips it so the logo
    # is only applied on the final HLS/UDP playout. Targets written on/after
    # this epoch use the logo-free pipeline and are treated normally.
    REPROCESS_EPOCH = 1788220800.0  # 2026-09-01T00:00:00Z (logo removed from transcode)
    if tgt_meta.st_mtime < REPROCESS_EPOCH:
        return False

    # The authoritative completeness check is a duration match: a full
    # transcode has (roughly) the same duration as its source no matter how
    # its on-disk mtime compares to the source. Some sources carry an
    # anomalous (even future) mtime, so a naive "target older than source =>
    # stale" check would mislabel a perfectly good transcode as failed and
    # keep re-encoding it forever.
    src_dur = _media_duration(str(source))
    tgt_dur = _media_duration(str(target))
    if src_dur > 0 and tgt_dur > 0:
        return abs(tgt_dur - src_dur) < 2.0

    # Durations could not be verified; fall back to the size + mtime heuristic.
    # Target older than source -> stale, re-transcode.
    if tgt_meta.st_mtime < src_meta.st_mtime:
        return False
    return True


def _find_source_for_ts(channel_id: int, ts_path: Path):
    """Map a preprocessed `<storage>/media/process/x.ts` back to its source
    file (the media or filler asset with the same stem, excluding the process
    folder).

    When no non-ts source exists (e.g. a .ts placed directly in the filler
    folder), the .ts file itself is returned so it can be re-transcoded from
    itself."""
    storage = _get_channel_storage(channel_id)
    process_dir = _resolve_process_dir(channel_id)
    media_dir = storage.parent if process_dir == storage else storage / "media"
    try:
        rel = ts_path.resolve().relative_to(process_dir.resolve())
    except ValueError:
        rel = None
    if rel is None:
        return None
    stem = rel.stem
    skip = process_dir.resolve()
    non_ts_matches = []
    ts_matches = []
    for root_dir in (media_dir, storage / "filler"):
        if not root_dir.is_dir():
            continue
        for root, dirs, files_list in os.walk(root_dir):
            root_path = Path(root)
            if root_path.resolve() == skip or skip in root_path.resolve().parents:
                continue
            for fname in files_list:
                p = root_path / fname
                if p.stem != stem:
                    continue
                ext = p.suffix.lower().lstrip(".")
                if ext in _get_process_extensions():
                    non_ts_matches.append(p)
                elif ext == "ts":
                    ts_matches.append(p)
    if non_ts_matches:
        non_ts_matches.sort(key=lambda p: p.stat().st_mtime, reverse=True)
        return non_ts_matches[0]
    if ts_matches:
        ts_matches.sort(key=lambda p: p.stat().st_mtime, reverse=True)
        return ts_matches[0]
    return None


def _build_pp_command(storage: Path, pcfg: dict, source: Path, target: Path) -> list:
    """Build the ffmpeg preprocessing command for a single source -> target.

    Note: Channel logo is NOT applied here. The logo is added only during the
    final HLS/UDP playout stream.
    """
    proc = pcfg.get("processing", {})
    width = proc.get("width", 1920)
    height = proc.get("height", 1080)
    fps = proc.get("fps", 25)
    audio_channels = proc.get("audio_channels", 2)

    src_str = str(source).replace("\\", "/")
    tgt_str = str(target).replace("\\", "/")
    v_chain = (
        f"scale={width}:{height}:force_original_aspect_ratio=decrease,"
        f"pad={width}:{height}:(ow-iw)/2:(oh-ih)/2,"
        f"fps={fps},format=yuv420p"
    )
    filter_opt = ["-vf", v_chain]

    return ([FFMPEG_BIN, "-hide_banner", "-y", "-i", src_str]
            + filter_opt + _thread_args() + [
                "-c:v", "libx264", "-preset", "veryfast", "-tune", "zerolatency",
                "-b:v", "5000k", "-maxrate", "5000k", "-bufsize", "10000k", "-g", "25",
                "-c:a", "aac", "-b:a", "192k", "-ar", "48000", "-ac", str(audio_channels),
                "-f", "mpegts", "-mpegts_flags", "+initial_discontinuity",
                tgt_str,
            ])


def _is_availability_link(channel_id: int, ts_path: Path) -> bool:
    """True when ts_path is a hard link shared from another channel."""
    try:
        av = _load_availability()
        entry = (av.get(str(channel_id), {}) or {}).get(ts_path.stem)
        if not entry or not entry.get("owner"):
            return False
        owner_file = _get_channel_storage(int(entry["owner"])) / entry["path"]
        return owner_file.is_file() and os.path.samefile(ts_path, owner_file)
    except Exception:
        return False


def _is_availability_owner(channel_id: int, ts_path: Path) -> bool:
    """True when ts_path is the source file shared to another channel (i.e. an
    availability entry in some channel points back to this channel's file)."""
    try:
        storage = _get_channel_storage(channel_id)
        for cid, channel_av in _load_availability().items():
            for _asset, entry in channel_av.items():
                if entry.get("owner") != channel_id:
                    continue
                rel = entry.get("path")
                if not rel or Path(rel).stem != ts_path.stem:
                    continue
                owner_file = storage / rel
                if os.path.samefile(ts_path, owner_file):
                    return True
    except Exception:
        pass
    return False


def _ts_status(channel_id: int, ts_path: Path) -> str:
    """Classify a preprocessed .ts as processed / processing / failed.

    A complete transcode of its source is `processed`. A .ts that cannot be
    probed or that is far shorter than the source (e.g. a broken 1-frame
    transcode) is `failed` - unless it is still being written, in which case
    it is `processing`.
    """
    src = _find_source_for_ts(channel_id, ts_path)
    if src is None:
        # Availability-linked outputs are shared from another channel via a
        # hard link and are complete transcodes → processed. The owner's own
        # shared file counts too (its source may have been removed).
        if _is_availability_link(channel_id, ts_path) or _is_availability_owner(channel_id, ts_path):
            return "processed"
        try:
            st = ts_path.stat()
        except OSError:
            return "failed"
        if time.time() - st.st_mtime < 60:
            return "processing"
        return "failed"
    # When source IS the target (e.g. a filler .ts placed directly),
    # the file is valid as long as it can be probed successfully.
    if src.resolve() == ts_path.resolve():
        try:
            ts_path.stat()
        except OSError:
            return "failed"
        return "processed"
    if _target_is_complete(channel_id, src, ts_path):
        return "processed"
    try:
        st = ts_path.stat()
    except OSError:
        return "failed"
    if time.time() - st.st_mtime < 60:
        return "processing"
    return "failed"


async def _preprocess_all(channel_id: int):
    """Scan storage/media for files, transcode each into process/ as .ts.

    Skips files already in the process folder and files whose .ts target
    is a complete, up-to-date transcode of the source. Incomplete / truncated
    targets (e.g. from an interrupted background run) are always redone.
    """
    storage = _get_channel_storage(channel_id)
    process_dir = _resolve_process_dir(channel_id)
    process_dir.mkdir(parents=True, exist_ok=True)

    extensions = _get_process_extensions()
    skip_dir = process_dir.resolve()

    # Collect media + filler files. The canonical source tree is
    # <storage>/media, but when the storage path is itself the process dir the
    # sources live in its parent. Filler (=rescue) files live in a separate
    # <storage>/filler folder, outside media/, and are transcoded the same way
    # so the library can display their browser-playable .ts outputs.
    media_dir = storage.parent if _resolve_process_dir(channel_id) == storage else storage / "media"
    if not media_dir.is_dir():
        print(f"[preprocess] channel {channel_id}: media dir not found: {media_dir}")
        return

    files = []
    for root_dir in (media_dir, storage / "filler"):
        if not root_dir.is_dir():
            continue
        for root, dirs, files_list in os.walk(root_dir):
            root_path = Path(root)
            # Skip the process folder itself
            if root_path.resolve() == skip_dir or skip_dir in root_path.resolve().parents:
                continue
            for fname in files_list:
                ext = fname.rsplit(".", 1)[-1].lower() if "." in fname else ""
                if ext in extensions and ext != "ts":
                    files.append(root_path / fname)

    total = len(files)
    if total == 0:
        print(f"[preprocess] channel {channel_id}: no files to preprocess")
        return

    print(f"[preprocess] channel {channel_id}: preprocessing {total} files (ffmpeg={FFMPEG_BIN})")

    pcfg = _get_playout_config(channel_id)
    proc = pcfg.get("processing", {})
    width = proc.get("width", 1920)
    height = proc.get("height", 1080)
    fps = proc.get("fps", 25)
    audio_channels = proc.get("audio_channels", 2)

    processed = 0
    failed = 0

    for source in files:
        target = _preprocessed_path(channel_id, str(source))
        if target is None:
            continue

        # Skip only if an existing target is a complete, up-to-date transcode.
        # A truncated .ts from an interrupted run must be redone.
        if target.is_file() and _target_is_complete(channel_id, source, target):
            processed += 1
            continue

        # Create target directory
        target.parent.mkdir(parents=True, exist_ok=True)

        # Build ffmpeg preprocessing command
        src_str = str(source).replace("\\", "/")
        tgt_str = str(target).replace("\\", "/")

        # Video filter chain for the main input
        v_chain = (
            f"scale={width}:{height}:force_original_aspect_ratio=decrease,"
            f"pad={width}:{height}:(ow-iw)/2:(oh-ih)/2,"
            f"fps={fps},format=yuv420p"
        )

        filter_opt = ["-vf", v_chain]

        cmd = [
            FFMPEG_BIN, "-hide_banner", "-y",
            "-i", src_str,
        ] + filter_opt + _thread_args() + [
            "-c:v", "libx264", "-preset", "veryfast", "-tune", "zerolatency",
            "-b:v", "5000k", "-maxrate", "5000k", "-bufsize", "10000k", "-g", "25",
            "-c:a", "aac", "-b:a", "192k", "-ar", "48000", "-ac", str(audio_channels),
            "-f", "mpegts", "-mpegts_flags", "+initial_discontinuity",
            tgt_str,
        ]

        print(f"[preprocess] channel {channel_id}: {source.name} -> {target.name}")

        try:
            proc_ff = await asyncio.create_subprocess_exec(
                *cmd,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE,
                creationflags=_popen_flags(),
            )
            _, stderr = await proc_ff.communicate()
            if proc_ff.returncode == 0:
                processed += 1
            else:
                err_text = stderr.decode(errors="replace")
                # Extract meaningful error lines (last non-empty lines)
                err_lines = [l for l in err_text.splitlines() if l.strip()]
                err_msg = "\n".join(err_lines[-5:]) if err_lines else err_text[:500]
                print(f"[preprocess] channel {channel_id}: FAILED {source.name} (rc={proc_ff.returncode}):\n{err_msg}")
                failed += 1
        except Exception as e:
            print(f"[preprocess] channel {channel_id}: error {source.name}: {e}")
            failed += 1

    print(f"[preprocess] channel {channel_id}: complete: {processed}/{total} processed, {failed} failed")


async def _preprocess_watcher(channel_id: int, is_alive):
    """Background polling loop (per channel).

    Every interval this scans the channel's media folder and transcodes any
    new / changed / still-incomplete media file into process/ as a .ts, so
    files dropped into the media folder are transcoded automatically without
    a manual trigger, and a long transcode (e.g. a 100+ minute MPEG-1 .mpg)
    is retried until it actually completes - across server restarts too.

    The channel's `auto_preprocess` flag can be read live on each cycle, so
    toggling it on/off through the UI takes effect without a restart.
    """
    interval = float(os.environ.get("PREPROCESS_INTERVAL", "20") or 20)
    if interval < 5.0:
        interval = 5.0

    while is_alive:
        try:
            db = load_db()
            ch = next((c for c in db["channels"] if c.get("id") == channel_id), None)
            if ch is None:
                return
            if ch.get("auto_preprocess", False):
                async with _preprocess_lock(channel_id):
                    await _preprocess_all(channel_id)
        except asyncio.CancelledError:
            raise
        except Exception as e:
            import traceback
            print(f"[preprocess] channel {channel_id}: watch loop error: {e}")
            traceback.print_exc()
        await asyncio.sleep(interval)


def _write_scte35_cues(channel_id: int, source: str, duration: float,
                       marker_type: str | None = None,
                       preroll: float = 0.0) -> str | None:
    """Build SCTE-35 cue sections for an ad clip.

    A per clip marker_type ("splice_insert" or "time_signal") overrides the
    channel wide setting; the two markers are never emitted together.
    For time signals preroll seconds are written into the splice_time
    (pts_time) field so downstream gear delays the splice accordingly.
    Returns the path of the binary payload (sections concatenated)."""
    try:
        from threefive import encode as scte_enc
    except ImportError:
        err = "[scte-35] threefive not installed; cannot generate cues"
        print(err)
        _append_channel_log(channel_id, "app", f"[WARN] {err}")
        return None

    if marker_type not in ("splice_insert", "time_signal"):
        marker_type = _get_scte_marker_type(channel_id)

    try:
        preroll = max(float(preroll or 0.0), 0.0)
    except (TypeError, ValueError):
        preroll = 0.0

    # every clip spawns its own ffmpeg with pts starting near zero,
    # so messages fire immediately at the start of the ad;
    # splice_insert carries the break duration for the out point,
    # a time signal carries its pre roll as splice_time (pts_time)
    try:
        ts_cue = scte_enc.mk_time_signal(
            pts=preroll if marker_type == "time_signal" else None)
        si_cue = scte_enc.mk_splice_insert(int(time.time()) & 0xFFFF,
                                           duration=float(duration))
        cues = []
        if marker_type in ("both", "time_signal"):
            cues.append(("time_signal", ts_cue))
        if marker_type in ("both", "splice_insert"):
            cues.append(("splice_insert", si_cue))

        payload = b"".join(cue.bites for _, cue in cues)

        # remember the active break so the hls playlist can be tagged
        st_ = playout_states.setdefault(channel_id, {
            "running": False, "program": [], "index": 0, "elapsed": 0,
            "shift": 0, "gen": 0,
        })
        st_["scte"] = {
            "b64": si_cue.encode() if marker_type in ("both", "splice_insert")
            else ts_cue.encode(),
            "time_signal_b64": ts_cue.encode()
            if marker_type in ("both", "time_signal") else None,
            "marker_type": marker_type,
            "preroll": preroll,
            "duration": float(duration),
            "started": time.time(),
        }

        live_dir = _get_live_dir(channel_id)
        cue_path = live_dir / "scte_adslate.bin"
        cue_path.write_bytes(payload)
    except Exception:
        # cue problems must never take down the playout outputs
        import traceback
        err = (f"[scte-35] channel {channel_id}: cue generation failed:\n"
               f"{traceback.format_exc()}")
        print(err)
        _append_channel_log(channel_id, "app", f"[ERROR] {err}")
        return None

    # keep a timestamped copy + json sidecar for downstream systems
    scte_dir = DATA_DIR / "channel" / str(channel_id) / "scte"
    scte_dir.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    try:
        (scte_dir / f"adslate_{stamp}.bin").write_bytes(payload)
        import base64
        (scte_dir / f"adslate_{stamp}.json").write_text(json.dumps({
            "source": str(source),
            "channel": channel_id,
            "created": datetime.now().isoformat(timespec="seconds"),
            "break_duration": float(duration),
            "pid": _get_scte_pid(channel_id),
            "marker_type": marker_type,
            "preroll": preroll,
            "messages": [
                {"type": name,
                 "base64": cue.encode(),
                 **({"event_id": int(time.time()) & 0xFFFF,
                     "break_duration": float(duration)}
                    if name == "splice_insert" else {})}
                for name, cue in cues
            ],
            "payload_base64": base64.b64encode(payload).decode(),
        }, indent=2, ensure_ascii=False), encoding="utf-8")
    except OSError:
        pass

    pre = f" (pre roll {preroll:g}s)" if marker_type == "time_signal" and preroll > 0 else ""
    msg = (f"[scte-35] channel {channel_id}: injected "
           f"{' + '.join(name for name, _ in cues)}{pre} on pid "
           f"{_get_scte_pid(channel_id)} for {Path(source).name}")
    print(msg)
    _append_channel_log(channel_id, "app", f"[INFO] {msg}")
    return str(cue_path)


def _inject_hls_scte35(channel_id: int, text: str) -> str:
    """Add SCTE-35 ad-break tags to the media playlist:
    #EXT-X-CUE-OUT-CONT above every segment inside the break and
    #EXT-X-CUE-IN above the first segment after the break ends."""
    state = playout_states.get(channel_id) or {}
    cue = state.get("scte")
    if not cue:
        return text

    duration = float(cue["duration"])
    elapsed_total = time.time() - cue["started"]
    # keep tagging for a grace period after the break so players polling
    # the playlist reliably see the CUE-IN before the state is dropped
    if elapsed_total >= duration + 120:
        state.pop("scte", None)
        return text

    lines = text.splitlines()
    extinf_re = re.compile(r"#EXTINF:([\d.]+)")
    durs = {}
    order = []
    for i, ln in enumerate(lines):
        m = extinf_re.match(ln.strip())
        if m:
            durs[i] = float(m.group(1))
            order.append(i)
    if not durs:
        return text

    # Segments are positioned on one shared timeline whose newest segment's
    # END is at `elapsed_total` seconds after the break started. A segment's
    # "elapsed" position is therefore `elapsed_total - (total - seg_end)`.
    # The break runs from elapsed 0..duration. A segment whose START has
    # already passed `duration` sits entirely after the break, so the CUE-IN
    # (return to network) is placed just above it. Using elapsed time - not
    # playlist-time-aligned segment starts - is what makes the CUE-IN appear
    # even for breaks shorter than one HLS segment (e.g. a 1s break against
    # 2s segments), which previously got stuck inside CUE-OUT-CONT forever.
    total = sum(durs.values())
    out = []
    cue_in_done = False
    cue_out_done = False
    break_over = elapsed_total >= duration
    for i, ln in enumerate(lines):
        if i in durs:
            seg_end = total - suffix_sum(durs, order, i)
            seg_elapsed_end = elapsed_total - (total - seg_end)
            seg_elapsed_start = seg_elapsed_end - durs[i]
            if break_over and seg_elapsed_start >= duration and not cue_in_done:
                out.append("#EXT-X-CUE-IN")
                cue_in_done = True
            elif seg_elapsed_end > 0 and seg_elapsed_start < duration:
                el = min(max(seg_elapsed_end, 0.0), duration)
                if not cue_out_done:
                    # Start the break with #EXT-X-CUE-OUT: monitoring tools key
                    # the break START off this tag. Emitting only
                    # #EXT-X-CUE-OUT-CONT (as this used to) left the break open
                    # with no opening marker, so players reported no break at
                    # all. Subsequent segments carry the -CONT form.
                    out.append(
                        f'#EXT-X-CUE-OUT:DURATION={duration:.3f},'
                        f'SCTE35={cue["b64"]}'
                    )
                    cue_out_done = True
                else:
                    out.append(
                        f'#EXT-X-CUE-OUT-CONT:ElapsedTime={el:.3f},'
                        f'Duration={duration:.3f},SCTE35={cue["b64"]}'
                    )
        out.append(ln)
    return "\n".join(out) + ("\n" if text.endswith("\n") else "")


def suffix_sum(durs: dict, order: list, idx: int) -> float:
    """Sum of EXTINF durations strictly after line idx."""
    pos = order.index(idx)
    return sum(durs[k] for k in order[pos + 1:])


def _get_scte_pid(channel_id: int) -> int:
    """SCTE-35 data pid, configurable per channel via output.scte_pid."""
    output = _get_playout_config(channel_id).get("output", {})
    try:
        return int(output.get("scte_pid") or SCTE35_PID)
    except (TypeError, ValueError):
        return SCTE35_PID


SCTE35_MARKER_TYPES = ("splice_insert", "time_signal")


def _get_scte_marker_type(channel_id: int) -> str:
    """SCTE-35 marker type, configurable per channel via
    output.scte_marker_type. One of: splice_insert (default),
    time_signal. Both markers together are never inserted."""
    output = _get_playout_config(channel_id).get("output", {})
    marker = str(output.get("scte_marker_type") or "").lower()
    return marker if marker in SCTE35_MARKER_TYPES else "splice_insert"


def _get_mpegts_pid_args(channel_id: int) -> list[str]:
    pcfg = _get_playout_config(channel_id)
    output = pcfg.get("output", {})
    pid_args = []
    video_pid = output.get("video_pid", "")
    audio_pid = output.get("audio_pid", "")
    pmt_pid = output.get("pmt_pid", "")
    service_id = output.get("service_id", "")
    # per stream pids are set via the generic "-streamid <index>:<pid>" option,
    # "-mpegts_video_pid"/"-mpegts_audio_pid" do not exist in ffmpeg
    if video_pid:
        pid_args += ["-streamid", f"0:{video_pid}"]
    if audio_pid:
        pid_args += ["-streamid", f"1:{audio_pid}"]
    if pmt_pid:
        pid_args += ["-mpegts_pmt_start_pid", str(pmt_pid)]
    if service_id:
        pid_args += ["-mpegts_service_id", str(service_id)]
    return pid_args


def _start_ffmpeg(channel_id: int, source: str, seek_in: float, duration: float,
                  scte: dict | None = None, item: dict | None = None):
    _kill_ffmpeg(channel_id)
    # do not wipe segment files here: players may still fetch segments
    # listed in the playlist they cached; aged files are swept instead,
    # which prevents 404s on the ts files during clip transitions
    _sweep_old_hls_segments(channel_id)

    live_dir = _get_live_dir(channel_id)

    codec_params, output_dest = _get_output_params(channel_id)

    # Use preprocessed .ts file if available (standard resolution). The channel
    # logo is applied during this playout step for the HLS/UDP stream.
    source = _resolve_source(channel_id, source)

    input_args, map_args, cc_args = _build_ffmpeg_inputs_and_maps(
        channel_id, source, seek_in, duration, item=item,
    )
    pid_args = _get_mpegts_pid_args(channel_id)

    # SCTE-35: markers ride in the mpegts output (udp:// or srt://) on a
    # dedicated data pid; the cue state also drives HLS playlist tagging.
    # the data input must join the other inputs; its map/streamid are
    # output options and go after all inputs
    st_ = playout_states.setdefault(channel_id, {
        "running": False, "program": [], "index": 0, "elapsed": 0,
        "shift": 0, "gen": 0, "stream_enabled": False,
    })
    # remember how this clip's mpegts output was built so the stream-only
    # control can (re)spawn the UDP/SRT process on its own, without touching
    # the HLS variants or the playout schedule.
    st_["cur_source"] = source
    st_["cur_seek"] = seek_in
    st_["cur_dur"] = duration
    st_["cur_item"] = item
    st_["cur_is_test"] = False
    # NOTE: do not clear st_["scte"] here. A break is far shorter than the
    # clip that follows it (a 15s ad against 300s programmes), so dropping the
    # cue when the NEXT clip spawns killed the CUE-IN grace window before the
    # media playlist ever had a segment positioned past the break end. A fresh
    # ad clip overwrites the cue in _write_scte35_cues anyway, and
    # _inject_hls_scte35 expires it once duration + 120s have elapsed.
    scte_input = []
    scte_out = []
    is_ts_output = str(output_dest).lower().startswith(("udp://", "srt://"))
    if _is_ad_clip(source, item):
        scte_opts = scte or {}
        cue_path = _write_scte35_cues(
            channel_id, source, duration,
            marker_type=scte_opts.get("marker_type"),
            preroll=scte_opts.get("preroll") or 0,
        )
        if cue_path and is_ts_output:
            data_idx = input_args.count("-i")
            # "-streamid" addresses an OUTPUT stream, not the input the cue was
            # read from. The cue is mapped after every stream map_args already
            # declared (video, audio), so its output index is the number of
            # those maps - not data_idx, which counted INPUTS and therefore
            # drifted as soon as a logo/bug/overlay input was added. With the
            # wrong index ffmpeg left the SCTE data stream on an
            # automatically assigned pid and nothing arrived on pid 768, so
            # downstream muxers saw no markers at all.
            data_out_idx = map_args.count("-map")
            scte_input = ["-f", "data", "-i", cue_path]
            scte_out = [
                "-map", f"{data_idx}:d", "-c:d", "copy",
                "-streamid", f"{data_out_idx}:{_get_scte_pid(channel_id)}",
            ]

    udp_cmd = [FFMPEG_BIN, "-y", "-re"] + input_args + scte_input + map_args + scte_out + codec_params + _thread_args(_FFMPEG_STREAM_THREADS) + ["-f", "mpegts"] + pid_args + [output_dest]

    # Monitoring HLS: a single 480p rendition. The multi-variant ABR
    # ladder is reserved for the streaming output, so the preview is cheap
    # to encode; the 480p process backs the existing `{channel_id}_hls`
    # monitoring process so the playout loop's clip-advance detection keeps
    # working unchanged.
    variants = _get_monitor_variants(channel_id)

    monitor_had_vtt = False

    def _variant_cmd(v):
        nonlocal monitor_had_vtt
        # rebuild the filter graph for this rendition's resolution
        v_input, v_map, v_cc = _build_ffmpeg_inputs_and_maps(
            channel_id, source, seek_in, duration,
            item=item, variant_scale=(v["width"], v["height"]),
        )
        if v_cc:
            monitor_had_vtt = True
        vp = str(live_dir / f"variant_{v['name']}_%05d.ts").replace("\\", "/")
        vpl = str(live_dir / f"variant_{v['name']}.m3u8").replace("\\", "/")
        # append_list inherits whatever the previous muxer left behind, so drop
        # entries whose segments are already gone before handing it over
        _prune_dead_hls_entries(Path(vpl))
        codec = ["-c:v", "libx264", "-preset", "ultrafast", "-tune", "zerolatency",
                 "-b:v", str(v.get("bitrate", "5000k")),
                 "-maxrate", str(v.get("bitrate", "5000k")),
                 "-bufsize", str(int(float(str(v.get("bitrate", "5000k")).rstrip('kK')) * 2)) + "k",
                 "-c:a", "aac", "-b:a", str(v.get("audio", "128k")), "-ar", "48000"]
        return (
            [FFMPEG_BIN, "-y", "-re"] + v_input + v_map + v_cc
            + codec + _thread_args()
            + ["-g", "50", "-f", "hls", "-hls_time", "2", "-hls_list_size", "30",
            "-hls_flags", HLS_CONTINUITY_FLAGS,
               "-hls_segment_filename", vp,
               vpl]
        )

    # spawn the top variant first so the primary process reference is set
    hls_procs = []
    for i, v in enumerate(variants):
        try:
            v_log = _ffmpeg_log_file(channel_id, f"hls_{v['name']}")
            try:
                v_proc = subprocess.Popen(
                    _variant_cmd(v),
                    stdout=subprocess.DEVNULL,
                    stderr=v_log,
                    creationflags=_popen_flags(),
                )
                if i == 0:
                    playout_processes[f"{channel_id}_hls"] = v_proc
                else:
                    playout_processes[f"{channel_id}_hls_{i}"] = v_proc
                hls_procs.append(v_proc)
            finally:
                v_log.close()
        except Exception as e:
            print(f"[playout] HLS variant start failed ({v['name']}): {e}")

    if hls_procs:
        _write_hls_master(channel_id, variants, vtt_on=monitor_had_vtt)
        _SPAWN_AT[channel_id] = time.time()

    # measure round-trip kill->respawn so the squeeze/bug animation can
    # compensate for the downtime (the graph animations use PTS time t, which
    # starts at 0 when this process begins rendering; wall-clock progress must
    # not include the time the output was dead)
    grt = _graphic_runtime.setdefault(channel_id, {})
    if grt.get("sq_kill_at"):
        grt["sq_last_respawn_time"] = time.time() - grt.pop("sq_kill_at")
        grt["sq_render_lag"] = grt["sq_last_respawn_time"]

    # remember the exact mpegts command so the stream-only control can
    # (re)start the UDP/SRT process independently of the HLS/playout loop.
    st_["udp_cmd"] = udp_cmd

    # Streaming output handling between clip transitions:
    #   * stream mode  -> the UDP/SRT mpegts is auto-re-spawned here so it
    #     stays alive across item changes (parity with prior behaviour).
    #   * hls mode     -> at the FIRST playout start the ABR ladder is NOT
    #     auto-started (the multi-variant ladder would saturate the CPU next
    #     to the 480p monitor and make the preview lag / playout hang). It is
    #     started on-demand only via "Start Stream" (stream_start ->
    #     _spawn_hls_abr). When the user has already started it, the ladder is
    #     re-spawned on each clip transition so the stream stays live.
    output_mode = (_get_playout_config(channel_id).get("output") or {}).get("mode", "stream")

    if output_mode == "hls":
        if st_.get("abr_active"):
            _spawn_hls_abr(channel_id)
    elif st_.get("stream_enabled", False):
        try:
            udp_log = _ffmpeg_log_file(channel_id, "udp")
            try:
                udp_proc = subprocess.Popen(
                    udp_cmd,
                    stdout=subprocess.DEVNULL,
                    stderr=udp_log,
                    creationflags=_popen_flags(),
                )
                playout_processes[channel_id] = udp_proc
            finally:
                udp_log.close()
        except Exception as e:
            print(f"[playout] UDP output start failed for channel {channel_id}: {e}")
            _notify_mail(channel_id, "WARNING", f"UDP output start failed: {e}")

    return True


def _start_ffmpeg_test_pattern(channel_id: int):
    _kill_ffmpeg(channel_id)
    _sweep_old_hls_segments(channel_id)

    st_ = playout_states.setdefault(channel_id, {
        "running": False, "program": [], "index": 0, "elapsed": 0,
        "shift": 0, "gen": 0, "stream_enabled": False,
    })
    st_["cur_is_test"] = True

    # Filler/test-pattern is a bridge, not a dead-end: bump gen so the playout
    # tick's spawn gate (idx != last_index OR gen != last_gen) reopens on the
    # next iteration and re-asserts the scheduled clip. Without this, the
    # infinite test-pattern process sets proc.poll() to None forever, so the
    # clip-advance check never fires and the channel sits on filler even though
    # a valid schedule is still in progress (elapsed < cur_dur). Dead-end cases
    # (exhausted / end-of-playlist) keep holding on filler because playout_tick
    # `continue`s before the spawn block runs.
    st_["gen"] = st_.get("gen", 0) + 1

    live_dir = _get_live_dir(channel_id)

    pcfg = _get_playout_config(channel_id)
    proc = pcfg.get("processing", {})
    w = proc.get("width", 1920)
    h = proc.get("height", 1080)
    fps = proc.get("fps", 25)

    base_args = [
        FFMPEG_BIN, "-y", "-re",
        "-f", "lavfi",
        "-i", f"testsrc2=size={w}x{h}:rate={fps}",
        "-f", "lavfi",
        "-i", f"sine=frequency=1000:sample_rate=48000",
        "-map", "0:v", "-map", "1:a",
        "-c:v", "libx264",
        "-preset", "ultrafast",
        "-tune", "zerolatency",
        "-b:v", "2000k",
        "-c:a", "aac",
        "-b:a", "128k",
        "-ar", "48000",
        "-shortest",
    ]

    pid_args = _get_mpegts_pid_args(channel_id)

    udp_cmd = base_args + _thread_args() + ["-f", "mpegts"] + pid_args + [UDP_OUTPUT]
    st_["udp_cmd"] = udp_cmd

    udp_log = _ffmpeg_log_file(channel_id, "udp")
    if st_.get("stream_enabled", False):
        try:
            udp_proc = subprocess.Popen(
                udp_cmd,
                stdout=subprocess.DEVNULL,
                stderr=udp_log,
                creationflags=_popen_flags(),
            )
            playout_processes[channel_id] = udp_proc
        except Exception as e:
            print(f"[playout] UDP output start failed for channel {channel_id}: {e}")
            _notify_mail(channel_id, "WARNING", f"UDP output start failed: {e}")
    udp_log.close()

    # monitoring HLS variant for the test pattern: a single 480p rendition,
    # matching the live-clip monitor ladder (the ABR ladder is streaming-only).
    variants = _get_monitor_variants(channel_id)

    def _tvariant_cmd(v):
        vp = str(live_dir / f"variant_{v['name']}_%05d.ts").replace("\\", "/")
        vpl = str(live_dir / f"variant_{v['name']}.m3u8").replace("\\", "/")
        # append_list inherits whatever the previous muxer left behind, so drop
        # entries whose segments are already gone before handing it over
        _prune_dead_hls_entries(Path(vpl))
        codec = ["-c:v", "libx264", "-preset", "ultrafast", "-tune", "zerolatency",
                 "-s", f"{v['width']}x{v['height']}",
                 "-b:v", str(v.get("bitrate", "5000k")),
                 "-c:a", "aac", "-b:a", str(v.get("audio", "128k")), "-ar", "48000",
                 "-shortest"]
        return ([FFMPEG_BIN, "-y", "-re"]
                + ["-f", "lavfi", "-i", f"testsrc2=size={v['width']}x{v['height']}:rate={fps}",
                   "-f", "lavfi", "-i", "sine=frequency=1000:sample_rate=48000",
                   "-map", "0:v", "-map", "1:a"]
                + codec + _thread_args()
                + ["-g", str(int(fps) * 2), "-f", "hls", "-hls_time", "2", "-hls_list_size", "30",
                "-hls_flags", HLS_CONTINUITY_FLAGS,
                   "-hls_segment_filename", vp,
                   vpl])

    hls_procs = []
    for i, v in enumerate(variants):
        try:
            v_log = _ffmpeg_log_file(channel_id, f"hls_{v['name']}")
            try:
                v_proc = subprocess.Popen(
                    _tvariant_cmd(v),
                    stdout=subprocess.DEVNULL,
                    stderr=v_log,
                    creationflags=_popen_flags(),
                )
                if i == 0:
                    playout_processes[f"{channel_id}_hls"] = v_proc
                else:
                    playout_processes[f"{channel_id}_hls_{i}"] = v_proc
                hls_procs.append(v_proc)
            finally:
                v_log.close()
        except Exception as e:
            print(f"[playout] HLS test pattern variant failed ({v['name']}): {e}")

    if hls_procs:
        _write_hls_master(channel_id, variants)
        _SPAWN_AT[channel_id] = time.time()

    # The ABR ladder is NOT auto-started at playout start (see _start_ffmpeg):
    # only the 480p monitor runs so CPU stays available for the preview. If the
    # user has started it, re-spawn the ladder here across transitions so the
    # stream stays live.
    output_mode = (pcfg.get("output") or {}).get("mode", "stream")
    if output_mode == "hls" and st_.get("abr_active"):
        _spawn_hls_abr_test_pattern(channel_id, w, h, fps)
    return True


def _get_filler_source(channel_id: int) -> str:
    pcfg = _get_playout_config(channel_id)
    filler = pcfg.get("storage", {}).get("filler", "")
    if not filler:
        return ""
    storage = _get_channel_storage(channel_id)
    filler_path = storage / filler.lstrip("/")
    if filler_path.is_file():
        return str(filler_path)
    if filler_path.is_dir():
        for item in sorted(filler_path.iterdir()):
            if item.is_file() and item.suffix.lower() in VIDEO_EXTENSIONS:
                return str(item)
    return ""


def _get_infinit(channel_id: int) -> bool:
    pcfg = _get_playout_config(channel_id)
    return pcfg.get("playlist", {}).get("infinit", False)


def _start_filler(channel_id: int) -> bool:
    """Keep both outputs alive when no valid clip can be played
    (missing source, end of playlist without infinit mode)."""
    filler = _get_filler_source(channel_id)
    if filler:
        return _start_ffmpeg(channel_id, filler, 0, 60)
    return _start_ffmpeg_test_pattern(channel_id)


async def playout_tick(channel_id: int):
    last_index = -1
    last_gen = -1
    while True:
        # a natural ffmpeg exit (clip boundary) is followed by an immediate
        # respawn instead of waiting a full second, so the HLS playlist gets
        # rewritten before players give up on stale segments
        fast_next = False
        try:
            state = playout_states.get(channel_id)
            if not state or not state.get("running"):
                await asyncio.sleep(1)
                continue

            # playlist over and no infinit mode: hold the channel on filler
            # instead of dropping both streams until the next manual start
            if state.get("exhausted"):
                hls_proc = playout_processes.get(f"{channel_id}_hls")
                if not hls_proc or hls_proc.poll() is not None:
                    # a just-exited filler wrote an ENDLIST trailer; players
                    # would stop polling the playlist without the scrub
                    _scrub_hls_endlist(channel_id)
                    _start_filler(channel_id)
                await asyncio.sleep(1)
                continue

            # capture the pre-tick value: a sequential clip transition resets
            # elapsed to 0, so the resume offset must be taken before the
            # counter increments - otherwise every newly started clip is
            # spawned 1s into the file with a 1s shorter duration (SCTE-35
            # break advertised as 19s instead of the full 20s)
            resume_offset = float(state.get("elapsed", 0) or 0)
            state["elapsed"] += 1
            program = state["program"]
            idx = state["index"]

            # live ingest override: freeze the scheduler while the ingest
            # feed is alive, and drop back to the scheduled program (at the
            # position where the switch happened) as soon as it goes away
            if state.get("ingest_active"):
                proc = playout_processes.get(f"{channel_id}_hls")
                if proc and proc.poll() is None:
                    state["elapsed"] -= 1
                    await asyncio.sleep(1)
                    continue
                state["elapsed"] = float(state.get("ingest_elapsed") or 0)
                state["ingest_active"] = False
                state.pop("ingest_elapsed", None)
                state["gen"] = state.get("gen", 0) + 1
                last_index = -1
                _kill_ffmpeg(channel_id)
                print(f"[playout] channel {channel_id}: ingest source ended, "
                      f"switching back to playlist")
                _notify_mail(channel_id, "INFO",
                             "live ingest source ended, switched back to playlist")
                await asyncio.sleep(1)
                continue

            if not program or idx >= len(program):
                infinit = _get_infinit(channel_id)
                if infinit and program:
                    state["index"] = 0
                    state["elapsed"] = 0
                    last_index = -1
                    await asyncio.sleep(1)
                    continue
                now_dt = _get_now_in_tz(_get_channel_timezone(channel_id))
                tomorrow = (now_dt + timedelta(days=1)).strftime("%Y-%m-%d")
                next_program = load_playlist_for_date(channel_id, tomorrow)
                if next_program:
                    state["program"] = next_program
                    state["index"] = 0
                    state["elapsed"] = 0
                    state["day"] = tomorrow
                    _kill_ffmpeg(channel_id)
                    print(f"[playout] channel {channel_id}: playlist exhausted, "
                          f"advanced to next day {tomorrow} ({len(next_program)} clips)")
                    _notify_mail(
                        channel_id, "INFO",
                        f"playlist exhausted, advanced to next day {tomorrow} "
                        f"({len(next_program)} clips)")
                    await asyncio.sleep(1)
                    continue
                state["exhausted"] = True
                state["elapsed"] = 0
                last_index = -1
                print(f"[playout] channel {channel_id}: end of playlist reached, "
                      f"keeping channel alive with filler output")
                _notify_mail(channel_id, "WARNING",
                             "end of playlist reached, channel kept alive with filler output")
                _start_filler(channel_id)
                await asyncio.sleep(1)
                continue

            item = program[idx]
            clip_duration = item.get("out", 0) - item.get("in", 0)
            gen = state.get("gen", 0)

            # a bumped gen (start/restart/reset/next/back) must always
            # (re)spawn ffmpeg, even when the index did not change
            if idx != last_index or gen != last_gen:
                source = item.get("source", "")
                # resume mid-clip: seek to the in-point plus the seconds
                # already elapsed since the item's scheduled begin, so Start
                # lines up with the current time-of-day position;
                # sequential transitions pass resume_offset = 0 and play the
                # clip from its in-point with its full length
                offset = resume_offset
                if _is_ad_clip(source, item):
                    offset = 0.0
                if clip_duration > 0:
                    offset = min(offset, max(clip_duration - 1.0, 0.0))
                    dur = max(clip_duration - offset, 1.0)
                else:
                    offset = 0.0
                    dur = 10
                # a wall clock resync can compute a slightly negative
                # elapsed (rounding at slot boundaries); never seek backwards
                if offset < 0.0:
                    offset = 0.0

                if source and os.path.isfile(source):
                    # clamp the play length to the real media duration minus
                    # the seek position: a wrong out-point in the playlist
                    # must not let ffmpeg exit at file EOF while the
                    # scheduler keeps counting down the (too long) clip,
                    # which leaves both outputs dead in the meantime
                    seek_in = float(item.get("in", 0)) + offset
                    real_dur = _probe_cached(source)
                    if real_dur > 0:
                        dur = min(dur, max(real_dur - seek_in, 1.0))
                    # per clip scte settings from the playlist item win
                    # over the channel wide marker type
                    scte_conf = None
                    clip_mt = str(item.get("scte_marker_type") or "").strip().lower()
                    if _is_ad_clip(source, item) and clip_mt in ("splice_insert", "time_signal"):
                        scte_conf = {
                            "marker_type": clip_mt,
                            "preroll": item.get("scte_preroll") or 0,
                        }
                    try:
                        spawn_ok = _start_ffmpeg(channel_id, source, seek_in, dur, scte_conf, item)
                    except Exception as e:
                        # a broken ad clip or cue must never kill the
                        # playout loop; fall through to the next tick
                        print(f"[playout] channel {channel_id}: ffmpeg spawn "
                              f"failed: {e}")
                        spawn_ok = False
                        _notify_mail(channel_id, "ERROR", f"ffmpeg spawn failed: {e}")
                else:
                    spawn_ok = _start_filler(channel_id)

                state["cur_dur"] = dur

                if spawn_ok:
                    last_index = idx
                    last_gen = gen
                # on a failed spawn leave last_index unset, so the next
                # tick retries instead of staying silent forever

            proc = playout_processes.get(f"{channel_id}_hls")
            # countdown against the clamped duration actually given to
            # ffmpeg, so a bogus playlist out-point cannot stall the loop
            cur_dur = state.get("cur_dur", clip_duration)
            advanced = False
            if proc and proc.poll() is not None:
                # natural ffmpeg exit wrote an ENDLIST trailer into the
                # playlist; strip it so players keep waiting during the
                # transition window instead of quitting the stream
                _scrub_hls_endlist(channel_id)
                advanced = True
                fast_next = True
            elif cur_dur > 0 and state["elapsed"] >= cur_dur:
                advanced = True

            # self heal: a wedged hls muxer leaves the playlist listing
            # segment files that do not exist - players would 404 forever;
            # respawn the current clip instead. a fresh spawn gets a grace
            # window: ffmpeg needs a few seconds to probe the input before
            # the muxer writes the first playlist, and killing it earlier
            # would loop spawn/kill forever
            if (not advanced and proc and proc.poll() is None
                    and time.time() - _SPAWN_AT.get(channel_id, 0.0) > _FFMPEG_STARTUP_GRACE
                    and _hls_playlist_stale(channel_id)):
                print(f"[playout] channel {channel_id}: hls stalled with "
                      f"missing segments, respawning current clip")
                _notify_mail(channel_id, "WARNING",
                             "hls stalled with missing segments, respawning current clip")
                state["gen"] = state.get("gen", 0) + 1
                _kill_ffmpeg(channel_id)
                await asyncio.sleep(1)
                continue

            if advanced:
                nxt = idx + 1
                # drift self healing: sequential transitions clamp durations
                # (real file end, seek clamps), so the internal counter can
                # wander off the wall clock schedule. resync against the
                # channel timezone when the gap grows beyond one slot.
                pcfg = _get_playout_config(channel_id)
                day_start = (pcfg.get("playlist") or {}).get("day_start", "00:00:00")
                rel_sec = _current_rel_seconds(channel_id, day_start)
                exp_idx, exp_elapsed = _get_start_index(program, day_start, channel_id)

                if exp_idx > idx + 1:
                    # wall clock moved beyond the next slot (long stall,
                    # manual seek): jump straight to the scheduled position
                    print(f"[playout] channel {channel_id}: resync to schedule "
                          f"(slot {exp_idx}, was {idx})")
                    state["index"] = exp_idx
                    state["elapsed"] = exp_elapsed
                    last_index = -1
                elif exp_idx <= idx and nxt < len(program):
                    # current clip finished earlier than its scheduled
                    # window (e.g. a mid-slot restart whose resume made it
                    # end before the slot end): instead of holding the
                    # channel on filler for the remainder (minutes of test
                    # pattern on monitoring), resume the SAME clip at its
                    # wall-clock position so it plays out the rest of the
                    # slot; a clip shorter than its slot keeps replaying
                    # until its window begins. filler stays the fallback for
                    # a clip whose media is exhausted or past its end.
                    nxt_begin = float(program[nxt].get("begin", 0) or 0)
                    if nxt_begin - rel_sec > 2.0:
                        replay = False
                        if exp_idx == idx and program[idx].get("source"):
                            real_dur = _probe_cached(program[idx]["source"])
                            seek_pos = (float(program[idx].get("in", 0) or 0)
                                        + float(exp_elapsed or 0))
                            replay = (real_dur <= 0
                                      or seek_pos < real_dur - 1.0)
                        if replay:
                            state["elapsed"] = max(
                                state["elapsed"], float(exp_elapsed or 0))
                            last_index = -1
                        else:
                            state["elapsed"] = max(
                                state["elapsed"], int(cur_dur))
                            _start_filler(channel_id)
                    else:
                        state["index"] = nxt
                        state["elapsed"] = 0
                        last_index = -1
                else:
                    state["index"] = nxt
                    state["elapsed"] = 0
                    last_index = -1

                if state["index"] >= len(program):
                    infinit = _get_infinit(channel_id)
                    if infinit:
                        state["index"] = 0
                    else:
                        now_dt = _get_now_in_tz(_get_channel_timezone(channel_id))
                        tomorrow = (now_dt + timedelta(days=1)).strftime("%Y-%m-%d")
                        next_program = load_playlist_for_date(channel_id, tomorrow)
                        if next_program:
                            state["program"] = next_program
                            state["index"] = 0
                            state["elapsed"] = 0
                            state["day"] = tomorrow
                            _kill_ffmpeg(channel_id)
                            print(f"[playout] channel {channel_id}: playlist exhausted, "
                                  f"advanced to next day {tomorrow} ({len(next_program)} clips)")
                            _notify_mail(
                                channel_id, "INFO",
                                f"playlist exhausted, advanced to next day {tomorrow} "
                                f"({len(next_program)} clips)")
                        else:
                            state["exhausted"] = True
                            print(f"[playout] channel {channel_id}: end of playlist, "
                                  f"keeping channel alive with filler output")
                            _notify_mail(channel_id, "WARNING",
                                         "end of playlist, channel kept alive with filler output")
                            _start_filler(channel_id)
        except Exception:
            import traceback
            print(f"[playout] tick error on channel {channel_id}:")
            traceback.print_exc()

        await asyncio.sleep(0.05 if fast_next else 1)


@app.post("/api/control/{channel_id}/process/")
async def control_process(channel_id: int, request: Request):
    user = get_current_user(request)
    body = await request.json()
    command = body.get("command", "status")

    if command == "status":
        state = playout_states.get(channel_id, {})
        proc = playout_processes.get(f"{channel_id}_hls")
        is_running = state.get("running") and proc and proc.poll() is None
        return "active" if is_running else "inactive"

    state = playout_states.setdefault(channel_id, {
        "running": False, "program": [], "index": 0, "elapsed": 0, "shift": 0,
        "stream_enabled": False,
    })

    # any manual playout/stream command takes the channel out of live ingest
    # mode; the scheduled program takes over again on the next tick
    if command in ("start", "restart", "stream_start", "stream_stop", "stream_restart") and state.get("ingest_active"):
        _kill_ingest(channel_id)
        state["ingest_active"] = False
        state.pop("ingest_elapsed", None)

    # --- streaming output ONLY (UDP/SRT mpegts or HLS ABR ladder);
    # playout + monitoring preview untouched ---
    output_mode = _get_playout_config(channel_id).get("output") or {}
    output_mode = output_mode.get("mode", "stream")

    if command == "stream_start":
        state["stream_enabled"] = True
        if output_mode == "hls":
            _kill_hls_abr(channel_id)
            _spawn_hls_abr(channel_id)
            state["abr_active"] = True
            _notify_mail(channel_id, "INFO", "HLS ABR streaming output started")
            return JSONResponse(status_code=200, content={
                "detail": "HLS ABR streaming output started (playout untouched)",
            })
        _kill_udp(channel_id)
        _spawn_udp(channel_id)
        _notify_mail(channel_id, "INFO", "streaming output started")
        return JSONResponse(status_code=200, content={
            "detail": "Streaming output started (playout untouched)",
        })

    elif command == "stream_stop":
        state["stream_enabled"] = False
        if output_mode == "hls":
            _kill_hls_abr(channel_id)
            state["abr_active"] = False
            _notify_mail(channel_id, "INFO", "HLS ABR streaming output stopped")
            return JSONResponse(status_code=200, content={
                "detail": "HLS ABR streaming output stopped (playout untouched)",
            })
        _kill_udp(channel_id)
        _notify_mail(channel_id, "INFO", "streaming output stopped")
        return JSONResponse(status_code=200, content={
            "detail": "Streaming output stopped (playout untouched)",
        })

    elif command == "stream_restart":
        state["stream_enabled"] = True
        if output_mode == "hls":
            _kill_hls_abr(channel_id)
            _spawn_hls_abr(channel_id)
            state["abr_active"] = True
            _notify_mail(channel_id, "INFO", "HLS ABR streaming output restarted")
            return JSONResponse(status_code=200, content={
                "detail": "HLS ABR streaming output restarted (playout untouched)",
            })
        _kill_udp(channel_id)
        _spawn_udp(channel_id)
        _notify_mail(channel_id, "INFO", "streaming output restarted")
        return JSONResponse(status_code=200, content={
            "detail": "Streaming output restarted (playout untouched)",
        })

    if command == "start":
        state.pop("exhausted", None)
        provided_program = body.get("program", [])
        if provided_program:
            state["program"] = provided_program
        else:
            today = _get_now_in_tz(_get_channel_timezone(channel_id)).strftime("%Y-%m-%d")
            state["program"] = load_playlist_for_date(channel_id, today)

        pcfg = _get_playout_config(channel_id)
        day_start = (pcfg.get("playlist") or {}).get("day_start", "00:00:00")
        idx, elapsed = _get_start_index(state["program"], day_start, channel_id)

        # already playing the scheduled slot? keep it running untouched
        # instead of restarting the clip (redundant Start clicks would
        # otherwise reset mid-clip progress)
        proc = playout_processes.get(f"{channel_id}_hls")
        already_healthy = (
            state.get("running") and proc is not None and proc.poll() is None
        )
        if already_healthy and idx == state.get("index"):
            same_pos = abs(float(state.get("elapsed", 0)) - elapsed)
            if same_pos <= 5.0:
                return JSONResponse(status_code=200, content={
                    "detail": f"Channel is already active at position {idx + 1}/"
                              f"{len(state['program'])} - no restart needed"
                })

        # fresh start (or drifted too far from the wall clock): re-sync to
        # the timezone aware schedule and force a respawn via gen bump
        state["gen"] = state.get("gen", 0) + 1
        state["index"] = idx
        state["elapsed"] = max(elapsed, 0.0)
        state["running"] = True
        _kill_ffmpeg(channel_id)

        # Auto-preprocess: transcode media files to process/ in background
        db = load_db()
        ch_cfg = next((c for c in db["channels"] if c["id"] == channel_id), {})
        if ch_cfg.get("auto_preprocess", False):
            asyncio.create_task(_preprocess_all(channel_id))

        # Background bake of the NNL dynamic graphics (Line1 text drawn onto
        # the rendered base MOVs, cached under media/process/graphics). The
        # cache makes repeated Starts cheap, so this is a fire-and-forget task.
        if state["program"]:
            _nnl_prebuild_task(channel_id, state["program"])

        cur_item = state["program"][idx] if state["program"] and idx < len(state["program"]) else {}
        detail = (
            f"Synced @{_get_now_in_tz(_get_channel_timezone(channel_id)).strftime('%H:%M:%S')} "
            f"{_get_channel_timezone(channel_id)} -> clip {idx + 1}/{len(state['program'])} "
            f"'{cur_item.get('title') or os.path.basename(str(cur_item.get('source', '')))}' "
            f"(table start {_int_to_hms(cur_item.get('begin', 0))}, seek {max(elapsed, 0.0):.1f}s)"
        )
        _notify_mail(channel_id, "INFO", "playout start requested")
        return JSONResponse(status_code=200, content={"detail": detail})

    elif command == "stop":
        state["running"] = False
        _kill_ffmpeg(channel_id)
        _cleanup_hls_files(channel_id, include_m3u8=True)
        _notify_mail(channel_id, "INFO", "playout stopped")

    elif command == "restart":
        state.pop("exhausted", None)
        state["running"] = False
        state["gen"] = state.get("gen", 0) + 1
        _kill_ffmpeg(channel_id)
        state["shift"] = 0
        provided_program = body.get("program", [])
        if provided_program:
            state["program"] = provided_program
        else:
            today = _get_now_in_tz(_get_channel_timezone(channel_id)).strftime("%Y-%m-%d")
            state["program"] = load_playlist_for_date(channel_id, today)

        pcfg = _get_playout_config(channel_id)
        day_start = (pcfg.get("playlist") or {}).get("day_start", "00:00:00")
        idx, elapsed = _get_start_index(state["program"], day_start, channel_id)
        state["index"] = idx
        state["elapsed"] = max(elapsed, 0.0)
        state["running"] = True

        # Auto-preprocess: transcode media files to process/ in background
        db = load_db()
        ch_cfg = next((c for c in db["channels"] if c["id"] == channel_id), {})
        if ch_cfg.get("auto_preprocess", False):
            asyncio.create_task(_preprocess_all(channel_id))

        _notify_mail(channel_id, "INFO", "playout restarted")

    return JSONResponse(status_code=200, content={"detail": f"Command '{command}' acknowledged"})


@app.post("/api/control/{channel_id}/ingest/")
async def control_ingest(channel_id: int, request: Request):
    """Switch the channel to / from the configured live-ingest source.

    The ingest source is taken from the advanced ingest Input Parameter
    (or the playout ingest section).
    Turning ingest on spawns an ffmpeg pull from that source into the 480p
    monitoring preview and the UDP/SRT stream output, replacing the scheduled
    playout until the source goes away (or the same call toggles it off)."""
    user = get_current_user(request)
    try:
        body = await request.json()
    except Exception:
        body = {}
    action = str(body.get("action", "switch")).lower()

    state = playout_states.setdefault(channel_id, {
        "running": False, "program": [], "index": 0, "elapsed": 0, "shift": 0,
        "stream_enabled": False,
    })

    if action == "status":
        return JSONResponse(status_code=200, content={
            "action": "live" if state.get("ingest_active") else "switch",
            "message": "on live ingest source" if state.get("ingest_active") else "on playlist source",
        })

    if action == "switch":
        if state.get("ingest_active"):
            _kill_ingest(channel_id)
            state["ingest_active"] = False
            state["ingest_elapsed"] = float(state.get("elapsed", 0) or 0)
            state["gen"] = state.get("gen", 0) + 1
            _notify_mail(channel_id, "INFO", "switched from live ingest back to playlist")
            return JSONResponse(status_code=200, content={
                "action": "switch",
                "message": "switched back to playlist",
            })

        if not state.get("running"):
            return JSONResponse(status_code=400, content={
                "detail": "Start the playout first, then switch to live ingest",
            })

        if not _ingest_input_param(channel_id):
            return JSONResponse(status_code=400, content={
                "detail": "No ingest input parameter configured "
                          "(Advanced settings > Ingest > Input Parameter)",
            })

        _kill_ffmpeg(channel_id)
        output_mode = (_get_playout_config(channel_id).get("output") or {}).get("mode", "stream")
        if output_mode == "hls":
            _kill_hls_abr(channel_id)
        state["ingest_active"] = True
        state["ingest_elapsed"] = float(state.get("elapsed", 0) or 0)
        if _spawn_ingest(channel_id):
            _notify_mail(channel_id, "INFO", "switched to live ingest source")
            return JSONResponse(status_code=200, content={
                "action": "live",
                "message": "switched to live ingest source",
            })
        state["ingest_active"] = False
        state["gen"] = state.get("gen", 0) + 1
        _notify_mail(channel_id, "ERROR",
                     "ingest ffmpeg could not start - check the input parameter")
        return JSONResponse(status_code=400, content={
            "detail": "Ingest ffmpeg could not start - check the input parameter",
        })

    if action == "stop":
        if state.get("ingest_active"):
            _kill_ingest(channel_id)
            state["ingest_active"] = False
            state["ingest_elapsed"] = float(state.get("elapsed", 0) or 0)
            state["gen"] = state.get("gen", 0) + 1
            _notify_mail(channel_id, "INFO", "switched from live ingest back to playlist")
        return JSONResponse(status_code=200, content={
            "action": "switch",
            "message": "switched back to playlist",
        })

    return JSONResponse(status_code=400, content={"detail": f"Unknown action '{action}'"})


@app.post("/api/preprocess/{channel_id}")
async def preprocess_media(channel_id: int, request: Request):
    """Manually trigger preprocessing of all media files for a channel."""
    user = get_current_user(request)
    asyncio.create_task(_preprocess_all(channel_id))
    return JSONResponse(status_code=200, content={"detail": "Preprocessing started"})


def _resolve_reprocess_target(channel_id: int, raw: str) -> Path:
    """Map a media-library asset path onto the file it really refers to.

    The library serves storage-relative URLs that begin with a slash
    (``/media/process/foo.ts``, ``/subtitles/foo.srt``), but on POSIX
    ``os.path.isabs`` happily calls those filesystem-absolute and the handler
    would resolve them against ``/``. Try the channel storage root and the
    process folder first, and only fall back to treating the string as a real
    absolute path (legacy Windows-style or hand-written API calls).
    """
    storage = _get_channel_storage(channel_id)
    process_dir = _resolve_process_dir(channel_id)
    raw = str(raw)
    stripped = raw.lstrip("/\\").replace("\\", "/")

    candidates = []
    if raw.startswith(("/", "\\")):
        candidates += [storage / stripped, process_dir / stripped]
    elif os.path.isabs(raw):
        candidates += [Path(raw), storage / stripped]
    else:
        candidates += [storage / stripped, process_dir / stripped, Path(raw)]

    for cand in candidates:
        try:
            if cand.exists():
                return cand.resolve()
        except OSError:
            continue
    try:
        return candidates[0].resolve()
    except OSError:
        return candidates[0]


@app.post("/api/media/{channel_id}/reprocess/")
async def reprocess_media(channel_id: int, request: Request):
    """Reprocess a selected set of media assets for a channel.

    Body: `{"sources": ["/media/process/foo.ts", "/media/foo.mp4", ...]}`.
    Each entry is mapped back to its source file and re-transcoded to .ts.
    Paths that already point at a preprocessed ``<process>/x.ts`` are rebuilt
    in place; a raw media/filler source is re-encoded into its ``<process>``
    counterpart. Non-video assets (subtitles, graphics, logo archives) have no
    .ts to build and come back as ``skipped`` instead of ``failed``.

    Returns one entry per source, matching the JSON contract used by the web
    UI: `{path, play_path, process_path, status}`. `path` is the exact
    absolute location of the re-created .ts, `play_path` points at the
    browser-playable remuxed preview and `process_path` at the raw .ts used
    for export/download.
    """
    user = get_current_user(request)
    body = await request.json()
    if isinstance(body, dict):
        paths = body.get("sources", []) or []
    else:
        paths = body or []

    process_dir = _resolve_process_dir(channel_id)
    storage = _get_channel_storage(channel_id)
    pcfg = _get_playout_config(channel_id)
    video_exts = {".ts", ".mp4", ".mov", ".mxf", ".mpg", ".mpeg", ".mkv",
                  ".avi", ".flv", ".wmv", ".webm", ".m4v"}
    try:
        process_root = process_dir.resolve()
    except OSError:
        process_root = process_dir

    async def _transcode(src: Path, ts: Path) -> str:
        """Rebuild `ts` from `src`, returning 'processed' or 'failed'."""
        same_file = False
        tmp_target: Path | None = None
        try:
            ts.parent.mkdir(parents=True, exist_ok=True)
            # When source IS the target .ts (e.g. filler placed as .ts
            # directly), transcode to a temp file first so we don't
            # delete the only copy before re-encoding finishes.
            same_file = src.resolve() == ts.resolve()
            if same_file:
                tmp_target = ts.with_suffix(".tmp.ts")
                cmd = _build_pp_command(storage, pcfg, src, tmp_target)
            else:
                if ts.is_file():
                    ts.unlink()
                cmd = _build_pp_command(storage, pcfg, src, ts)
            proc_ff = await asyncio.create_subprocess_exec(
                *cmd,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE,
                creationflags=_popen_flags(),
            )
            await proc_ff.communicate()
            if proc_ff.returncode == 0:
                if same_file and tmp_target is not None and tmp_target.is_file():
                    ts.unlink(missing_ok=True)
                    tmp_target.rename(ts)
                return "processed"
            if same_file and tmp_target is not None and tmp_target.is_file():
                tmp_target.unlink(missing_ok=True)
        except Exception:
            if same_file and tmp_target is not None and tmp_target.is_file():
                tmp_target.unlink(missing_ok=True)
        return "failed"

    results = []
    for p in paths:
        resolved = _resolve_reprocess_target(channel_id, p)

        if resolved.suffix.lower() not in video_exts:
            # subtitles / graphics / logo archives are already "processed"
            ts_abs = resolved
            status = "skipped"
        else:
            try:
                in_process = resolved.is_relative_to(process_root)
            except (ValueError, OSError, AttributeError):
                in_process = False

            if in_process:
                ts_abs = resolved
                src = _find_source_for_ts(channel_id, ts_abs)
                status = "failed" if src is None else await _transcode(src, ts_abs)
            else:
                # a raw source asset: rebuild its .ts in the process folder
                ts_abs = process_dir / f"{resolved.stem}.ts"
                src = resolved if resolved.is_file() else _find_source_for_ts(
                    channel_id, ts_abs)
                status = "failed" if src is None else await _transcode(src, ts_abs)

        try:
            rel = ts_abs.relative_to(storage.resolve()).as_posix()
        except ValueError:
            rel = ts_abs.name
        results.append({
            "path": str(ts_abs).replace("\\", "/"),
            "play_path": f"/preview/{rel}",
            "process_path": f"/{rel}",
            "status": status,
        })

    return results


@app.post("/api/control/{channel_id}/playout/")
async def control_playout(channel_id: int, request: Request):
    user = get_current_user(request)
    body = await request.json()
    control = body.get("control", "")

    state = playout_states.get(channel_id, {})
    program = state.get("program", [])
    idx = state.get("index", 0)

    if control == "next" and program:
        state.pop("exhausted", None)
        state["index"] = min(idx + 1, len(program) - 1)
        state["elapsed"] = 0
        state["gen"] = state.get("gen", 0) + 1
        _kill_ffmpeg(channel_id)

    elif control == "back" and program:
        state.pop("exhausted", None)
        state["index"] = max(idx - 1, 0)
        state["elapsed"] = 0
        state["gen"] = state.get("gen", 0) + 1
        _kill_ffmpeg(channel_id)

    elif control == "reset":
        state.pop("exhausted", None)
        state["running"] = False
        state["index"] = 0
        state["elapsed"] = 0
        state["shift"] = 0
        state["gen"] = state.get("gen", 0) + 1
        _kill_ffmpeg(channel_id)
        _cleanup_hls_files(channel_id, include_m3u8=True)

    return JSONResponse(status_code=200, content={"detail": "ok"})


@app.post("/api/control/{channel_id}/text/")
async def control_text(channel_id: int, request: Request):
    user = get_current_user(request)
    body = await request.json()
    return JSONResponse(status_code=200, content={"detail": "ok"})


@app.post("/api/control/{channel_id}/graphics/")
async def control_graphics(channel_id: int, request: Request):
    """Trigger a graphic overlay (channel bug) onto the live on-air stream.

    Request body: ``{"action": "enable"|"disable", "duration": seconds,
    "source": "<storage-relative path to the graphic>"}``.

    ``enable`` turns the graphic on immediately over the currently playing
    clip. ``source`` optionally selects a specific processed graphic to show
    (falling back to the configured ``secondary_events.graphic``). When
    ``duration`` is given (>0), the graphic is shown for that many seconds and
    then automatically switched off. ``disable`` turns it off immediately.
    Both actions stay local to the running playout and do not modify the
    persistent playout config.
    """
    get_current_user(request)
    try:
        body = await request.json()
    except Exception:
        body = {}
    action = str(body.get("action") or "").strip().lower()
    try:
        duration = float(body.get("duration") or 0)
    except (TypeError, ValueError):
        duration = 0.0
    source = str(body.get("source") or "").strip().lstrip("/\\")

    if action == "enable":
        if duration and duration > 0:
            _schedule_graphic_autoff(channel_id, duration, source)
        else:
            _set_graphic_runtime(channel_id, True, source)
        return JSONResponse(status_code=200, content={
            "action": "enable", "duration": duration, "detail": "ok"})

    if action == "disable":
        _set_graphic_runtime(channel_id, False)
        return JSONResponse(status_code=200, content={
            "action": "disable", "detail": "ok"})

    return JSONResponse(status_code=400, content={"detail": "action must be 'enable' or 'disable'"})


@app.get("/api/control/{channel_id}/stream-info/")
async def get_stream_info(channel_id: int, request: Request):
    get_current_user(request)
    pcfg = _get_playout_config(channel_id)
    output = pcfg.get("output", {})
    state = playout_states.get(channel_id, {})
    hls_proc = playout_processes.get(f"{channel_id}_hls")
    udp_proc = playout_processes.get(channel_id)

    is_active = state.get("running") and hls_proc and hls_proc.poll() is None

    return {
        "active": is_active,
        "video_pid": output.get("video_pid", 256),
        "audio_pid": output.get("audio_pid", 257),
        "pmt_pid": output.get("pmt_pid", 258),
        "service_id": output.get("service_id", 1),
        "scte_pid": output.get("scte_pid", 768),
        "current_index": state.get("index", 0),
        "elapsed": state.get("elapsed", 0),
        "total_clips": len(state.get("program", [])),
        "hls_pid": hls_proc.pid if hls_proc and hls_proc.poll() is None else None,
        "udp_pid": udp_proc.pid if udp_proc and udp_proc.poll() is None else None,
        "output_param": output.get("output_param", ""),
    }


# === PRESETS ===

@app.get("/api/presets/{channel_id}")
async def get_presets(channel_id: int, request: Request):
    get_current_user(request)
    db = load_db()
    key = str(channel_id)
    return db.get("presets", {}).get(key, [])


@app.post("/api/presets/{channel_id}/")
async def create_preset(channel_id: int, request: Request):
    user = get_current_user(request)
    body = await request.json()
    db = load_db()
    key = str(channel_id)
    presets = db.setdefault("presets", {}).setdefault(key, [])
    new_id = max((p.get("id", 0) for p in presets), default=0) + 1
    body["id"] = new_id
    body["channel_id"] = channel_id
    presets.append(body)
    save_db(db)
    return body


@app.put("/api/presets/{channel_id}/{preset_id}")
async def update_preset(channel_id: int, preset_id: int, request: Request):
    user = get_current_user(request)
    body = await request.json()
    db = load_db()
    key = str(channel_id)
    presets = db.get("presets", {}).get(key, [])
    for i, p in enumerate(presets):
        if p.get("id") == preset_id:
            presets[i] = body
            break
    save_db(db)
    return body


@app.delete("/api/presets/{channel_id}/{preset_id}")
async def delete_preset(channel_id: int, preset_id: int, request: Request):
    user = get_current_user(request)
    db = load_db()
    key = str(channel_id)
    presets = db.get("presets", {}).get(key, [])
    db["presets"][key] = [p for p in presets if p.get("id") != preset_id]
    save_db(db)
    return JSONResponse(status_code=200, content={"detail": "deleted"})


# === PLAYLIST ROUTES ===

_duration_cache: dict[str, float] = {}


def _probe_cached(source: str) -> float:
    if source in _duration_cache:
        return _duration_cache[source]
    dur = _probe_duration(source)
    _duration_cache[source] = dur
    return dur


def _probe_playlist_items(program: list):
    for item in program:
        source = item.get("source", "")
        if source and source not in _duration_cache and Path(source).is_file() and Path(source).suffix.lower() in VIDEO_EXTENSIONS:
            _probe_cached(source)
    for item in program:
        source = item.get("source", "")
        real_dur = _duration_cache.get(source, 0)
        out = item.get("out") or 0
        if real_dur > 0 and not item.get("out"):
            # A segment cut carries its own EOM (out); only fill EOM when the
            # item did not define one explicitly.
            out = round(real_dur, 3)
            item["out"] = out
        clip_dur = 0.0
        if out > 0 and out - float(item.get("in") or 0) > 0:
            clip_dur = round(out - float(item.get("in") or 0), 3)
        elif real_dur > 0:
            clip_dur = round(real_dur, 3)
        if clip_dur > 0:
            item["duration"] = clip_dur


# === AS-RUN IMPORT (primary events + secondary graphic events) ===


def _find_media_by_stem(storage: Path, stem: str) -> str:
    """Resolve an as-run media id (e.g. AFD644966) to a real file in the
    channel storage; exact stem match wins, then first contains-match."""
    if not stem or not storage.is_dir():
        return ""
    low = stem.lower()
    relaxed = ""
    for root, _dirs, files in os.walk(storage):
        for fn in files:
            base, ext = os.path.splitext(fn)
            if ext.lower() not in VIDEO_EXTENSIONS:
                continue
            if base.lower() == low:
                return os.path.join(root, fn)
            if not relaxed and low in base.lower():
                relaxed = os.path.join(root, fn)
    return relaxed


def _se_payload_text(cells: list) -> str:
    """Extract the display text from trailing columns; 'Line1= X' style
    payloads are reduced to their value."""
    for c in cells[8:10]:
        c = c.strip()
        if not c:
            continue
        if "=" in c:
            return c.split("=", 1)[1].strip()
        return c
    return ""


def _parse_as_run(text: str, channel_id: int, fps: float = 25.0) -> list:
    """Parse tab-separated automation as-run exports.

    Primary row:    startTC  durTC  offsetTC  evNum  mediaId  type  primary  template  ...  title  uid
    Secondary row:  startTC  durTC  offsetTC  evNum  name     ..    Secondary  TEMPLATE  ...  Line1= text  uid

    Secondary events are attached to the most recent primary event; offsets
    are relative to the primary event start."""
    items: list = []
    current: dict | None = None
    begin = 0.0
    for raw in text.splitlines():
        line = raw.rstrip("\r\n")
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        cells = [c.strip() for c in line.split("\t")]
        if len(cells) < 8 or len(cells[0].split(":")) != 4:
            continue
        kind = cells[6].lower()
        if kind == "secondary":
            if current is None:
                continue
            offset = _parse_timecode(cells[2], fps)
            dur = _parse_timecode(cells[1], fps)
            template = cells[7] or cells[4] or "custom"
            current.setdefault("secondary_events", []).append({
                "template": template,
                "offset": round(offset, 3),
                "duration": round(dur, 3),
                "in": round(offset, 3),
                "out": round(offset + dur, 3),
                "text": _se_payload_text(cells),
            })
            continue
        dur = _parse_timecode(cells[1], fps)
        if dur <= 0:
            continue
        rec_uid = cells[10] if len(cells) > 10 and cells[10] else f"asrun{uuid.uuid4().hex[:12]}"
        title = ""
        if len(cells) > 9 and cells[9] and not cells[9].lower().startswith("line"):
            title = cells[9]
        elif cells[7]:
            title = cells[7]
        src_id = cells[4]
        resolved = _find_media_by_stem(_get_channel_storage(channel_id), src_id)
        current = {
            "uid": rec_uid,
            "begin": round(begin, 3),
            "title": title,
            "source": resolved or src_id,
            "in": 0.0,
            "out": round(dur, 3),
            "duration": round(dur, 3),
        }
        items.append(current)
        begin += dur
    return items


# === TABULAR / STRUCTURED PLAYLIST IMPORT (CSV, XLSX, JSON, M3U) ===

_HEADER_ALIASES = {
    "start": "begin", "begin": "begin", "time": "begin", "start_time": "begin",
    "starttime": "begin", "onair": "begin", "on_air": "begin", "scheduled": "begin",
    "title": "title", "event": "title", "name": "title", "description": "title",
    "source": "source", "file": "source", "filename": "source", "media": "source",
    "clip": "source", "path": "source", "asset": "source", "mediaid": "source",
    "media_id": "source", "id": "source",
    "duration": "duration", "dur": "duration", "length": "duration", "rundown": "duration",
    "in": "in", "mark_in": "in", "tc_in": "in", "sin": "in",
    "out": "out", "mark_out": "out", "tc_out": "out", "sout": "out",
    "type": "type", "category": "type", "genre": "type", "eventtype": "type",
}

_DEFAULT_COLUMNS = ["begin", "title", "source", "duration", "in", "out", "type"]

_SE_HEADER_RE = re.compile(r"^se_?(\d*)_?(template|in|out|dur|duration|offset|text)$")


def _norm_header(h: str) -> str:
    return re.sub(r"[\s\-]+", "_", str(h or "").strip().lower())


def _parse_time_flexible(val, fps: float = 25.0) -> float | None:
    """Accept HH:MM:SS(.ms), HH:MM:SS:FF timecode, MM:SS, or bare seconds;
    return seconds or None when unparseable."""
    if val is None:
        return None
    s = str(val).strip()
    if not s:
        return None
    try:
        return float(s)
    except ValueError:
        pass
    parts = s.replace(",", ".").split(":")
    try:
        nums = [float(p) for p in parts]
    except ValueError:
        return None
    if len(nums) == 4:
        # broadcast timecode HH:MM:SS:FF (frames at the channel frame rate)
        h, m, sec, f = nums
        return h * 3600 + m * 60 + sec + f / float(fps or 25.0)
    if len(nums) == 3:
        h, m, sec = nums
        return h * 3600 + m * 60 + sec
    if len(nums) == 2:
        return nums[0] * 60 + nums[1]
    return None


def _resolve_import_source(channel_id: int, src: str) -> str:
    """Map an imported source reference to a playable file: absolute path,
    storage relative path, or stem search inside the channel storage."""
    raw = str(src or "").strip().strip('"')
    if not raw:
        return ""
    p = Path(raw)
    if p.is_absolute() and p.is_file():
        return str(p)
    storage = _get_channel_storage(channel_id)
    candidate = storage / raw
    if candidate.is_file():
        return str(candidate)
    stem = p.stem or raw
    found = _find_media_by_stem(storage, stem)
    if found:
        return found
    # keep the original value: the ui flags missing sources in red
    return raw


def _normalize_import_item(it: dict, channel_id: int, fps: float, begin_acc: dict) -> dict:
    """Fill derived fields (uid/begin/duration/in/out/category) for an
    imported playlist entry."""
    src = str(it.get("source") or "").strip()
    title = str(it.get("title") or "").strip()
    if not src and not title:
        return {}
    resolved = _resolve_import_source(channel_id, src or title)

    t_in = it.get("in")
    t_out = it.get("out")
    dur = it.get("duration")
    in_v = _parse_time_flexible(t_in, fps)
    out_v = _parse_time_flexible(t_out, fps)
    dur_v = _parse_time_flexible(dur, fps)

    if out_v is not None and in_v is not None and out_v > in_v:
        calc_dur = out_v - in_v
    elif out_v is not None and in_v is None:
        calc_dur = out_v
        in_v = 0.0
    elif dur_v is not None and dur_v > 0:
        calc_dur = dur_v
    else:
        real = _probe_cached(resolved) if resolved and os.path.isfile(resolved) else 0.0
        calc_dur = real if real > 0 else 10.0

    begin = _parse_time_flexible(it.get("begin"), fps)
    explicit_begin = begin is not None
    begin_acc["explicit"] = begin_acc.get("explicit", True) and explicit_begin
    if not explicit_begin:
        begin = begin_acc["cur"]
    begin_acc["cur"] = float(begin) + calc_dur

    raw_type = str(it.get("type") or "").strip().lower()
    category = "advertisement" if any(
        w in raw_type for w in ("ad", "promo", "commerc")
    ) else ""

    item = {
        "uid": f"imp{uuid.uuid4().hex[:12]}",
        "begin": round(float(begin), 3),
        "title": title or os.path.basename(resolved),
        "source": resolved,
        "in": round(in_v if in_v is not None else 0.0, 3),
        "out": round((in_v if in_v is not None else 0.0) + calc_dur, 3),
        "duration": round(calc_dur, 3),
    }
    if category:
        item["category"] = category
    if isinstance(it.get("secondary_events"), list):
        ses = []
        for ev in it["secondary_events"]:
            if isinstance(ev, dict) and str(ev.get("text") or "").strip():
                e_off = _parse_time_flexible(ev.get("in", ev.get("offset")), fps) or 0.0
                e_out = _parse_time_flexible(ev.get("out"), fps)
                e_dur = _parse_time_flexible(ev.get("duration"), fps)
                if e_out is not None and e_out > e_off:
                    e_len = e_out - e_off
                elif e_dur and e_dur > 0:
                    e_len = e_dur
                else:
                    continue
                ses.append({
                    "template": str(ev.get("template") or "custom"),
                    "offset": round(e_off, 3),
                    "duration": round(e_len, 3),
                    "in": round(e_off, 3),
                    "out": round(e_off + e_len, 3),
                    "text": str(ev["text"]).strip(),
                })
        if ses:
            item["secondary_events"] = ses
    return item


_AUTOMATION_COL_NAMES = {
    "start": "begin", "duration": "duration", "som": "in", "segment_id": "segment",
    "asset_id": "asset", "type": "type", "media_type": "media_type",
    "title": "title", "parameters": "parameters", "reconcile_id": "reconcile",
}


def _detect_automation_header(rows: list) -> tuple | None:
    """Return the automation column index map + header row index, or None.
    Automation exports look like:
    START,DURATION,SOM,SEGMENT ID,ASSET ID,TYPE,MEDIA TYPE,TITLE,PARAMETERS,RECONCILE_ID
    Primary rows carry the clip (ASSET ID -> source), Secondary rows attach
    timed graphics (NOW/NEXT/LATER/Current-Movie) to the previous clip."""
    if not rows:
        return None
    for r_i, row in enumerate(rows[:10]):
        cells = [str(c).strip() if c is not None else "" for c in row]
        norm = [_norm_header(c) for c in cells]
        if "som" not in norm:
            continue
        # the SOM + primary/Secondary vocabulary is what makes this format
        # unambiguous against the plain START/TITLE/SOURCE import layout
        if "media_type" not in norm and "asset_id" not in norm:
            continue
        if not any(h in norm for h in ("start", "begin")):
            continue
        col = {}
        for idx, h in enumerate(norm):
            key = _AUTOMATION_COL_NAMES.get(h)
            if key is not None:
                col[key] = idx
        return col, r_i
    return None


def _parse_automation_playlist(rows: list, channel_id: int, fps: float = 25.0) -> list | None:
    """Parse automation XLSX/CSV exports (see README docs/examples).

    Primary rows (MEDIA TYPE=primary): START (optional, else cumulative),
    DURATION (length), SOM (mark-in / first frame offset), ASSET ID (media,
    resolved against channel storage), TITLE, TYPE (ad/promo/commerc => ad).

    Secondary rows (MEDIA TYPE=Secondary) become timed graphic events attached
    to the previous primary clip: template = ASSET ID (NOW/NEXT/LATER/...),
    offset = SOM, display duration = DURATION, text = PARAMETERS ("Line1= x").
    Returns None when the automation header is not present.
    """
    detected = _detect_automation_header(rows)
    if detected is None:
        return None
    col, header_idx = detected

    items: list = []
    current: dict | None = None
    begin = 0.0
    media_type_idx = col.get("media_type")
    for row in rows[header_idx + 1:]:
        if row is None:
            continue
        cells = list(row) + [None] * 12
        cells = [str(c).strip() if c is not None else "" for c in cells]
        kind = cells[media_type_idx].lower() if media_type_idx is not None else ""

        if kind == "secondary":
            if current is None:
                continue
            template = cells[col.get("asset", 4)] or cells[col.get("title", 7)] or "custom"
            offset = _parse_time_flexible(cells[col.get("in", 2)], fps) or 0.0
            dur = _parse_time_flexible(cells[col.get("duration", 1)], fps)
            if dur is None or dur <= 0:
                continue
            text = _se_payload_text(cells)
            current.setdefault("secondary_events", []).append({
                "template": template,
                "offset": round(offset, 3),
                "duration": round(dur, 3),
                "in": round(offset, 3),
                "out": round(offset + dur, 3),
                "text": text or template,
            })
            continue

        dur = _parse_time_flexible(cells[col.get("duration", 1)], fps)
        if dur is None or dur <= 0:
            continue
        start = _parse_time_flexible(cells[col.get("begin", 0)], fps)
        if start is not None:
            begin = start
        in_v = _parse_time_flexible(cells[col.get("in", 2)], fps) or 0.0
        src_id = cells[col.get("asset", 4)] or cells[col.get("title", 7)]
        resolved = _resolve_import_source(channel_id, src_id)
        raw_type = cells[col.get("type", 5)].lower() if "type" in col else ""
        category = "advertisement" if any(
            w in raw_type for w in ("ad", "promo", "commerc")
        ) else ""
        uid = ""
        if "reconcile" in col:
            uid = cells[col["reconcile"]]
        current = {
            "uid": uid or f"imp{uuid.uuid4().hex[:12]}",
            "begin": round(begin, 3),
            "title": cells[col.get("title", 7)] or os.path.basename(resolved),
            "source": resolved or src_id,
            "in": round(in_v, 3),
            "out": round(in_v + dur, 3),
            "duration": round(dur, 3),
        }
        if category:
            current["category"] = category
        items.append(current)
        begin = float(current["begin"]) + dur
    return items


def _parse_tabular_playlist(rows: list, channel_id: int, fps: float = 25.0) -> list:
    """Shared engine for CSV and XLSX imports; rows are lists of cell values.
    Optional graphics columns se_template/se_in/se_out/se_text (and numbered
    se1_*, se2_*, ...) attach secondary events to their clip."""
    if not rows:
        return []
    automation = _parse_automation_playlist(rows, channel_id, fps)
    if automation is not None:
        return automation
    header_idx = None
    col_map: dict = {}
    se_map: dict = {}
    for r_i, row in enumerate(rows[:5]):
        cells = [str(c).strip() if c is not None else "" for c in row]
        hits = sum(1 for c in cells if _norm_header(c) in _HEADER_ALIASES)
        se_hits = 0
        for idx, c in enumerate(cells):
            h = _norm_header(c)
            m = _SE_HEADER_RE.match(h)
            if m:
                # bare se_* columns form group 0, se1_*/se2_*/... add more
                digits = m.group(1)
                num = int(digits) if digits else 0
                field = {"dur": "duration", "duration": "duration",
                         "offset": "in", "in": "in", "out": "out",
                         "template": "template", "text": "text"}[m.group(2)]
                se_map[(num, field)] = idx
                se_hits += 1
        if hits >= 2 or (se_hits and hits >= 1):
            header_idx = r_i
            for idx, c in enumerate(cells):
                h = _norm_header(c)
                if h in _HEADER_ALIASES:
                    col_map[_HEADER_ALIASES[h]] = idx
            break
    if header_idx is None:
        # positional fallback: Start, Title, Source, Duration, In, Out, Type
        col_map = {k: i for i, k in enumerate(_DEFAULT_COLUMNS)}
        data_rows = rows
    else:
        data_rows = rows[header_idx + 1:]

    items = []
    begin_acc = {"cur": 0.0, "explicit": True}
    for row in data_rows:
        if row is None:
            continue
        cells = list(row) + [None] * 12
        rec: dict = {}
        for field, idx in col_map.items():
            v = cells[idx] if idx < len(cells) else None
            if v is not None and str(v).strip() != "":
                rec[field] = v
        # collect secondary events for this row
        if se_map:
            groups: dict = {}
            for (num, field), idx in se_map.items():
                v = cells[idx] if idx < len(cells) else None
                if v is not None and str(v).strip() != "":
                    groups.setdefault(num, {})[field] = str(v).strip()
            ses = []
            for num in sorted(groups):
                g = groups[num]
                template = g.get("template", "")
                text = g.get("text", "")
                if not template and not text:
                    continue
                ses.append({"template": template or "custom", "text": text,
                            "in": g.get("in"), "out": g.get("out"),
                            "duration": g.get("duration")})
            if ses:
                rec["secondary_events"] = ses
        # graphics-only row: attach to the previous clip instead of a new one
        if not rec.get("source") and not rec.get("title") \
                and rec.get("secondary_events") and items:
            prev = items[-1]
            prev.setdefault("secondary_events", []).extend(rec["secondary_events"])
            continue
        norm = _normalize_import_item(rec, channel_id, fps, begin_acc)
        if norm:
            items.append(norm)
    if not begin_acc.get("explicit", True):
        # mixed/relative begins: re-sequence cumulatively from zero
        cur = 0.0
        for it in items:
            it["begin"] = round(cur, 3)
            cur += it["duration"]
    return items


def _parse_csv_playlist(raw: bytes | str, channel_id: int, fps: float = 25.0) -> list:
    import csv as _csv
    import io as _io
    if isinstance(raw, bytes):
        text = raw.decode("utf-8-sig", errors="replace")
    else:
        text = raw
    sample = text[:4096]
    try:
        d = _csv.Sniffer().sniff(sample, delimiters=",;\t|")
    except Exception:
        d = _csv.excel()
    rows = list(_csv.reader(_io.StringIO(text), delimiter=d.delimiter))
    return _parse_tabular_playlist(rows, channel_id, fps)


def _parse_xlsx_playlist(raw: bytes, channel_id: int, fps: float = 25.0) -> list:
    from openpyxl import load_workbook
    import io as _io
    wb = load_workbook(filename=_io.BytesIO(raw), read_only=True, data_only=True)
    ws = wb.active
    rows = [list(r) for r in ws.iter_rows(values_only=True)]
    wb.close()
    return _parse_tabular_playlist(rows, channel_id, fps)


def _parse_json_playlist(raw: bytes | str, channel_id: int, fps: float = 25.0) -> list:
    """Accept ffplayout program exports ({channel,date,program}), bare arrays,
    or single objects."""
    if isinstance(raw, bytes):
        text = raw.decode("utf-8-sig", errors="replace")
    else:
        text = raw
    data = json.loads(text)
    if isinstance(data, dict):
        for key in ("program", "playlist", "items"):
            if isinstance(data.get(key), list):
                data = data[key]
                break
        else:
            data = [data]
    begin_acc = {"cur": 0.0, "explicit": True}
    items = []
    for it in data:
        if not isinstance(it, dict):
            continue
        norm = _normalize_import_item(it, channel_id, fps, begin_acc)
        if norm:
            items.append(norm)
    if not begin_acc.get("explicit", True):
        cur = 0.0
        for it in items:
            it["begin"] = round(cur, 3)
            cur += it["duration"]
    return items


def _parse_m3u_playlist(raw: bytes | str, channel_id: int, fps: float = 25.0) -> list:
    """M3U/M3U8 playlists: #EXTINF:dur,title + path lines; optional
    '#EXT-X-ASRUN:<template>|<in>|<out>|<text>' tags attach graphics."""
    if isinstance(raw, bytes):
        text = raw.decode("utf-8-sig", errors="replace")
    else:
        text = raw
    items: list = []
    pending_se: list = []
    cur: dict | None = None
    begin = 0.0
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        low = line.lower()
        if low.startswith("#ext-x-asrun:"):
            parts = line.split(":", 1)[1].split("|")
            pending_se.append({
                "template": parts[0].strip() if parts else "custom",
                "text": parts[3].strip() if len(parts) > 3 else "",
                "in": parts[1].strip() if len(parts) > 1 else "",
                "out": parts[2].strip() if len(parts) > 2 else "",
                "duration": "",
            })
            continue
        if low.startswith("#extinf:"):
            dur_s = ""
            title = ""
            rest = line.split(":", 1)[1]
            if "," in rest:
                dur_s, title = rest.split(",", 1)
            else:
                dur_s = rest
            try:
                dur = float(dur_s.strip().split(" ")[0])
            except ValueError:
                dur = -1.0
            cur = {"title": title.strip(), "source": "", "duration": dur}
            continue
        if line.startswith("#"):
            continue
        # media path line
        src = _resolve_import_source(channel_id, line)
        if cur is None:
            cur = {"title": "", "source": "", "duration": -1.0}
        cur["source"] = src or line
        if not cur.get("title"):
            cur["title"] = Path(line).stem
        dur = cur.get("duration", -1.0)
        if not dur or dur <= 0:
            real = _probe_cached(src) if src and os.path.isfile(src) else 0.0
            dur = real if real > 0 else 10.0
        rec = {
            "uid": f"m3u{uuid.uuid4().hex[:12]}",
            "begin": round(begin, 3),
            "title": cur.get("title") or "",
            "source": cur["source"],
            "in": 0.0,
            "out": round(dur, 3),
            "duration": round(dur, 3),
        }
        if pending_se:
            rec["_raw_se"] = pending_se
        items.append(rec)
        begin += dur
        cur = None
        pending_se = []

    # normalize secondary events through the shared normalizer
    begin_acc = {"cur": 0.0, "explicit": True}
    normalized = []
    for it in items:
        rec = {
            "title": it["title"],
            "source": it["source"],
            "duration": it["duration"],
            "secondary_events": it.pop("_raw_se", []),
        }
        norm = _normalize_import_item(rec, channel_id, fps, begin_acc)
        if norm:
            normalized.append(norm)
    return normalized


@app.get("/api/playlist/{channel_id}")
async def get_playlist(channel_id: int, request: Request):
    get_current_user(request)
    date = request.query_params.get("date", datetime.now().strftime("%Y-%m-%d"))
    db = load_db()
    pl_file = DATA_DIR / "playlists" / f"{channel_id}_{date}.json"
    if pl_file.exists():
        with open(pl_file, "r", encoding="utf-8") as f:
            data = json.load(f)
        await asyncio.get_event_loop().run_in_executor(None, _probe_playlist_items, data.get("program", []))
        return data
    return {"channel": str(channel_id), "date": date, "program": []}


@app.post("/api/playlist/{channel_id}/")
async def save_playlist(channel_id: int, request: Request):
    user = get_current_user(request)
    body = await request.json()

    # The body is written to disk verbatim, so a caller that sends the wrong
    # shape ({"items": [...]} instead of {"program": [...]}) silently replaces a
    # real playlist with something the engine cannot read. Refuse that instead.
    # An empty program is legitimate - it clears the day on purpose.
    # This must run before body.get("date") or a non-dict body 500s.
    if not isinstance(body, dict) or ("program" not in body and body):
        got = ", ".join(sorted(map(str, body))) if isinstance(body, dict) else type(body).__name__
        raise HTTPException(
            status_code=400,
            detail=f"playlist body must be an object containing 'program' (list); got: {got}",
        )

    program = body.get("program", [])
    if not isinstance(program, list):
        raise HTTPException(status_code=400, detail="'program' must be a list")

    date = body.get("date", datetime.now().strftime("%Y-%m-%d"))

    await asyncio.get_event_loop().run_in_executor(None, _probe_playlist_items, program)

    db = load_db()
    pl_file = DATA_DIR / "playlists" / f"{channel_id}_{date}.json"
    # write-then-rename so a crash mid-write cannot leave a truncated playlist
    tmp = pl_file.with_suffix(".json.tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(body, f, indent=2, ensure_ascii=False)
    os.replace(tmp, pl_file)
    return "Playlist saved"


@app.delete("/api/playlist/{channel_id}/{date}")
async def delete_playlist(channel_id: int, date: str, request: Request):
    user = get_current_user(request)
    pl_file = DATA_DIR / "playlists" / f"{channel_id}_{date}.json"
    if pl_file.exists():
        pl_file.unlink()
    return JSONResponse(status_code=200, content={"detail": "deleted"})


@app.post("/api/playlist/{channel_id}/generate/{date}")
async def generate_playlist(channel_id: int, date: str, request: Request):
    user = get_current_user(request)
    body = await request.json() if request.headers.get("content-length", "0") != "0" else {}
    db = load_db()
    channel = None
    for c in db["channels"]:
        if c["id"] == channel_id:
            channel = c
            break
    if not channel:
        raise HTTPException(status_code=404, detail="Channel not found")

    storage = Path(channel.get("storage", str(DATA_DIR / "storage" / "Channel 1")))
    source = body.get("source", "")
    if source and source != "/":
        target = storage / source.lstrip("/")
    else:
        target = storage

    pcfg = _get_playout_config(channel_id)
    storage_cfg = pcfg.get("storage", {})
    ext_list = storage_cfg.get("extensions", [])
    if isinstance(ext_list, str):
        ext_list = [e.strip().lower() for e in ext_list.split(",") if e.strip()]
    else:
        ext_list = [e.lower() for e in ext_list]
    allowed_exts = set(f".{e}" for e in ext_list) if ext_list else set(VIDEO_EXTENSIONS)

    shuffle_enabled = storage_cfg.get("shuffle", False)

    program = []
    begin = 0.0
    if target.is_dir():
        items = [item for item in target.iterdir()
                 if not item.name.startswith(".") and item.is_dir() == False
                 and item.suffix.lower() in allowed_exts]
        if shuffle_enabled:
            import random
            random.shuffle(items)
        else:
            items = sorted(items)
        for item in items:
            dur = _probe_duration(str(item))
            if dur <= 0:
                dur = 10.0
            program.append({
                "date": date,
                "uid": str(uuid.uuid4()),
                "begin": begin,
                "title": item.stem,
                "source": str(item),
                "duration": round(dur, 3),
                "in": 0,
                "out": round(dur, 3),
            })
            begin += dur
    return {"channel": str(channel_id), "date": date, "program": program}


# === FILE BROWSER ===

@app.post("/api/file/{channel_id}/browse/")
async def browse_files(channel_id: int, request: Request):
    user = get_current_user(request)
    body = await request.json()
    source = body.get("source", "")
    folders_only = body.get("folders_only", False)

    db = load_db()
    channel = None
    for c in db["channels"]:
        if c["id"] == channel_id:
            channel = c
            break

    if not channel:
        raise HTTPException(status_code=404, detail="Channel not found")

    base = Path(channel.get("storage", str(DATA_DIR / "storage" / "Channel 1")))

    if source and source != "/":
        target = base / source.lstrip("/")
    else:
        target = base

    if not target.exists():
        target.mkdir(parents=True, exist_ok=True)

    pcfg = _get_playout_config(channel_id)
    storage_cfg = pcfg.get("storage", {})
    ext_list = storage_cfg.get("extensions", [])
    if isinstance(ext_list, str):
        ext_list = [e.strip().lower() for e in ext_list.split(",") if e.strip()]
    else:
        ext_list = [e.lower() for e in ext_list]
    allowed_exts = set(f".{e}" for e in ext_list) if ext_list else None

    folders = []
    files = []

    def _scan():
        try:
            for item in sorted(target.iterdir()):
                if item.name.startswith("."):
                    continue
                if item.is_dir():
                    folders.append(item.name)
                elif not folders_only:
                    if allowed_exts and item.suffix.lower() not in allowed_exts \
                            and item.suffix.lower() not in GRAPHIC_ARCHIVE_EXTS:
                        continue
                    dur = _probe_duration(str(item)) if item.suffix.lower() in VIDEO_EXTENSIONS else 0.0
                    files.append({"name": item.name, "duration": round(dur, 3)})
        except PermissionError:
            pass

    await asyncio.get_event_loop().run_in_executor(None, _scan)

    parent_str = str(target.relative_to(base)) if target != base else ""
    parent_folders = []
    if parent_str:
        parts = parent_str.split(os.sep)
        cumulative = ""
        for p in parts:
            cumulative = f"{cumulative}/{p}" if cumulative else p
            parent_folders.append(cumulative)

    return {
        "source": source.strip("/") if source else "",
        "parent": str(base),
        "parent_folders": parent_folders,
        "folders": folders,
        "files": files,
    }


@app.post("/api/file/{channel_id}/exists/")
async def check_files_exist(channel_id: int, request: Request):
    """Report which of the given source references are missing on disk.

    Each source may be an absolute path, a storage-relative path, or a stem
    that is found by walking the channel storage (same resolution rules the
    playout engine uses). Only genuinely missing files are returned.
    """
    get_current_user(request)
    body = await request.json()
    sources = body.get("sources") or []
    if not isinstance(sources, list):
        sources = [sources]

    storage = _get_channel_storage(channel_id)
    missing = []

    def _check_one(raw_p: str) -> bool:
        raw = str(raw_p or "").strip().strip('"')
        if not raw:
            return False
        p = Path(raw)
        if p.is_absolute():
            return p.is_file()
        candidate = storage / raw.lstrip("/\\")
        if candidate.is_file():
            return True
        return bool(_find_media_by_stem(storage, p.stem or raw))

    def _scan():
        for src in sources:
            if not _check_one(src):
                missing.append(src)

    await asyncio.get_event_loop().run_in_executor(None, _scan)

    return {"missing": missing}


def _probe_file_meta(file_path: str) -> dict:
    """Probe a media file for duration, audio stream count and frame rate.

    The returned mapping also carries a ``probe`` key with the raw format and
    stream details (codec, resolution, bitrate, size, start timecode and the
    audio/subtitle stream lists) so the UI can render the asset details popup.
    """
    info = {"duration": 0.0, "audio": 0, "frame_rate": "", "video": False, "audio_present": False}
    probe: dict = {}
    try:
        result = subprocess.run(
            [FFPROBE_BIN, "-v", "quiet", "-print_format", "json",
             "-show_streams", "-show_format", file_path],
            capture_output=True, text=True, timeout=10,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
        data = json.loads(result.stdout or "{}")
        streams = data.get("streams", []) or []
        fmt = data.get("format", {}) or {}
        video_fps = ""
        audio_count = 0
        video_stream = None
        audio_streams = []
        subtitle_streams = []
        for s in streams:
            codec_type = s.get("codec_type")
            if codec_type == "video":
                info["video"] = True
                if not video_fps:
                    video_fps = s.get("r_frame_rate", "") or s.get("avg_frame_rate", "")
                if video_stream is None:
                    video_stream = s
            elif codec_type == "audio":
                info["audio_present"] = True
                audio_count += 1
                audio_streams.append(s)
            elif codec_type == "subtitle":
                subtitle_streams.append(s)
        info["audio"] = audio_count
        info["frame_rate"] = video_fps

        def _num(value) -> float:
            try:
                return float(value or 0)
            except (TypeError, ValueError):
                return 0.0

        probe = {
            "size": _num(fmt.get("size")),
            "bit_rate": _num(fmt.get("bit_rate")),
            "start_time": _num(fmt.get("start_time")),
        }
        if video_stream is not None:
            probe["codec"] = video_stream.get("codec_name", "")
            probe["profile"] = video_stream.get("profile", "") or ""
            probe["width"] = int(_num(video_stream.get("width")))
            probe["height"] = int(_num(video_stream.get("height")))
            probe["sample_aspect_ratio"] = video_stream.get("sample_aspect_ratio", "")
            probe["display_aspect_ratio"] = video_stream.get("display_aspect_ratio", "")
            probe["field_order"] = video_stream.get("field_order", "")
            probe["r_frame_rate"] = video_fps
        probe["audio"] = audio_streams
        probe["subtitles"] = subtitle_streams
        info["probe"] = probe

        dur = fmt.get("duration")
        if not dur and streams:
            for s in streams:
                if s.get("duration"):
                    dur = s["duration"]
                    break
        if dur:
            info["duration"] = float(dur)
    except Exception:
        info["duration"] = _probe_duration(file_path)
        info["probe"] = probe
    return info


def _parse_frame_rate(frame_rate: str) -> float:
    try:
        num, _, den = frame_rate.partition("/")
        if not num:
            return 0.0
        num = float(num)
        den = float(den) if den else 1.0
        return round(num / den, 3) if den else 0.0
    except Exception:
        return 0.0


def _smpte_time(seconds: float, fps: float = 25.0) -> str:
    """Format seconds as HH:MM:SS:FF."""
    fps = fps if fps > 0 else 25.0
    total = max(0, int(round(seconds * fps)))
    ff = total % int(fps)
    total_sec = total // int(fps)
    s = total_sec % 60
    m = (total_sec // 60) % 60
    h = total_sec // 3600
    return f"{h:02d}:{m:02d}:{s:02d}:{ff:02d}"


def _library_media_type(category: str) -> str:
    return {
        "videos": "video",
        "audio": "audio",
        "graphics": "image",
        "rescue": "video",
        "subtitles": "subtitle",
    }.get(category, "video")


def _segment_length_seconds(duration: float) -> int:
    """Timeline granularity for an asset, in seconds.

    Long-form programming (>= 1h) is shown in 5-minute blocks so a broad-
    cast-quality timeline stays usable; medium clips use 1-minute blocks and
    everything else keeps the classic 30-second segments.
    """
    if duration >= 3600:
        return 300
    if duration >= 600:
        return 60
    return 30


def _collect_files(root_dir: Path, allowed_exts: set, skip_dirs=()) -> list:
    """Recursively collect media files under root_dir, skipping skip_dirs."""
    files = []
    for dirpath, dirnames, filenames in os.walk(root_dir):
        dirnames[:] = [d for d in dirnames if (Path(dirpath) / d).resolve() not in skip_dirs]
        for name in filenames:
            p = Path(dirpath) / name
            if not allowed_exts or p.suffix.lower() in allowed_exts:
                files.append(p)
    files.sort(key=lambda p: p.name)
    return files


@app.get("/api/media/library/{channel_id}")
async def get_media_library(channel_id: int, request: Request):
    user = get_current_user(request)
    storage = _get_channel_storage(channel_id)
    pcfg = _get_playout_config(channel_id)
    storage_cfg = pcfg.get("storage", {}) or {}

    ext_list = storage_cfg.get("extensions", [])
    if isinstance(ext_list, str):
        ext_list = [e.strip().lower() for e in ext_list.split(",") if e.strip()]
    else:
        ext_list = [e.lower() for e in ext_list]
    allowed_exts = set(f".{e}" for e in ext_list) if ext_list else None

    process_dir = _resolve_process_dir(channel_id)
    media_dir = storage.parent if process_dir == storage else storage / "media"
    graphics_dir = media_dir / "graphics"
    subtitles_dir = storage / "subtitles"
    filler_dir = storage / "filler"

    # Fall back to a sane video/audio extension set when the config does not
    # list any extensions, so the library never comes back empty.
    if not allowed_exts:
        allowed_exts = set(f".{e}" for e in ("mp4", "mov", "mxf", "mpg", "mpeg",
                                             "mkv", "avi", "ts", "flv", "wmv",
                                             "webm", "m4v", "mp3", "wav", "aac",
                                             "ogg", "flac"))

    # Videos and filler (=rescue) are shown as their preprocessed .ts outputs,
    # because raw sources (.mpg/.ts etc.) use codecs browsers cannot decode.
    # Graphics and subtitles keep their own files.
    def _asset_relative(file: Path) -> str:
        try:
            relative = file.resolve().relative_to(storage.resolve())
        except ValueError:
            relative = file
        return relative.as_posix()

    # A sidecar subtitle file (by stem) enables closed captions on a matching
    # video (the cc badge). The preview player shows a WebVTT track, which
    # browsers can only render from .vtt or .srt (converted on the fly), so
    # only those fold into subtitle_map and set the `subtitle` field.
    subtitle_exts = {".srt", ".vtt", ".ass", ".ssa", ".stl", ".scc", ".sub", ".ttml"}
    _subtitle_pref = {".vtt": 0, ".srt": 1}
    subtitle_map: dict = {}
    subtitles_stems = set()
    if subtitles_dir.is_dir():
        for sf in _collect_files(subtitles_dir, subtitle_exts):
            subtitles_stems.add(sf.stem)
            if sf.suffix.lower() not in _subtitle_pref:
                continue
            prev = subtitle_map.get(sf.stem)
            if prev is None or _subtitle_pref.get(Path(prev).suffix.lower(), 99) > \
                    _subtitle_pref.get(sf.suffix.lower(), 99):
                subtitle_map[sf.stem] = _asset_relative(sf)

    logo_dir = _animated_logo_dir(channel_id)
    folders = [
        ("graphics", graphics_dir, {".jpg", ".jpeg", ".png", ".webp", ".gif", ".svg", ".tif", ".tiff"} | allowed_exts, False),
        ("subtitles", subtitles_dir, subtitle_exts, False),
        ("logo", logo_dir, {".png", ".jpg", ".jpeg"}, False),
    ]

    # Also scan the channel's logo folder (storage/logo/) for zip archives
    # so animated logo zips appear in the Logos category.
    storage_logo_dirs = _logo_candidate_folders(storage)
    scanned_logo_dirs = {str(logo_dir.resolve())}

    def _scan_sync() -> list:
        assets = []
        # Graphics, subtitles and filler (rescue) assets.
        for default_category, folder, exts, media_folder in folders:
            if not folder.is_dir():
                continue
            for file in _collect_files(folder, exts):
                meta = _probe_file_meta(str(file))
                fps = _parse_frame_rate(meta["frame_rate"])
                rel = _asset_relative(file)
                assets.append({
                    "asset_id": file.stem,
                    "title": file.name,
                    "category": default_category,
                    "media_type": _library_media_type(default_category),
                    "segments": int(math.ceil(meta["duration"] / _segment_length_seconds(meta["duration"]))) if meta["duration"] > 0 else 0,
                    "duration": _smpte_time(meta["duration"], fps),
                    "duration_seconds": round(meta["duration"], 3),
                    "audio": meta["audio"],
                    "cc": file.stem in subtitles_stems,
                    "probe": meta.get("probe", {}),
                    "segment_length": _segment_length_seconds(meta["duration"]),
                    "status": "processed",
                    "frame_rate": f"{fps:g}" if fps > 0 else "",
                    "path": f"/{rel}",
                    "play_path": f"/{rel}",
                })

        # Scan additional logo directories (storage/logo/) for zip archives
        # so animated logo zips appear in the Logos category.
        for extra_logo_dir in storage_logo_dirs:
            if not extra_logo_dir.is_dir():
                continue
            dir_key = str(extra_logo_dir.resolve())
            if dir_key in scanned_logo_dirs:
                continue
            scanned_logo_dirs.add(dir_key)
            for file in _collect_files(extra_logo_dir, {".zip"}):
                rel = _asset_relative(file)
                # A zip is a source archive: it is only "processed" once its
                # alpha .mov output exists in the processed logo dir.
                out = _animated_logo_target(channel_id, str(file))
                has_out = bool(out and out.is_file())
                # Point the preview at the browser-playable webm copy, falling
                # back to the raw .mov if the webm was not generated.
                preview = out.parent / f"{out.stem}_preview.webm" if out else None
                if has_out and preview and preview.is_file():
                    play_rel = preview.resolve().relative_to(storage.resolve()).as_posix()
                elif has_out:
                    play_rel = out.resolve().relative_to(storage.resolve()).as_posix()
                else:
                    play_rel = rel
                assets.append({
                    "asset_id": file.stem,
                    "title": file.name,
                    "category": "logo",
                    "media_type": "image" if not has_out else "video",
                    "segments": 0,
                    "duration": "00:00:00",
                    "duration_seconds": 0,
                    "audio": 0,
                    "cc": False,
                    "status": "processed" if has_out else "failed",
                    "frame_rate": "",
                    "path": f"/{rel}",
                    "play_path": f"/{play_rel}",
                    "process_path": f"/{rel}",
                    "graphic_source": f"/{rel}",
                })

        # Scan additional graphics directories (storage/graphics/ etc.) for
        # zip archives so uploaded graphic source sequences (TGA frames with
        # alpha, e.g. a channel "Bug") appear under the Graphics category.
        # They are "processed" once their alpha .mov output exists in the
        # processed graphics dir.
        graphics_dirs = _graphic_candidate_folders(storage)
        scanned_graphics_dirs = {str(graphics_dir.resolve())}
        seen_graphics_rels = set()
        seen_blend_rels = set()
        # Folders treated as logo archives should never be surfaced under the
        # Graphics category (e.g. a logo zip nested inside storage/logo/).
        logo_roots = []
        seen_logo_roots = set()
        for folder in _logo_candidate_folders(storage):
            try:
                key = str(folder.resolve())
            except OSError:
                key = str(folder)
            if key in seen_logo_roots:
                continue
            seen_logo_roots.add(key)
            logo_roots.append(folder)

        def _in_logo_root(file: Path) -> bool:
            resolved = str(file.resolve())
            for root in logo_roots:
                try:
                    file.resolve().relative_to(root.resolve())
                    return True
                except ValueError:
                    pass
                if resolved.startswith(str(root)):
                    return True
            return False

        for extra_graphics_dir in graphics_dirs:
            if not extra_graphics_dir.is_dir():
                continue
            dir_key = str(extra_graphics_dir.resolve())
            if dir_key in scanned_graphics_dirs:
                continue
            scanned_graphics_dirs.add(dir_key)
            for file in _collect_files(extra_graphics_dir, {".zip"}):
                if _in_logo_root(file):
                    continue
                rel = _asset_relative(file)
                if rel in seen_graphics_rels:
                    continue
                seen_graphics_rels.add(rel)
                rel = _asset_relative(file)

                # NOW/NEXT/LATER/Current-Movie: After-Effects NNL templates.
                # They are "processed" once at least one alpha MOV has been
                # baked for the template (the Line1 per movie); the preview
                # points at the most recent webm copy.
                nnl_tpl = _nnl_template_for_zip(str(file))
                if nnl_tpl:
                    baked = _nnl_cached_for_template(channel_id, nnl_tpl)
                    has_out = bool(baked)
                    preview = next((b.parent / f"{b.stem}_preview.webm"
                                    for b in baked
                                    if (b.parent / f"{b.stem}_preview.webm").is_file()),
                                   None)
                    if preview:
                        play_rel = _asset_relative(preview)
                    elif has_out:
                        play_rel = _asset_relative(baked[0])
                    else:
                        play_rel = rel
                    assets.append({
                        "asset_id": file.stem,
                        "title": file.name,
                        "category": "graphics",
                        "media_type": "video" if has_out else "image",
                        "segments": 0,
                        "duration": "00:00:00",
                        "duration_seconds": 0,
                        "audio": 0,
                        "cc": False,
                        "status": "processed" if has_out else "failed",
                        "frame_rate": "",
                        "path": f"/{rel}",
                        "play_path": f"/{play_rel}",
                        "process_path": f"/{rel}",
                        "graphic_source": f"/{rel}",
                    })
                    continue

                out = _animated_graphic_target(channel_id, str(file))
                has_out = bool(out and out.is_file())
                preview = out.parent / f"{out.stem}_preview.webm" if out else None
                if has_out and preview and preview.is_file():
                    play_rel = preview.resolve().relative_to(storage.resolve()).as_posix()
                elif has_out:
                    play_rel = out.resolve().relative_to(storage.resolve()).as_posix()
                else:
                    play_rel = rel
                assets.append({
                    "asset_id": file.stem,
                    "title": file.name,
                    "category": "graphics",
                    "media_type": "image" if not has_out else "video",
                    "segments": 0,
                    "duration": "00:00:00",
                    "duration_seconds": 0,
                    "audio": 0,
                    "cc": False,
                    "status": "processed" if has_out else "failed",
                    "frame_rate": "",
                    "path": f"/{rel}",
                    "play_path": f"/{play_rel}",
                    "process_path": f"/{rel}",
                    "graphic_source": f"/{rel}",
                })

        # Blender scenes: the authored NNL .blend sources in graphics/NNL get
        # their own cards so the operator sees the render source is recognized
        # (processed only once at least one MOV was produced for the template).
        blend_dir = _get_channel_storage(channel_id) / "graphics" / _NNL_SOURCE_DIRNAME
        if blend_dir.is_dir():
            for file in _collect_files(blend_dir, {".blend"}):
                b_tpl = _nnl_template_for_zip(str(file))
                if not b_tpl:
                    continue
                brel = _asset_relative(file)
                if brel in seen_blend_rels:
                    continue
                seen_blend_rels.add(brel)
                bbaked = _nnl_cached_for_template(channel_id, b_tpl)
                bhas = bool(bbaked)
                bplay = brel
                if bbaked:
                    bpv = next((b.parent / f"{b.stem}_preview.webm"
                                for b in bbaked
                                if (b.parent / f"{b.stem}_preview.webm").is_file()),
                               None)
                    bplay = _asset_relative(bpv) if bpv else _asset_relative(bbaked[0])
                assets.append({
                    "asset_id": file.stem,
                    "title": file.name,
                    "category": "graphics",
                    "media_type": "video" if bhas else "image",
                    "segments": 0,
                    "duration": "00:00:00",
                    "duration_seconds": 0,
                    "audio": 0,
                    "cc": False,
                    "status": "processed" if bhas else "failed",
                    "frame_rate": "",
                    "path": f"/{brel}",
                    "play_path": f"/{bplay}",
                    "process_path": f"/{brel}",
                    "graphic_source": f"/{brel}",
                })

        # Processed NNL dynamic graphics: the alpha MOVs baked per (template,
        # movie title) from the playlist Line1 value, plus their webm previews.
        assets.extend(_nnl_library_assets(channel_id, _asset_relative))

        # Rescue (filler) tab: show the preprocessed .ts for each filler file
        # (browser-playable H.264/AAC) so users see and play the .ts rather
        # than the raw mp4/mxf/mov source. Falls back to the raw file when no
        # preprocessed .ts exists yet.
        if filler_dir.is_dir():
            video_ext_set = allowed_exts or {f".{e}" for e in _get_process_extensions()}
            for file in _collect_files(filler_dir, video_ext_set):
                ts = _preprocessed_path(channel_id, str(file))
                display = ts if (ts and ts.is_file()) else file
                meta = _probe_file_meta(str(display))
                fps = _parse_frame_rate(meta["frame_rate"])
                rel = _asset_relative(display)
                if display == ts:
                    abs_path = str(display).replace("\\", "/")
                    assets.append({
                        "asset_id": display.stem,
                        "title": display.name,
                        "category": "rescue",
                        "media_type": _library_media_type("rescue"),
                        "segments": int(math.ceil(meta["duration"] / _segment_length_seconds(meta["duration"]))) if meta["duration"] > 0 else 0,
                        "duration": _smpte_time(meta["duration"], fps),
                        "duration_seconds": round(meta["duration"], 3),
                        "audio": meta["audio"],
                        "cc": display.stem in subtitles_stems,
                        "probe": meta.get("probe", {}),
                        "segment_length": _segment_length_seconds(meta["duration"]),
                        "subtitle": subtitle_map.get(display.stem, ""),
                        "status": _ts_status(channel_id, display),
                        "frame_rate": f"{fps:g}" if fps > 0 else "",
                        "path": abs_path,
                        "play_path": f"/preview/{rel}",
                        "process_path": f"/{rel}",
                    })
                else:
                    assets.append({
                        "asset_id": file.stem,
                        "title": file.name,
                        "category": "rescue",
                        "media_type": _library_media_type("rescue"),
                        "segments": int(math.ceil(meta["duration"] / _segment_length_seconds(meta["duration"]))) if meta["duration"] > 0 else 0,
                        "duration": _smpte_time(meta["duration"], fps),
                        "duration_seconds": round(meta["duration"], 3),
                        "audio": meta["audio"],
                        "cc": file.stem in subtitles_stems,
                        "probe": meta.get("probe", {}),
                        "segment_length": _segment_length_seconds(meta["duration"]),
                        "subtitle": subtitle_map.get(file.stem, ""),
                        "status": "processed",
                        "frame_rate": f"{fps:g}" if fps > 0 else "",
                        "path": f"/{_asset_relative(file)}",
                        "play_path": f"/{_asset_relative(file)}",
                    })

        # Videos tab: only the preprocessed .ts outputs under process/, which
        # are browser-playable (H.264/AAC). Each is classified as processed /
        # processing / failed from its probe + source comparison. `path` is
        # the exact absolute location, `play_path` points at the on-the-fly
        # remuxed preview, `process_path` at the raw .ts for export/download.
        # Filler .ts outputs live in the separate process/filler/ subtree and
        # belong to the Rescue tab only, so they are skipped here.
        if process_dir.is_dir():
            filler_process_dir = process_dir / "filler"
            for file in _collect_files(process_dir, {".ts"}, skip_dirs=(filler_process_dir,)):
                meta = _probe_file_meta(str(file))
                fps = _parse_frame_rate(meta["frame_rate"])
                rel = _asset_relative(file)
                abs_path = str(file).replace("\\", "/")
                tc_store = _media_tc_for(channel_id, file.stem)
                default_in = float(meta.get("probe", {}).get("start_time") or 0)
                tc_in = float(tc_store.get("in", default_in))
                seg_custom, seg_store = _asset_segments_state(channel_id, file.stem)
                kept_dur = float(_kept_duration_seconds(seg_store)) if seg_custom else meta["duration"]
                playout_dur = kept_dur if seg_custom else meta["duration"]
                tc_out = float(tc_store.get("out", round(tc_in + playout_dur, 3)))
                assets.append({
                    "asset_id": file.stem,
                    "title": file.name,
                    "category": "videos",
                    "media_type": _library_media_type("videos"),
                    "segments": int(math.ceil(meta["duration"] / _segment_length_seconds(meta["duration"]))) if meta["duration"] > 0 else 0,
                    "cut_segments": seg_store if seg_custom else [],
                    "duration": _smpte_time(meta["duration"], fps),
                    "duration_seconds": round(meta["duration"], 3),
                    "total_duration_seconds": round(meta["duration"], 3),
                    "audio": meta["audio"],
                    "cc": file.stem in subtitles_stems,
                    "probe": meta.get("probe", {}),
                    "segment_length": _segment_length_seconds(meta["duration"]),
                    "subtitle": subtitle_map.get(file.stem, ""),
                    "status": _ts_status(channel_id, file),
                    "tc_in": round(tc_in, 3),
                    "tc_out": round(tc_out, 3),
                    "frame_rate": f"{fps:g}" if fps > 0 else "",
                    "path": abs_path,
                    "play_path": f"/preview/{rel}",
                    "process_path": f"/{rel}",
                })
        return assets

    assets = await asyncio.get_event_loop().run_in_executor(None, _scan_sync)
    return assets


def _get_channel_storage(channel_id: int) -> Path:
    db = load_db()
    for c in db["channels"]:
        if c["id"] == channel_id:
            return Path(c.get("storage", str(DATA_DIR / "storage" / "Channel 1")))
    raise HTTPException(status_code=404, detail="Channel not found")


@app.get("/api/media/storage/{channel_id}")
async def get_media_storage(channel_id: int, request: Request):
    """Report total disk usage and file count for a channel's storage."""
    get_current_user(request)
    storage = _get_channel_storage(channel_id)
    total_bytes = 0
    file_count = 0
    for dirpath, _dirnames, filenames in os.walk(storage):
        for name in filenames:
            try:
                total_bytes += (Path(dirpath) / name).stat().st_size
                file_count += 1
            except OSError:
                pass
    return JSONResponse(content={
        "used_bytes": total_bytes,
        "files": file_count,
    })


# === Asset Availability ===
# Sets which channels can play out an asset. The asset's playable output
# (media/process/<id>.ts) physically lives on disk once: in the *source*
# channel. Every other channel where the asset is "available" gets a hard link
# into its own storage, so library, preview and playout keep working while
# duplicates are deleted to free disk space (NTFS supports in-place links).

AVAILABILITY_FILE = DATA_DIR / "asset_availability.json"


def _load_availability() -> dict:
    try:
        return json.loads(AVAILABILITY_FILE.read_text(encoding="utf-8"))
    except Exception:
        return {}


def _save_availability(data: dict) -> None:
    AVAILABILITY_FILE.write_text(json.dumps(data, indent=2), encoding="utf-8")


def _channel_by_id(channel_id: int) -> dict:
    for c in load_db().get("channels", []):
        if c.get("id") == channel_id:
            return c
    raise HTTPException(status_code=404, detail="Channel not found")


def _availability_ts_rel(asset_id: str) -> str:
    return f"media/process/{Path(asset_id).stem}.ts"


_SUBTITLE_SIDECAR_EXTS = {".srt", ".vtt", ".ass", ".ssa", ".stl", ".scc", ".sub", ".ttml"}


def _sync_asset_sidecars(storage: Path, owner_base: Path, asset_id: str) -> None:
    """Link/copy subtitle sidecars of a shared asset into the receiving
    channel's storage so an "available" asset keeps its closed captions."""
    if not owner_base.is_dir():
        return
    for dirpath, _dirnames, filenames in os.walk(owner_base):
        for name in filenames:
            if Path(name).stem.lower() != asset_id.lower():
                continue
            if Path(name).suffix.lower() not in _SUBTITLE_SIDECAR_EXTS:
                continue
            src = Path(dirpath) / name
            dst = storage / src.relative_to(owner_base)
            if dst.exists():
                try:
                    if os.path.samefile(dst, src):
                        continue
                except OSError:
                    pass
                try:
                    dst.unlink()
                except OSError:
                    pass
            dst.parent.mkdir(parents=True, exist_ok=True)
            try:
                os.link(src, dst)
            except OSError:
                try:
                    shutil.copy2(src, dst)
                except OSError:
                    pass


def _do_link(av: dict, channel_id: int, owner: int, owner_rel: str) -> dict:
    """Core link: delete this channel's duplicate copies of the asset and
    replace them with a hard link at the owner's relative path."""
    storage = _get_channel_storage(channel_id)
    owner_base = _get_channel_storage(owner)
    owner_file = owner_base / owner_rel
    asset_id = Path(owner_rel).stem

    channel_av = av.setdefault(str(channel_id), {})

    # Delete every local copy of this asset_id (source + processed copies).
    deleted = 0
    deleted_bytes = 0
    if storage.is_dir():
        for dirpath, _dirnames, filenames in os.walk(storage):
            for name in filenames:
                if Path(name).stem.lower() != asset_id.lower():
                    continue
                p = Path(dirpath) / name
                try:
                    is_same = os.path.samefile(p, owner_file)
                except OSError:
                    is_same = False
                if is_same:
                    continue
                try:
                    deleted_bytes += p.stat().st_size
                    p.unlink()
                    deleted += 1
                except OSError:
                    pass

    # Place the hard link at the owner's relative path inside this storage.
    target = storage / owner_rel
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists():
        try:
            target.unlink()
        except OSError:
            raise HTTPException(
                status_code=500,
                detail=f"Could not replace existing file at {owner_rel}",
            )
    if not target.exists():
        try:
            os.link(owner_file, target)
        except OSError as exc:
            raise HTTPException(
                status_code=500,
                detail=f"Could not create hard link for {owner_rel}: {exc}",
            )

    channel_av[asset_id] = {"owner": owner, "path": owner_rel}
    _sync_asset_sidecars(storage, owner_base, asset_id)

    return {
        "asset_id": asset_id,
        "owner": owner,
        "path": owner_rel,
        "deleted": deleted,
        "deleted_bytes": deleted_bytes,
    }


def _do_unlink(av: dict, channel_id: int, asset_id: str) -> dict:
    """Core unlink: delete the hard link and forget the mapping."""
    storage = _get_channel_storage(channel_id)
    channel_av = av.get(str(channel_id), {})
    entry = channel_av.get(asset_id)
    removed = False
    if entry:
        try:
            p = storage / entry["path"]
            if p.is_file():
                p.unlink()
                removed = True
        except OSError:
            pass
        # Drop subtitle sidecars that were synced from the owner channel.
        try:
            owner_base = _get_channel_storage(int(entry.get("owner", 0)))
            for dirpath, _dirnames, filenames in os.walk(storage):
                for name in filenames:
                    if Path(name).stem.lower() != asset_id.lower() or \
                            Path(name).suffix.lower() not in _SUBTITLE_SIDECAR_EXTS:
                        continue
                    p = Path(dirpath) / name
                    try:
                        src = owner_base / p.relative_to(storage)
                        if src.is_file() and os.path.samefile(p, src):
                            p.unlink()
                    except OSError:
                        pass
        except HTTPException:
            pass
        del channel_av[asset_id]
        if not channel_av:
            av.pop(str(channel_id), None)
    return {"removed_file": removed}


def _asset_state(asset_id: str, av: dict | None = None) -> dict:
    """Per-channel availability state for one asset across all channels."""
    av = av if av is not None else _load_availability()
    stem = Path(asset_id).stem
    rel = _availability_ts_rel(stem)
    states = []
    owner = None
    for c in load_db().get("channels", []):
        cid = c.get("id")
        try:
            base = _get_channel_storage(cid)
        except HTTPException:
            continue
        entry = (av.get(str(cid), {}) or {}).get(asset_id)
        has = False
        size = 0
        try:
            f = base / rel
            has = f.is_file()
            if has:
                size = f.stat().st_size
        except OSError:
            pass
        if entry and entry.get("owner"):
            if owner is None:
                owner = entry["owner"]
            if entry["owner"] == cid:
                entry = {"owner": cid, "path": rel}
            own = has and entry["owner"] == cid
        else:
            own = has
        states.append({
            "channel_id": cid,
            "channel_name": c.get("name", f"Channel {cid}"),
            "own_source": bool(own),
            "ts_path": rel if has else "",
            "ts_size": size,
            "available": bool(has),
        })
    if owner is None:
        sources = [s["channel_id"] for s in states if s["own_source"]]
        if sources:
            owner = sources[0]
    return {"asset_id": asset_id, "owner": owner, "channels": states}


@app.get("/api/media/availability/channels")
async def availability_channels(request: Request):
    """List all channels with id + name (auth gate only, no channel scope)."""
    get_current_user(request)
    return JSONResponse(content=[
        {"id": c.get("id"), "name": c.get("name", f"Channel {c.get('id')}")}
        for c in load_db().get("channels", [])
    ])


@app.get("/api/media/availability/asset/{asset_id:path}")
async def availability_asset_state(asset_id: str, request: Request):
    """Availability (which channels can play the asset out) for one asset."""
    get_current_user(request)
    return JSONResponse(content=_asset_state(asset_id))


@app.post("/api/media/availability/asset/{asset_id:path}/apply/")
async def availability_asset_apply(asset_id: str, request: Request):
    """Reconcile availability from a checkbox matrix.

    Body: {"owner": <channel_id>, "channels": [{"id": <channel_id>,
    "available": bool}, ...]}. The owner's playable output
    (media/process/<id>.ts) is the single on-disk copy; each channel marked
    available gets a hard link to it, all others are unlinked. Only .ts files
    take part.
    """
    get_current_user(request)
    body = await request.json()
    owner = int(body.get("owner", 0))
    desired = {int(c.get("id", 0)): bool(c.get("available")) for c in body.get("channels", [])}
    stem = Path(asset_id).stem
    rel = _availability_ts_rel(stem)

    try:
        owner_base = _get_channel_storage(owner)
    except HTTPException:
        raise HTTPException(status_code=400, detail="Invalid source channel")
    if not (owner_base / rel).is_file():
        raise HTTPException(status_code=400,
                            detail=f"Source channel has no playable output ({rel}) for this asset")

    av = _load_availability()

    # The owner itself is always available; drop any self-link entry.
    owner_av = av.get(str(owner), {})
    if asset_id in owner_av:
        del owner_av[asset_id]
        if not owner_av:
            av.pop(str(owner), None)

    for c in load_db().get("channels", []):
        cid = c.get("id")
        if cid == owner:
            continue
        want = desired.get(cid, False)
        try:
            base = _get_channel_storage(cid)
            has = (base / rel).is_file()
        except HTTPException:
            continue
        if want:
            try:
                already = has and os.path.samefile(base / rel, owner_base / rel)
            except OSError:
                already = False
            if not already:
                _do_link(av, cid, owner, rel)
            else:
                _sync_asset_sidecars(base, owner_base, stem)
        else:
            _do_unlink(av, cid, asset_id)

    _save_availability(av)
    return JSONResponse(content=_asset_state(asset_id, av))


@app.get("/api/media/availability/{channel_id}")
async def get_media_availability(channel_id: int, request: Request):
    get_current_user(request)
    storage = _get_channel_storage(channel_id)
    av = _load_availability().get(str(channel_id), {})
    channels = {c.get("id"): c.get("name", "?") for c in load_db().get("channels", [])}
    entries = []
    for asset_id, entry in av.items():
        exists = False
        try:
            exists = (storage / entry["path"]).is_file()
        except Exception:
            pass
        entries.append({
            "asset_id": asset_id,
            "owner_channel": entry.get("owner"),
            "owner_name": channels.get(entry.get("owner"), "?"),
            "path": entry.get("path"),
            "linked": exists,
        })
    return JSONResponse(content={
        "entries": entries,
        "storage_relative": str(storage.resolve()),
    })


@app.get("/api/media/availability/{channel_id}/match/{asset_id:path}")
async def availability_match(channel_id: int, asset_id: str, request: Request):
    """Find playable outputs (.ts only) with a matching asset_id in other channels."""
    get_current_user(request)
    channels = load_db().get("channels", [])
    matches = []
    for c in channels:
        cid = c.get("id")
        if cid == channel_id:
            continue
        try:
            base = _get_channel_storage(cid)
        except HTTPException:
            continue
        if not base.is_dir():
            continue
        for dirpath, _dirnames, filenames in os.walk(base):
            for name in filenames:
                if not name.lower().endswith(".ts"):
                    continue
                if Path(name).stem.lower() != Path(asset_id).stem.lower():
                    continue
                p = Path(dirpath) / name
                try:
                    size = p.stat().st_size
                except OSError:
                    size = 0
                matches.append({
                    "channel_id": cid,
                    "channel_name": c.get("name", f"Channel {cid}"),
                    "path": p.resolve().relative_to(base.resolve()).as_posix(),
                    "size": size,
                })
    return JSONResponse(content={"channels": matches})


@app.post("/api/media/availability/{channel_id}/link/")
async def availability_link(channel_id: int, request: Request):
    """Link an identical asset into this channel from an owner channel.

    Body: {"asset_id": "...", "owner": <channel_id>, "path": "relative/path"}
    Only .ts (playable output) files are accepted as link sources.
    """
    get_current_user(request)
    body = await request.json()
    asset_id = str(body.get("asset_id", "")).strip()
    owner = int(body.get("owner", 0))
    owner_rel = str(body.get("path", "")).strip().lstrip("/\\")
    if not asset_id or not owner or owner == channel_id:
        raise HTTPException(status_code=400, detail="Invalid link request")
    if not owner_rel:
        raise HTTPException(status_code=400, detail="Owner file path required")
    if not owner_rel.lower().endswith(".ts"):
        raise HTTPException(status_code=400, detail="Only playable output (.ts) files can be shared")

    try:
        owner_file = _get_channel_storage(owner) / owner_rel
    except HTTPException:
        raise HTTPException(status_code=400, detail="Invalid owner channel")
    if not owner_file.is_file():
        raise HTTPException(status_code=404, detail="Owner file not found")

    av = _load_availability()
    result = _do_link(av, channel_id, owner, owner_rel)
    _save_availability(av)
    return JSONResponse(content={"linked": True, **result})


@app.post("/api/media/availability/{channel_id}/unlink/{asset_id:path}")
async def availability_unlink(channel_id: int, asset_id: str, request: Request):
    """Remove the availability link: delete the hard link and forget the map."""
    get_current_user(request)
    av = _load_availability()
    if asset_id not in (av.get(str(channel_id), {}) or {}):
        raise HTTPException(status_code=404, detail="No availability link for asset")
    result = _do_unlink(av, channel_id, asset_id)
    _save_availability(av)
    return JSONResponse(content={"unlinked": True, "asset_id": asset_id, **result})


# === Per-asset timecode (TC IN / TC OUT) overrides ===
# TC IN maps to SOM (IN) in the playlist table and TC OUT maps to EOM (OUT).
# Values are stored per (channel, asset) in seconds; the video library carries
# them and the playlist uses them when a media item is added.

MEDIA_TC_FILE = DATA_DIR / "media_tc.json"


def _load_media_tc() -> dict:
    try:
        return json.loads(MEDIA_TC_FILE.read_text(encoding="utf-8"))
    except Exception:
        return {}


def _save_media_tc(data: dict) -> None:
    MEDIA_TC_FILE.write_text(json.dumps(data, indent=2), encoding="utf-8")


def _media_tc_for(channel_id: int, asset_id: str) -> dict:
    return (_load_media_tc().get(str(channel_id), {}) or {}).get(asset_id, {}) or {}


@app.get("/api/media/tc/{channel_id}/{asset_id:path}")
async def get_media_tc(channel_id: int, asset_id: str, request: Request):
    get_current_user(request)
    return JSONResponse(content=_media_tc_for(channel_id, Path(asset_id).stem))


@app.post("/api/media/tc/{channel_id}/{asset_id:path}/")
async def save_media_tc(channel_id: int, asset_id: str, request: Request):
    get_current_user(request)
    body = await request.json()
    asset = Path(asset_id).stem
    data = _load_media_tc()
    ch = data.setdefault(str(channel_id), {})
    entry = dict(ch.get(asset, {}))
    for key in ("in", "out"):
        if body.get(key) is not None:
            try:
                entry[key] = round(float(body[key]), 3)
            except (TypeError, ValueError):
                pass
    ch[asset] = entry
    _save_media_tc(data)
    return JSONResponse(content=entry)


# === Per-asset segment cuts ===
# Each (channel, asset) keeps the ordered list of playable segments (seconds).
# When absent the library falls back to the default time grid; when present the
# library duration, segments count and default TC OUT reflect only the kept
# segments.

ASSET_SEGMENTS_FILE = DATA_DIR / "asset_segments.json"


def _load_asset_segments() -> dict:
    try:
        return json.loads(ASSET_SEGMENTS_FILE.read_text(encoding="utf-8"))
    except Exception:
        return {}


def _save_asset_segments(data: dict) -> None:
    ASSET_SEGMENTS_FILE.write_text(json.dumps(data, indent=2), encoding="utf-8")


def _asset_segments_state(channel_id: int, asset_id: str) -> tuple:
    ch = (_load_asset_segments().get(str(channel_id), {}) or {})
    if asset_id in ch:
        return True, ch[asset_id] or []
    return False, []


def _asset_segments_for(channel_id: int, asset_id: str) -> list:
    return _asset_segments_state(channel_id, asset_id)[1]


def _kept_duration_seconds(segments: list) -> float:
    return round(sum(float(s.get("end", 0) or 0) - float(s.get("start", 0) or 0)
                     for s in segments if float(s.get("end", 0) or 0) > float(s.get("start", 0) or 0)), 3)


@app.get("/api/media/segments/{channel_id}/{asset_id:path}")
async def get_media_segments(channel_id: int, asset_id: str, request: Request):
    get_current_user(request)
    asset = Path(asset_id).stem
    custom, segments = _asset_segments_state(channel_id, asset)
    return JSONResponse(content={
        "channel_id": channel_id,
        "asset_id": asset,
        "segments": segments,
        "duration": _kept_duration_seconds(segments),
        "custom": custom,
    })


@app.post("/api/media/segments/{channel_id}/{asset_id:path}/")
async def save_media_segments(channel_id: int, asset_id: str, request: Request):
    get_current_user(request)
    body = await request.json()
    asset = Path(asset_id).stem
    raw = body.get("segments", []) or []
    segments = []
    for s in raw:
        try:
            start = round(float(s.get("start", 0) or 0), 3)
            end = round(float(s.get("end", 0) or 0), 3)
        except (TypeError, ValueError):
            continue
        if start >= 0 and end > start:
            segments.append({"start": start, "end": end})
    segments.sort(key=lambda s: s["start"])
    data = _load_asset_segments()
    ch = data.setdefault(str(channel_id), {})
    ch[asset] = segments
    _save_asset_segments(data)
    return JSONResponse(content={
        "channel_id": channel_id,
        "asset_id": asset,
        "segments": segments,
        "duration": _kept_duration_seconds(segments),
        "custom": True,
    })


@app.delete("/api/media/segments/{channel_id}/{asset_id}")
async def delete_media_segments(channel_id: int, asset_id: str, request: Request):
    get_current_user(request)
    asset = Path(asset_id).stem
    data = _load_asset_segments()
    ch = data.get(str(channel_id), {})
    if ch and asset in ch:
        ch.pop(asset, None)
    if not ch:
        data.pop(str(channel_id), None)
    _save_asset_segments(data)
    return JSONResponse(content={
        "channel_id": channel_id,
        "asset_id": asset,
        "segments": [],
        "duration": 0,
        "custom": False,
    })


@app.post("/api/file/{channel_id}/rename/")
async def rename_file(channel_id: int, request: Request):
    user = get_current_user(request)
    body = await request.json()
    base = _get_channel_storage(channel_id)
    src = body.get("src", "")
    dst = body.get("dst", "")
    src_path = Path(src) if os.path.isabs(src) else base / src.lstrip("/")
    dst_path = Path(dst) if os.path.isabs(dst) else base / dst.lstrip("/")
    if src_path.exists():
        src_path.rename(dst_path)
    return JSONResponse(status_code=200, content={"detail": "renamed"})


@app.post("/api/file/{channel_id}/remove/")
async def remove_file(channel_id: int, request: Request):
    user = get_current_user(request)
    body = await request.json()
    base = _get_channel_storage(channel_id)
    paths = body if isinstance(body, list) else [body.get("src", "")]
    for item in paths:
        name = item if isinstance(item, str) else item.get("src", "")
        target = Path(name) if os.path.isabs(name) else base / name.lstrip("/")
        if target.is_file():
            target.unlink()
        elif target.is_dir():
            import shutil
            shutil.rmtree(target)
    return JSONResponse(status_code=200, content={"detail": "removed"})


@app.post("/api/file/{channel_id}/create-folder/")
async def create_folder(channel_id: int, request: Request):
    user = get_current_user(request)
    body = await request.json()
    base = _get_channel_storage(channel_id)
    folder = body.get("src", "") or body.get("folder", "")
    target = base / folder.lstrip("/")
    target.mkdir(parents=True, exist_ok=True)
    return JSONResponse(status_code=200, content={"detail": "created"})


@app.put("/api/file/{channel_id}/upload/")
async def upload_file(channel_id: int, request: Request):
    user = get_current_user(request)
    db = load_db()
    channel = None
    for c in db["channels"]:
        if c["id"] == channel_id:
            channel = c
            break
    if not channel:
        raise HTTPException(status_code=404, detail="Channel not found")

    base = Path(channel.get("storage", str(DATA_DIR / "storage" / "Channel 1")))
    upload_path = request.query_params.get("path", "").strip("/")
    target_dir = base / upload_path if upload_path else base
    target_dir.mkdir(parents=True, exist_ok=True)

    form = await request.form()
    uploaded = []
    skipped = []

    pcfg = _get_playout_config(channel_id)
    storage_cfg = pcfg.get("storage", {})
    ext_list = storage_cfg.get("extensions", [])
    if isinstance(ext_list, str):
        ext_list = [e.strip().lower() for e in ext_list.split(",") if e.strip()]
    else:
        ext_list = [e.lower() for e in ext_list]
    allowed_exts = set(f".{e}" for e in ext_list) if ext_list else VIDEO_EXTENSIONS

    for key in form:
        item = form[key]
        if hasattr(item, "read"):
            ext = Path(item.filename).suffix.lower()
            if ext not in allowed_exts and ext not in GRAPHIC_ARCHIVE_EXTS:
                skipped.append(item.filename)
                continue
            content = await item.read()
            dest = target_dir / item.filename
            with open(dest, "wb") as f:
                f.write(content)
            uploaded.append(item.filename)

    return {"detail": "uploaded", "files": uploaded, "skipped": skipped}


@app.put("/api/file/{channel_id}/import/")
async def import_file(channel_id: int, request: Request):
    user = get_current_user(request)
    date = request.query_params.get("date", datetime.now().strftime("%Y-%m-%d"))
    filename = request.query_params.get("file", "")
    raw = await request.body()
    if not raw.strip():
        raise HTTPException(status_code=400, detail="empty import payload")

    # archive the verbatim upload (as-run logs are broadcast evidence of
    # what actually aired and must be kept per date, untouched)
    archive_note = ""
    try:
        safe_name = re.sub(r"[^A-Za-z0-9._-]", "_", os.path.basename(filename)) or "import"
        stamp = datetime.now().strftime("%H%M%S")
        arch_dir = DATA_DIR / "playlists" / "imports" / str(channel_id) / date
        arch_dir.mkdir(parents=True, exist_ok=True)
        arch_path = arch_dir / f"{stamp}_{safe_name}"
        arch_path.write_bytes(raw)
        archive_note = str(arch_path)
    except OSError:
        pass

    pcfg = _get_playout_config(channel_id)
    fps = float((pcfg.get("processing") or {}).get("fps") or 25.0)

    ext = Path(filename).suffix.lower() if filename else ""
    program: list = []
    fmt = ext.lstrip(".") or "text"

    if ext == ".xlsx":
        program = _parse_xlsx_playlist(raw, channel_id, fps)
    elif ext == ".xls":
        raise HTTPException(status_code=400,
                            detail="legacy .xls not supported - save as .xlsx or .csv")
    elif ext == ".json":
        try:
            program = _parse_json_playlist(raw, channel_id, fps)
        except json.JSONDecodeError as e:
            raise HTTPException(status_code=400, detail=f"invalid JSON: {e}")
    elif ext in (".m3u", ".m3u8"):
        program = _parse_m3u_playlist(raw, channel_id, fps)
    elif ext in (".csv", ".txt", ".asrun") or not ext:
        text = raw.decode("utf-8-sig", errors="replace")
        first_cells = text.lstrip().splitlines()[0].split("\t") if text.strip() else []
        is_asrun = (
            len(first_cells) >= 8
            and re.match(r"^\d{1,2}:\d{2}:\d{2}[:.,;]\d{2}$", (first_cells[0] or "").strip())
        )
        if is_asrun:
            fmt = "as-run"
            program = _parse_as_run(text, channel_id, fps)
        elif ext != ".txt":
            program = _parse_csv_playlist(text, channel_id, fps)
        else:
            raise HTTPException(
                status_code=400,
                detail="unrecognized .txt content: expected a tab separated as-run log",
            )
    else:
        raise HTTPException(status_code=400, detail=f"unsupported import format '{ext}'")

    if not program:
        raise HTTPException(status_code=400, detail=f"no events recognized ({fmt} import)")

    se_count = sum(len(i.get("secondary_events") or []) for i in program)
    pl_file = DATA_DIR / "playlists" / f"{channel_id}_{date}.json"
    with open(pl_file, "w", encoding="utf-8") as f:
        json.dump({"channel": str(channel_id), "date": date, "program": program}, f,
                  ensure_ascii=False, indent=2)
    detail = (
        f"Imported {len(program)} items, {se_count} graphics events "
        f"({fmt}) from {filename or 'payload'}"
    )
    if archive_note:
        detail += f" - archived to {archive_note}"
    return JSONResponse(status_code=200, content={"detail": detail})


# === LOGGING ===

_FFLOG_TO_SEVERITY = {
    "debug": "DEBUG",
    "info": "INFO",
    "notice": "INFO",
    "verbose": "INFO",
    "warning": "WARN",
    "error": "ERROR",
    "fatal": "ERROR",
    "panic": "ERROR",
}

_LEVEL_ORDER = {"DEBUG": 0, "INFO": 1, "WARN": 2, "ERROR": 3}


def _normalize_ffmpeg_log_line(line: str) -> str:
    """Rewrite a raw ffmpeg log line to the uppercase severity markers the
    frontend logger expects (`[INFO]`, `[WARN]`, `[ERROR]`, `[DEBUG]`).

    ffmpeg emits tags like `[info]`, `[warning]`, `[error]`, `[fatal]` or
    none at all; map them onto the severity vocabulary and normalize any
    existing uppercase marker so the filter below can rank the line.
    """
    m = re.search(r"\[([a-z_]+)\]", line)
    if m:
        sev = _FFLOG_TO_SEVERITY.get(m.group(1).lower())
        if sev:
            start, end = m.span(1)
            line = line[:start] + sev.upper() + line[end:]
    # bare lines (no marker) are kept verbatim - they pass the severity filter
    return line


def _render_channel_log(channel_id: int, date: str = "", for_download: bool = False) -> str:
    """Assemble the combined logger output for a channel from the per-output
    ffmpeg log files written under DATA_DIR/channel/<id>/logs.

    The configured ffmpeg log level and `ignore_lines` from the playout
    logging section are applied; an explicit `date` filters to that day's
    dated log files (or is ignored for the live files).
    """
    pcfg = _get_playout_config(channel_id) or {}
    logging_cfg = (pcfg.get("logging") or {}) or {}
    min_level = _LEVEL_ORDER.get(
        str(logging_cfg.get("ffmpeg_level", "INFO")).upper(), 1
    )
    ignore_lines = logging_cfg.get("ignore_lines") or []

    log_dir = DATA_DIR / "channel" / str(channel_id) / "logs"
    live_files = sorted(log_dir.glob("ffmpeg_*.log")) if log_dir.is_dir() else []

    dated_files = []
    if date:
        dated_files = sorted(log_dir.glob(f"ffmpeg_*_{date}.log")) if log_dir.is_dir() else []

    files = dated_files if date else live_files

    out = []
    if not files:
        out.append(f"[INFO] [{date or 'today'}] no ffmpeg logs for channel {channel_id}")
    for f in files:
        try:
            raw = f.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        out.append(f"[INFO] === {f.name} ===")
        for ln in raw.splitlines():
            ln = _normalize_ffmpeg_log_line(ln.rstrip())
            if not ln.strip():
                continue
            if any(ig and ig in ln for ig in ignore_lines):
                continue
            if not for_download:
                m = re.search(r"\[(DEBUG|INFO|WARN|ERROR)\]", ln)
                if m and _LEVEL_ORDER.get(m.group(1), 0) < min_level:
                    continue
            out.append(ln)

    if not out:
        out.append(f"[INFO] [{date or 'today'}] ffplayout log for channel {channel_id}")
    return "\n".join(out) + "\n"


@app.get("/api/log/{channel_id}")
async def get_log(channel_id: int, request: Request):
    get_current_user(request)
    date = request.query_params.get("date", "")
    tz = request.query_params.get("timezone", "UTC")
    for_download = request.query_params.get("download", "").lower() == "true"
    log_content = _render_channel_log(channel_id, date=date, for_download=for_download)
    headers = {"Cache-Control": "no-store"}
    if for_download:
        fname = f"ffplayout_{channel_id}.log" if not date else f"ffplayout_{channel_id}_{date}.log"
        headers["Content-Disposition"] = f'attachment; filename="{fname}"'
    return PlainTextResponse(log_content, headers=headers)


# === SSE ===

@app.get("/data/event/{channel_id}")
async def sse_event(channel_id: int, request: Request):
    from starlette.responses import StreamingResponse

    endpoint = request.query_params.get("endpoint", "playout")

    async def event_stream():
        if endpoint == "system":
            prev_net = psutil.net_io_counters()
            prev_time = time.time()
            while True:
                now = time.time()
                dt = now - prev_time if now - prev_time > 0 else 1.0

                cpu_percent = psutil.cpu_percent(interval=None)
                cpu_count = psutil.cpu_count() or 1
                mem = psutil.virtual_memory()
                swap = psutil.swap_memory()

                try:
                    load1, load5, load15 = psutil.getloadavg()
                except (AttributeError, OSError):
                    load1 = load5 = load15 = cpu_percent / 100.0 * cpu_count

                disk_path = str(Path.home().drive) if os.name == "nt" else "/"
                disk = shutil.disk_usage(disk_path)

                disk_name = disk_path
                try:
                    partitions = psutil.disk_partitions()
                    for p in partitions:
                        if p.mountpoint == disk_path or p.mountpoint == "/":
                            disk_name = p.device
                            break
                except Exception:
                    pass

                net = psutil.net_io_counters()
                net_name = ""
                for name in psutil.net_if_stats():
                    if name != "lo" and "Loopback" not in name:
                        net_name = name
                        break

                ffp_version = os.environ.get("FFPLAYOUT_VERSION", "0.25.0")

                data = json.dumps({
                    "cpu": {"cores": cpu_count, "usage": round(min(cpu_percent, 100.0), 2)},
                    "load": {"one": round(load1, 2), "five": round(load5, 2), "fifteen": round(load15, 2)},
                    "memory": {"total": mem.total, "used": mem.used, "free": mem.available},
                    "network": {
                        "name": net_name,
                        "current_in": net.bytes_recv - prev_net.bytes_recv,
                        "total_in": net.bytes_recv,
                        "current_out": net.bytes_sent - prev_net.bytes_sent,
                        "total_out": net.bytes_sent,
                    },
                    "storage": {"path": disk_name, "total": disk.total, "used": disk.used},
                    "swap": {"total": swap.total, "used": swap.used, "free": swap.free},
                    "system": {
                        "name": platform.node(),
                        "kernel": platform.platform(),
                        "version": platform.version(),
                        "ffp_version": ffp_version,
                    },
                })
                prev_net = net
                prev_time = now
                yield f"data: {data}\n\n"
                await asyncio.sleep(1)
        else:
            while True:
                state = playout_states.get(channel_id, {})
                program = state.get("program", [])
                idx = state.get("index", 0)
                elapsed = state.get("elapsed", 0)
                running = state.get("running", False)

                if program and idx < len(program):
                    item = program[idx]
                    media = {
                        "uid": item.get("uid", str(uuid.uuid4())),
                        "begin": item.get("begin", 0),
                        "title": item.get("title", ""),
                        "source": item.get("source", ""),
                        "duration": item.get("duration", 0),
                        "in": item.get("in", 0),
                        "out": item.get("out", 0),
                    }
                else:
                    media = {
                        "uid": str(uuid.uuid4()),
                        "begin": 0,
                        "title": "",
                        "source": "",
                        "duration": 0,
                        "in": 0,
                        "out": 0,
                    }

                data = json.dumps({
                    "media": media,
                    "index": idx,
                    "ingest": bool(state.get("ingest_active", False)),
                    "mode": "playlist",
                    "elapsed": elapsed,
                    "shift": state.get("shift", 0),
                    "running": running,
                })
                yield f"data: {data}\n\n"
                await asyncio.sleep(1)

    return StreamingResponse(event_stream(), media_type="text/event-stream")


# === STATIC FILE SERVING ===

@app.get("/{channel_id}/live/{filename:path}")
async def serve_live_stream(channel_id: int, filename: str):
    live_dir = DATA_DIR / "channel" / str(channel_id) / "live"
    target = live_dir / filename
    if not target.is_file():
        raise HTTPException(status_code=404, detail="Stream file not found")
    media_types = {
        ".m3u8": "application/vnd.apple.mpegurl",
        ".ts": "video/mp2t",
        ".mp4": "video/mp4",
    }
    ext = target.suffix.lower()
    media_type = media_types.get(ext, "application/octet-stream")
    # every HLS media playlist (variant_*.m3u8 and the legacy stream.m3u8)
    # needs ENDLIST scrubbing + SCTE-35 ad-break tag injection; the master
    # playlist is served verbatim.
    is_media_playlist = (
        ext == ".m3u8"
        and (filename.endswith("stream.m3u8") or filename.startswith("variant_"))
    )
    if is_media_playlist:
        # media playlist: inject SCTE-35 ad-break tags while a cue is active;
        # ffmpeg rewrites the playlist at every clip boundary and on Windows a
        # concurrent read can hit a transient PermissionError - retry briefly
        # instead of returning a 500 that makes players drop the stream
        text = None
        for _ in range(10):
            try:
                text = target.read_text(encoding="utf-8", errors="replace")
                break
            except (PermissionError, OSError):
                time.sleep(0.05)
        if text is None:
            raise HTTPException(status_code=503, detail="Playlist busy, retry shortly")
        # never hand players an ENDLIST: while the muxer is between clips
        # the tag means 'stream finished' and every player stops polling
        if "#EXT-X-ENDLIST" in text:
            text = "\n".join(
                ln for ln in text.splitlines() if ln.strip() != "#EXT-X-ENDLIST"
            )
        # stale-segment resilience: scrub any #EXTINF + segment line that
        # points at a file no longer on disk. A fresh playlist rarely lists a
        # missing file, but a player polling a cached playlist across a ffmpeg
        # restart (new timestamp group) could otherwise keep 404ing against
        # segments that were already swept/rotated out.
        lines = text.splitlines()
        scrubbed = [
            (
                (l.strip() and not l.strip().startswith("#") and l.strip().startswith("variant_"))
                and not (live_dir / l.strip().rsplit("/", 1)[-1]).is_file()
            )
            for l in lines
        ]
        if any(scrubbed):
            kept = []
            for ln, was_removed in zip(lines, scrubbed):
                if was_removed:
                    if kept and kept[-1].lstrip().startswith("#EXTINF"):
                        kept.pop()
                    continue
                kept.append(ln)
            text = "\n".join(kept)
        # inject SCTE-35 ad-break tags while a cue is active
        text = _inject_hls_scte35(channel_id, text)
        return PlainTextResponse(text, media_type=media_type, headers={
            "Cache-Control": "no-cache, no-store, must-revalidate",
            "Pragma": "no-cache",
        })
    resp = FileResponse(str(target), media_type=media_type)
    if ext == ".m3u8":
        resp.headers["Cache-Control"] = "no-cache, no-store, must-revalidate"
        resp.headers["Pragma"] = "no-cache"
    return resp


def _srt_to_vtt(srt: str) -> str:
    """Convert SubRip (SRT) text to WebVTT for native <track> rendering.

    Browsers only render WebVTT on a ``<track kind="subtitles">`` element, so
    the most common sidecar .srt is converted on the fly: add the WEBVTT
    header and switch SRT ``HH:MM:SS,mmm`` timestamps to ``HH:MM:SS.mmm``.
    """
    text = srt.replace("\r\n", "\n").replace("\r", "\n")
    out = ["WEBVTT", ""]
    for line in text.split("\n"):
        if "-->" in line:
            out.append(line.replace(",", "."))
        else:
            out.append(line)
    return "\n".join(out).rstrip("\n") + "\n"


@app.get("/subtitle/{channel_id}/{file_path:path}")
async def serve_subtitle_webvtt(channel_id: str, file_path: str):
    """Serve a sidecar subtitle as WebVTT for the preview player.

    Native ``<track>`` elements only render WebVTT, so .srt is converted on
    the fly while .vtt (and any file that is already WebVTT) passes through.
    """
    try:
        cid = int(channel_id)
        base = _get_channel_storage(cid)
    except (ValueError, HTTPException):
        raise HTTPException(status_code=404, detail="Channel not found")

    fp = file_path.replace("\\", "/")
    target = base / fp.lstrip("/")
    if not target.is_file():
        raise HTTPException(status_code=404, detail="Subtitle not found")

    ext = target.suffix.lower()
    if ext == ".srt":
        text = target.read_text(encoding="utf-8", errors="replace")
        return PlainTextResponse(
            _srt_to_vtt(text), media_type="text/vtt",
            headers={"Cache-Control": "no-cache", "Access-Control-Allow-Origin": "*"},
        )
    if ext == ".vtt" or target.read_bytes()[:6] == b"WEBVTT":
        return FileResponse(str(target), media_type="text/vtt", headers={
            "Access-Control-Allow-Origin": "*",
        })
    raise HTTPException(
        status_code=415,
        detail="Subtitle format not supported for browser preview (use .srt/.vtt)",
    )


@app.get("/file/{channel_id}/{file_path:path}")
async def serve_file(channel_id: str, file_path: str, request: Request):
    # `preview/` is a sub-route served by `preview_file` (remuxed,
    # browser-playable). The catch-all below would otherwise swallow it.
    fp_head = file_path.replace("\\", "/")
    if fp_head.lower().startswith("preview/"):
        return await preview_file(channel_id, fp_head[len("preview/"):], request)

    try:
        cid = int(channel_id)
        base = _get_channel_storage(cid)
        fp = fp_head
        bp = str(base).replace("\\", "/").rstrip("/")

        if fp.lower().startswith(bp.lower()):
            relative = fp[len(bp):].lstrip("/")
            target = base / relative
        else:
            target = base / fp.lstrip("/")
    except ValueError:
        full = (channel_id + "/" + file_path).replace("\\", "/")
        m = re.search(r"[a-zA-Z]:/", full)
        if m:
            target = Path(full[m.start():])
        else:
            target = Path(full)

    if not target.is_file():
        raise HTTPException(status_code=404, detail="File not found")
    media_types = {
        ".ts": "video/mp2t",
        ".mp4": "video/mp4",
        ".m4v": "video/mp4",
        ".webm": "video/webm",
        ".mpg": "video/mpeg",
        ".mpeg": "video/mpeg",
        ".mkv": "video/x-matroska",
        ".jpg": "image/jpeg",
        ".jpeg": "image/jpeg",
        ".png": "image/png",
        ".gif": "image/gif",
        ".webp": "image/webp",
        ".srt": "application/x-subrip",
        ".vtt": "text/vtt",
        ".ass": "text/x-ass",
    }
    ext = target.suffix.lower()
    media_type = media_types.get(ext, "application/octet-stream")
    # Raw MPEG-TS cannot be played in a browser <video> tag - it is only
    # used for export/download. Everything else is served inline so the
    # web player can show it directly.
    disposition = "attachment" if ext == ".ts" else "inline"
    return FileResponse(
        str(target), media_type=media_type, content_disposition_type=disposition
    )


@app.get("/file/{channel_id}/preview/{file_path:path}")
async def preview_file(channel_id: str, file_path: str, request: Request):
    """Serve a browser-playable preview of a media file.

    All video containers (MPEG-TS / MPEG-PS / MXF / MOV / MKV / ...) are
    remuxed on the fly to a fragmented MP4 with `-c copy` (fast, no re-encode:
    H.264 passes through untouched, audio is re-encoded to AAC). Browsers
    cannot demux MPEG-TS, so this is the only way to preview .ts assets.
    Images, audio and subtitle files are served as-is.
    """
    try:
        cid = int(channel_id)
        base = _get_channel_storage(cid)
    except (ValueError, HTTPException):
        raise HTTPException(status_code=404, detail="Channel not found")

    fp = file_path.replace("\\", "/")
    bp = str(base).replace("\\", "/").rstrip("/")
    if fp.lower().startswith(bp.lower()):
        relative = fp[len(bp):].lstrip("/")
        target = base / relative
    else:
        target = base / fp.lstrip("/")
    if not target.is_file():
        raise HTTPException(status_code=404, detail="File not found")

    media_types = {
        ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".png": "image/png",
        ".gif": "image/gif", ".webp": "image/webp",
        ".srt": "application/x-subrip", ".vtt": "text/vtt", ".ass": "text/x-ass",
        ".mp3": "audio/mpeg", ".wav": "audio/wav", ".aac": "audio/aac",
        ".ogg": "audio/ogg", ".flac": "audio/flac",
    }
    ext = target.suffix.lower()
    video_exts = {".mp4", ".m4v", ".mpg", ".mpeg", ".mov", ".mxf",
                  ".mkv", ".avi", ".flv", ".wmv", ".webm", ".ts"}
    if ext not in video_exts:
        media_type = media_types.get(ext, "application/octet-stream")
        return FileResponse(str(target), media_type=media_type)

    def _gen():
        cmd = [
            FFMPEG_BIN, "-hide_banner", "-v", "error",
            "-i", str(target),
            "-map", "0:v:0?", "-map", "0:a:0?",
            # Copy the video stream (already H.264) but re-encode audio: TS
            # stores AAC as ADTS, which MP4 does not accept - remuxing fails
            # otherwise.
            "-c:v", "copy",
            "-c:a", "aac",
            "-sn",
            "-f", "mp4",
            "-movflags", "frag_keyframe+empty_moov+default_base_moof",
            "pipe:1",
        ]
        proc = None
        try:
            proc = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
            )
            while True:
                chunk = proc.stdout.read(65536)
                if not chunk:
                    break
                yield chunk
        finally:
            if proc is not None:
                if proc.stdout:
                    proc.stdout.close()
                try:
                    proc.kill()
                except Exception:
                    pass
                proc.wait()

    return StreamingResponse(_gen(), media_type="video/mp4", headers={
        "Cache-Control": "no-cache",
    })


# === STATIC FRONTEND ===
# Mounted LAST so every /api, /auth, /hls, ... route above keeps priority.
# On a production (Ubuntu) install `npm run build` writes frontend/dist and this
# serves the whole UI from the same origin - no vite dev server, no CORS.
_FRONTEND_DIST = Path(__file__).resolve().parent / "frontend" / "dist"

if _FRONTEND_DIST.is_dir():
    from fastapi.staticfiles import StaticFiles
    from starlette.exceptions import HTTPException as StarletteHTTPException

    class SPAStaticFiles(StaticFiles):
        """StaticFiles with a history-mode fallback for the Vue SPA.

        frontend/src/router/index.ts uses createWebHistory, so a deep link
        like /configure is a real URL but not a real file. Plain StaticFiles
        answers those with 404, which breaks every page refresh and every
        pasted link. When the requested file is missing and the client asked
        for HTML (a browser navigation, not a fetch), serve index.html and let
        vue-router resolve the route.

        The Accept check is what keeps this safe: fetch() and XHR send `*/*`,
        so a missing asset or a bogus /api path still gets a real 404 instead
        of silently receiving HTML.
        """

        async def get_response(self, path, scope):
            try:
                return await super().get_response(path, scope)
            except StarletteHTTPException as exc:
                if exc.status_code != 404:
                    raise
                # scope["headers"] is a list of (name, value) byte pairs, not a
                # mapping - read it via Request so this works on any Starlette.
                accept = Request(scope).headers.get("accept", "")
                if "text/html" not in accept:
                    raise
                if path in ("", "index.html"):
                    raise
                return await super().get_response("index.html", scope)

    try:
        app.mount(
            "/",
            SPAStaticFiles(directory=str(_FRONTEND_DIST), html=True),
            name="frontend",
        )
    except Exception as _e:  # pragma: no cover
        print(f"[web] frontend not mounted from {_FRONTEND_DIST}: {_e}")
else:
    print(f"[web] no frontend build at {_FRONTEND_DIST} - API only")


if __name__ == "__main__":
    import uvicorn

    # FFPU_HOST / FFPU_PORT let systemd + nginx decide where we listen.
    # Default stays 127.0.0.1 so a plain `python3 server.py` is not exposed.
    _host = os.environ.get("FFPU_HOST", "127.0.0.1")
    _port = int(os.environ.get("FFPU_PORT", "8787"))
    uvicorn.run(
        app,
        host=_host,
        port=_port,
        log_level=os.environ.get("FFPU_LOG_LEVEL", "info"),
        # single worker: the playout loop, ffmpeg handles and in-memory state
        # live in this process, so >1 worker would double-spawn every encoder.
        workers=1,
    )
