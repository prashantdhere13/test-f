@app.post("/api/playout/advanced/{channel_id}/")
async def create_advanced_config(channel_id: int, request: Request):
    user = get_current_user(request)
    body = await request.json()
    db = load_db()
    key = str(channel_id)
    new_id = max((c.get("id", 0) for c in db.get("advanced_configs", {}).get(key, []) if isinstance(c, dict)), default=0) + 1
    body["id"] = new_id
