    user = get_current_user(request)
    db = load_db()
    key = str(channel_id)
    cfgs = db.get("advanced_configs", {}).get(key, [])
    if isinstance(cfgs, list):
        db["advanced_configs"][key] = [c for c in cfgs if c.get("id") != config_id]
    save_db(db)
    return JSONResponse(status_code=200, content={"detail": "deleted"})


